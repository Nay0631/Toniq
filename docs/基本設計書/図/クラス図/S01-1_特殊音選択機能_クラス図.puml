@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "もっと調整" as B2 <<boundary>> {
  {method} <U+002B> 追加パートを使うボタンを押下する() : void
  {method} <U+002B> アレンジャーで → を押下する() : void
  {method} <U+002B> サブベースを選ぶ() : void
  {method} <U+002B> ON のパートの名前と変更の数を表示する() : void
}
class "カスタムモード画面" as B1 <<boundary>> {
  {method} <U+002B> FX / SE の種類を選ぶ() : void
  {method} <U+002B> FX / SE の試聴ボタンを押下する() : void
}
class "アレンジ画面" as B3 <<boundary>> {
  {method} <U+002B> アレンジャーを表示する() : void
}
class "追加パート設定" as C5 <<control>> {
  {method} <U+002B> 追加パートをまとめて ON/OFF する() : void
  {method} <U+002B> サブベースを設定する() : void
}
class "画面切り替え" as C6 <<control>> {
  {method} <U+002B> アレンジャータブを開く() : void
}
class "パート管理" as C1 <<control>> {
  {method} <U+002B> パートを ON/OFF する() : void
}
class "各パートの演奏" as C2 <<control>> {
  {method} <U+002B> 音源を読み込む() : void
  {method} <U+002B> 音源を破棄する() : void
}
class "FX設定" as C3 <<control>> {
  {method} <U+002B> FX / SE の種類を設定する() : void
}
class "再生" as C4 <<control>> {
  {method} <U+002B> 再生し直す() : void
  {method} <U+002B> FX / SE を試聴する() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> パートの ON/OFF
  {field} <U+002B> サブベース
  {field} <U+002B> FX / SE の種類
  {method} <U+002B> パートの ON/OFF を更新する() : void
  {method} <U+002B> サブベースを更新する() : void
  {method} <U+002B> FX / SE の種類を更新する() : void
}
class "ベース設定マスタ" as E2 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> サブベースの標準
  {method} <U+002B> ジャンルのサブベースの標準を取得する() : void
}

B2 --> C5
B2 --> C6
C6 --> B3
C5 --> C1
C1 --> E1
C1 --> C2
C5 --> E1
C5 --> E2
C5 --> C4
C5 --> B2
B1 --> C3
C3 --> E1
C3 --> C4
B1 --> C4

@enduml
