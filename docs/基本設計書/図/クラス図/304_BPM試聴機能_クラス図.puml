@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "SimpleScreen" as B1 <<boundary>> {
  {method} <U+002B> initSimpleScreen()
}
class "CustomScreen" as B2 <<boundary>> {
  {method} <U+002B> initCustomScreen()
}
class "Metronome" as C1 <<control>> {
  {field} <U+002D> ctx : AudioContext
  {field} <U+002D> timer : number
  {field} <U+002D> nextBeatTime : number
  {method} <U+002B> isMetronomeOn() : boolean
  {method} <U+002B> toggleMetronome()
  {method} <U+002B> startMetronome()
  {method} <U+002B> stopMetronome()
  {method} <U+002B> onMetronomeChange(fn)
  {method} <U+002D> schedule()
}
class "Playback" as C2 <<control>> {
  {method} <U+002B> stop()
}
class "AppState" as E1 <<entity>> {
  {field} <U+002B> bpm : number
  {method} <U+002B> getState() : AppState
}

B1 --> C1
B2 --> C1
B1 --> C2
B2 --> C2
C1 --> E1

@enduml
