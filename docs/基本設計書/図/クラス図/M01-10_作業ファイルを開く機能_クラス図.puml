@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "メニュー画面" as B1 <<boundary>> {
  {method} <U+002B> 作業ファイルを開くカードを押下する() : void
  {method} <U+002B> 開けなかった理由を知らせる() : void
}
class "ミュージックリスト画面" as B2 <<boundary>> {
  {method} <U+002B> 作業ファイルを開くボタンを押下する() : void
  {method} <U+002B> 開けなかった理由を知らせる() : void
}
class "シンプルモード画面" as B3 <<boundary>> {
  {method} <U+002B> 生成後の画面を表示する() : void
}
class "カスタムモード画面" as B4 <<boundary>> {
  {method} <U+002B> 設定タブを表示する() : void
}
class "作業ファイルを開く" as C1 <<control>> {
  {method} <U+002B> 作業ファイルを開く() : void
}
class "出力ファイル保存" as C2 <<control>> {
  {method} <U+002B> ファイルを選ばせて読み込む() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 再生を止める() : void
}
class "曲の管理" as C4 <<control>> {
  {method} <U+002B> 作業ファイルの曲を今の曲として読み込む() : void
}
class "履歴管理" as C5 <<control>> {
  {method} <U+002B> 履歴を捨てる() : void
}
class "画面切り替え" as C6 <<control>> {
  {method} <U+002B> 保存したモードの画面にする() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 曲の内容
  {field} <U+002B> 今の曲（リストの曲か）
  {field} <U+002B> 作業ファイルの場所
  {method} <U+002B> 今の曲が保存済みかを取得する() : void
  {method} <U+002B> 曲の内容と開いた場所を反映する() : void
}
class "作業ファイル" as E2 <<entity>> {
  {field} <U+002B> 曲ファイルの形式（.toniq.json）の曲
  {method} <U+002B> 読み込む() : void
}

B1 --> C1
B2 --> C1
C1 --> E1
C1 --> C2
C2 --> E2
C1 --> C3
C1 --> C4
C4 --> E1
C4 --> C5
C1 --> C6
C6 --> B3
C6 --> B4
C1 --> B1
C1 --> B2

@enduml
