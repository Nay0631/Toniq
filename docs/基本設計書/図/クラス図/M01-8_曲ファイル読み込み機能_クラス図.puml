@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "ミュージックリスト画面" as B1 <<boundary>> {
  {method} <U+002B> ファイルを読み込むボタンを押下してファイルを選ぶ() : void
  {method} <U+002B> 追加した曲数・読み込めなかった曲数を表示する() : void
}
class "曲ファイル読み込み" as C1 <<control>> {
  {method} <U+002B> 選んだファイルを読み込む() : void
}
class "曲の管理" as C2 <<control>> {
  {method} <U+002B> 曲を追加する() : void
  {method} <U+002D> 読み込めない理由を返す() : void
}
class "曲ファイル" as E1 <<entity>> {
  {field} <U+002B> 形式名・版・書き出した日時
  {field} <U+002B> 曲の一覧
  {method} <U+002B> 中身を取得する() : void
}
class "楽曲データ" as E2 <<entity>> {
  {field} <U+002B> 保存した曲
  {method} <U+002B> 足りない項目を補い、新しい ID で追加する() : void
}

B1 --> C1
C1 --> E1
C1 --> C2
C2 --> E2
C1 --> B1

@enduml
