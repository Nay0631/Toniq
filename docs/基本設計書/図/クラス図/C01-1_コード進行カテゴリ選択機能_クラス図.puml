@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "カスタムモード画面" as B1 <<boundary>> {
  {method} <U+002B> カテゴリを選ぶ() : void
}
class "カテゴリ設定" as C1 <<control>> {
  {method} <U+002B> カテゴリを設定する() : void
  {method} <U+002D> 今と同じスケールの進行に絞る() : void
}
class "再生" as C2 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 雰囲気
  {field} <U+002B> スケールロック
  {field} <U+002B> コード進行
  {method} <U+002B> 雰囲気を更新する() : void
  {method} <U+002B> 候補の先頭の進行に切り替える() : void
}
class "コード進行マスタ" as E2 <<entity>> {
  {field} <U+002B> 雰囲気
  {field} <U+002B> スケール
  {method} <U+002B> 雰囲気が合うコード進行を取得する() : void
}

B1 --> C1
C1 --> E1
C1 --> E2
C1 --> C2

@enduml
