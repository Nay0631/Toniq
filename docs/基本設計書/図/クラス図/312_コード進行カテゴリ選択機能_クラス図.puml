@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "CustomScreen" as B1 <<boundary>> {
  {method} <U+002D> chordCandidates() : ChordProgression[]
  {method} <U+002D> setChordPattern(next)
  {method} <U+002B> restartIfPlaying()
}
class "Playback" as C1 <<control>> {
  {method} <U+002B> play(options)
}
class "chord_progressions.json" as E1 <<entity>> {
  {field} <U+002B> id : string
  {field} <U+002B> mood : string[]
  {field} <U+002B> base_scale : string
}
class "AppState" as E2 <<entity>> {
  {field} <U+002B> mood : string
  {field} <U+002B> scaleLock : boolean
  {field} <U+002B> chordPattern
  {method} <U+002B> setState(partial)
}

B1 --> E1
B1 --> C1
B1 --> E2

@enduml
