@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "PianoRollTab" as B1 <<boundary>> {
  {field} <U+002D> selected : number
  {field} <U+002D> cursor : number
  {method} <U+002B> initPianoRoll()
  {method} <U+002D> startDrag(e, grid)
  {method} <U+002D> endDrag()
  {method} <U+002D> inputKey(offset)
  {method} <U+002D> allowed(midi, scale) : boolean
  {method} <U+002D> placeNote(others, note)
  {method} <U+002D> writeNotes(notes)
}
class "MelodyPlayer" as C1 <<control>> {
  {method} <U+002B> previewMelodyNote(note)
}
class "LayerManager" as C2 <<control>> {
  {method} <U+002B> reloadLayer(layer)
}
class "degree_resolver" as C3 <<control>> {
  {field} <U+002B> SCALE_TONES
  {field} <U+002B> NOTE_INDEX
}
class "AppState" as E1 <<entity>> {
  {field} <U+002B> melodyNotes : MelodyNote[]
  {field} <U+002B> melodyMethod : string
  {field} <U+002B> pianoRollLength : PianoRollLength
  {field} <U+002B> pianoRollOctave : number
  {method} <U+002B> setState(partial)
}

B1 --> C1
B1 --> C2
B1 --> C3
B1 --> E1

@enduml
