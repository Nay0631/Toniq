@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "ArrangerTab" as B1 <<boundary>> {
  {field} <U+002D> LANES
  {field} <U+002D> drag : Drag
  {method} <U+002B> initArranger(onSeek)
  {method} <U+002B> renderArranger()
  {method} <U+002D> addBlock(part, bar)
  {method} <U+002D> removeBlock(part, start)
  {method} <U+002D> freeRange(blocks, target, bar)
  {method} <U+002D> editArrangement(fn)
}
class "LoopArranger" as C1 <<control>> {
  {field} <U+002D> LOOP_SCHEDULE
  {method} <U+002B> getArrangement() : Arrangement
  {method} <U+002B> cloneArrangement(arrangement)
  {method} <U+002B> findBlock(blocks, bar)
  {method} <U+002B> isArrangedAt(part, bar) : boolean
  {method} <U+002B> arrangementGate(part)
}
class "LayerManager" as C2 <<control>> {
  {method} <U+002B> setLayerEnabled(layer, enabled)
}
class "各パートのPlayer" as C3 <<control>> {
  {method} <U+002B> load*()
}
class "AppState" as E1 <<entity>> {
  {field} <U+002B> arrangement : Arrangement
  {field} <U+002B> startBar : number
  {field} <U+002B> parts
  {method} <U+002B> setState(partial)
}
class "ArrangeBlock" as E2 <<entity>> {
  {field} <U+002B> start : number
  {field} <U+002B> length : number
  {field} <U+002B> fx : FxType
  {field} <U+002B> drum : string
}

B1 --> C1
B1 --> C2
B1 --> E1
C3 --> C1
C1 --> E1
E1 --> E2

@enduml
