@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "シンプルモード画面" as B1 <<boundary>> {
  {method} <U+002B> コードの再抽選ボタンを押下する() : void
}
class "カスタムモード画面" as B2 <<boundary>> {
  {method} <U+002B> コード進行を選ぶ() : void
}
class "コード進行設定" as C1 <<control>> {
  {method} <U+002B> コード進行を再抽選する() : void
  {method} <U+002B> 選んだコード進行に切り替える() : void
}
class "パターン選出" as C2 <<control>> {
  {method} <U+002B> 今の進行以外から選ぶ() : void
}
class "メロディ生成" as C3 <<control>> {
  {method} <U+002B> メロディを生成する() : void
}
class "再生" as C4 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "シンプルモード表マスタ" as E1 <<entity>> {
  {field} <U+002B> ジャンル×雰囲気
  {field} <U+002B> コード進行の候補
  {method} <U+002B> ジャンル×雰囲気の候補を取得する() : void
}
class "コード進行マスタ" as E2 <<entity>> {
  {field} <U+002B> ジャンル・雰囲気・スケール
  {field} <U+002B> ディグリーの並び
  {method} <U+002B> 候補のコード進行を取得する() : void
  {method} <U+002B> 選んだコード進行を取得する() : void
}
class "アプリの状態" as E3 <<entity>> {
  {field} <U+002B> コード進行
  {field} <U+002B> 小節数
  {field} <U+002B> メロディ
  {method} <U+002B> コード進行を更新する() : void
  {method} <U+002B> メロディを更新する() : void
}

B1 --> C1
B2 --> C1
C1 --> C2
C2 --> E1
C2 --> E2
C1 --> E2
C1 --> E3
C1 --> C3
C1 --> C4

@enduml
