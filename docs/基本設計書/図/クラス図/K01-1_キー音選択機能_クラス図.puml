@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "カスタムモード画面" as B1 <<boundary>> {
  {method} <U+002B> ルート音を選ぶ() : void
  {method} <U+002B> コード名を表示する() : void
}
class "キー設定" as C1 <<control>> {
  {method} <U+002B> キーを設定する() : void
}
class "メロディ生成" as C2 <<control>> {
  {method} <U+002B> メロディを生成する() : void
}
class "コード変換" as C3 <<control>> {
  {method} <U+002B> コード名を求める() : void
}
class "再生" as C4 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> キー
  {field} <U+002B> メロディ
  {method} <U+002B> キーを更新する() : void
  {method} <U+002B> メロディを更新する() : void
}
class "メロディ設定マスタ" as E2 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> リズム・フレーズ形式・音域
  {method} <U+002B> 生成パラメータを取得する() : void
}
class "スケールマスタ" as E3 <<entity>> {
  {field} <U+002B> スケール
  {field} <U+002B> 音程
  {method} <U+002B> スケールの音程を取得する() : void
}

B1 --> C1
C1 --> E1
C1 --> C2
C2 --> E2
C1 --> C3
C3 --> E3
C3 --> B1
C1 --> C4

@enduml
