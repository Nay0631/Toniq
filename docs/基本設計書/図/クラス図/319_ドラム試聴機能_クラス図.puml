@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "CustomScreen" as B1 <<boundary>> {
  {method} <U+002D> render()
}
class "Playback" as C1 <<control>> {
  {method} <U+002B> preview(layer, onEnded)
  {method} <U+002D> audioReady(genre)
}
class "DrumSamples" as C2 <<control>> {
  {field} <U+002B> DRUM_SAMPLE_DIRS
  {method} <U+002B> prepareDrumSamples(genre)
  {method} <U+002B> getDrumSample(genre, track)
}
class "LayerManager" as C3 <<control>> {
  {method} <U+002B> reloadLayer(layer)
}
class "DrumEngine" as C4 <<control>> {
  {field} <U+002D> CHOKES
  {method} <U+002B> loadDrumPattern(pattern)
  {method} <U+002B> disposeDrum()
}
class "SynthFactory" as C5 <<control>> {
  {field} <U+002D> DRUM_KITS
  {method} <U+002B> createDrumKit(genre, trackNames, source)
}
class "drum_patterns.json" as E1 <<entity>> {
  {field} <U+002B> steps : number
  {field} <U+002B> tracks
}
class "AppState" as E2 <<entity>> {
  {field} <U+002B> drumPattern
  {field} <U+002B> drumSource : DrumSource
}

B1 --> C1
C1 --> C2
C1 --> C3
C3 --> C4
C4 --> C5
C5 --> C2
C4 --> E1
C1 --> E2

@enduml
