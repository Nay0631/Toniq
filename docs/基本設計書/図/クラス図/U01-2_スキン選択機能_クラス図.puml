@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "設定画面" as B1 <<boundary>> {
  {method} <U+002B> スキンを押下する() : void
}
class "カスタムモード画面" as B2 <<boundary>> {
  {method} <U+002B> カスタムモードの見た目を変える() : void
}
class "見た目設定" as C1 <<control>> {
  {method} <U+002B> スキンを選ぶ() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> スキン
  {method} <U+002B> スキンを更新する() : void
}
class "端末の設定データ" as E2 <<entity>> {
  {field} <U+002B> スキン
  {method} <U+002B> スキンを保存する() : void
}

B1 --> C1
C1 --> E1
C1 --> E2
C1 --> B2

@enduml
