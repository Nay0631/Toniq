@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "アレンジ画面" as B1 <<boundary>> {
  {method} <U+002B> 小節の目盛りを押下する() : void
  {method} <U+002B> 先頭へボタンを押下する() : void
  {method} <U+002B> 再生ボタンの表示を「○小節目から」にする() : void
}
class "再生開始位置設定" as C1 <<control>> {
  {method} <U+002B> 再生開始位置を設定する() : void
}
class "再生" as C2 <<control>> {
  {method} <U+002B> その位置から再生し直す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 再生開始位置（小節）
  {method} <U+002B> 再生開始位置を更新する() : void
}

B1 --> C1
C1 --> E1
C1 --> C2
C1 --> B1

@enduml
