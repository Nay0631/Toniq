@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "カスタムモード画面" as B1 <<boundary>> {
  {method} <U+002B> スウィング・サイドチェインのノブを回す() : void
  {method} <U+002B> 標準ボタンを押下する() : void
  {method} <U+002B> ノブの値を表示する() : void
}
class "グルーヴ設定" as C1 <<control>> {
  {method} <U+002B> グルーヴの量を設定する() : void
}
class "グルーヴ" as C2 <<control>> {
  {method} <U+002B> スウィングを反映する() : void
  {method} <U+002B> ほかのパートを沈める() : void
  {method} <U+002D> 裏の16分音符をずらす() : void
}
class "ドラム演奏" as C3 <<control>> {
  {method} <U+002B> キックを鳴らす() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> スウィング（0〜100、空＝標準）
  {field} <U+002B> サイドチェイン（0〜100、空＝標準）
  {method} <U+002B> スウィング・サイドチェインを更新する() : void
  {method} <U+002B> スウィングの量を取得する() : void
  {method} <U+002B> サイドチェインの量を取得する() : void
}
class "ミックス設定マスタ" as E2 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> 標準のスウィング・サイドチェイン
  {method} <U+002B> ジャンルの標準の量を取得する() : void
}

B1 --> C1
C1 --> E1
C1 --> C2
C1 --> B1
C2 --> E1
C2 --> E2
C3 --> C2

@enduml
