@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "カスタムモード画面" as B1 <<boundary>> {
  {method} <U+002B> ドラムのカテゴリを選ぶ() : void
}
class "ドラムカテゴリ設定" as C1 <<control>> {
  {method} <U+002B> カテゴリを設定する() : void
}
class "再生" as C2 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> ドラムのカテゴリ
  {field} <U+002B> ドラムパターン
  {method} <U+002B> ドラムのカテゴリを更新する() : void
  {method} <U+002B> 候補の先頭のパターンに切り替える() : void
}
class "ドラムパターンマスタ" as E2 <<entity>> {
  {field} <U+002B> ジャンルのタグ
  {method} <U+002B> カテゴリのパターンを取得する() : void
}

B1 --> C1
C1 --> E1
C1 --> E2
C1 --> C2

@enduml
