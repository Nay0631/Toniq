@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "カスタムモード画面" as B1 <<boundary>> {
  {method} <U+002B> 再生ボタンを押下する() : void
}
class "ミュージックリスト画面" as B2 <<boundary>> {
  {method} <U+002B> 曲の再生ボタンを押下する() : void
  {method} <U+002B> 再生位置を表示する() : void
}
class "楽曲切り替え" as C1 <<control>> {
  {method} <U+002B> 選んだ曲を今の曲にする() : void
}
class "曲の管理" as C2 <<control>> {
  {method} <U+002B> 保存した曲を読み込む() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 再生する() : void
  {method} <U+002D> 小節数で止める予約をする() : void
}
class "各パートの演奏" as C4 <<control>> {
  {method} <U+002B> ON のパートを読み込む() : void
}
class "アレンジ管理" as C5 <<control>> {
  {method} <U+002B> 周回を数える() : void
}
class "楽曲データ" as E1 <<entity>> {
  {field} <U+002B> 曲名・お気に入り・日時
  {field} <U+002B> 曲の内容
  {method} <U+002B> 曲の内容を取得する() : void
}
class "アプリの状態" as E2 <<entity>> {
  {field} <U+002B> 曲の内容
  {field} <U+002B> 今の曲（リストの曲か）
  {method} <U+002B> 曲の内容を取得する() : void
  {method} <U+002B> 曲の内容を反映する() : void
}

B1 --> C3
B2 --> C1
C1 --> C2
C2 --> E1
C2 --> E2
C1 --> C3
C3 --> E2
C3 --> C4
C3 --> C5
C3 --> B2

@enduml
