@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "SimpleScreen" as B1 <<boundary>> {
  {method} <U+002D> playGenreSample()
  {method} <U+002D> render()
}
class "CustomScreen" as B2 <<boundary>> {
  {method} <U+002B> restartIfPlaying()
  {method} <U+002D> render()
}
class "SimpleModeResolver" as C1 <<control>> {
  {method} <U+002B> resolveTempoPreset(genre, preset) : number
}
class "Playback" as C2 <<control>> {
  {method} <U+002B> play(options)
  {method} <U+002B> isSamplePlaying() : boolean
}
class "MixerEngine" as C3 <<control>> {
  {method} <U+002B> applyMixPreset(genre)
}
class "tempo_presets.json" as E1 <<entity>> {
  {field} <U+002B> ゆっくり : number
  {field} <U+002B> 普通 : number
  {field} <U+002B> 速い : number
}
class "mix_presets.json" as E2 <<entity>> {
  {field} <U+002B> reverb
  {field} <U+002B> eq
  {field} <U+002B> compressor
  {field} <U+002B> limiter
  {field} <U+002B> gain
}
class "AppState" as E3 <<entity>> {
  {field} <U+002B> genre : string
  {field} <U+002B> bpm : number
  {field} <U+002B> drumCategory : string
  {method} <U+002B> setState(partial)
}

B1 --> C1
B2 --> C1
B1 --> C2
B2 --> C2
C1 --> E1
C2 --> C3
C3 --> E2
B1 --> E3
B2 --> E3

@enduml
