@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "カスタムモード画面" as B1 <<boundary>> {
  {method} <U+002B> スケールを選ぶ() : void
}
class "スケール設定" as C1 <<control>> {
  {method} <U+002B> スケールを設定する() : void
  {method} <U+002D> 同じ雰囲気の進行を優先して選ぶ() : void
}
class "メロディ生成" as C2 <<control>> {
  {method} <U+002B> メロディを生成する() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "コード進行マスタ" as E1 <<entity>> {
  {field} <U+002B> 雰囲気
  {field} <U+002B> スケール
  {method} <U+002B> そのスケールのコード進行を取得する() : void
}
class "アプリの状態" as E2 <<entity>> {
  {field} <U+002B> コード進行
  {field} <U+002B> メロディ
  {method} <U+002B> コード進行を更新する() : void
  {method} <U+002B> メロディを更新する() : void
}

B1 --> C1
C1 --> E1
C1 --> E2
C1 --> C2
C1 --> C3

@enduml
