@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "CustomScreen" as B1 <<boundary>> {
  {field} <U+002D> DRUM_CATEGORIES
  {method} <U+002D> drumCandidates() : DrumPattern[]
  {method} <U+002B> restartIfPlaying()
}
class "Playback" as C1 <<control>> {
  {method} <U+002B> play(options)
}
class "drum_patterns.json" as E1 <<entity>> {
  {field} <U+002B> id : string
  {field} <U+002B> genre : string[]
  {field} <U+002B> tracks
}
class "AppState" as E2 <<entity>> {
  {field} <U+002B> drumCategory : string
  {field} <U+002B> drumPattern
  {method} <U+002B> setState(partial)
}

B1 --> E1
B1 --> C1
B1 --> E2

@enduml
