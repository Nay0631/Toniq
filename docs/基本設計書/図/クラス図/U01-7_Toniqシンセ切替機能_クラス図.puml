@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "設定画面" as B1 <<boundary>> {
  {method} <U+002B> Toniqシンセのスイッチを押下する() : void
}
class "カスタムモード画面" as B2 <<boundary>> {
  {method} <U+002B> 音色の選択肢を出し入れする() : void
}
class "Toniqシンセパネル" as B3 <<boundary>> {
  {method} <U+002B> 音作りのパネルを出し入れする() : void
}
class "端末の設定" as C1 <<control>> {
  {method} <U+002B> Toniqシンセの使用を切り替える() : void
}
class "メロディ演奏" as C2 <<control>> {
  {method} <U+002B> 試聴を止める() : void
  {method} <U+002B> メロディの音源を作り直す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> Toniqシンセの使用
  {field} <U+002B> メロディの音色
  {method} <U+002B> Toniqシンセの使用を更新する() : void
  {method} <U+002B> 音色・Toniqシンセの使用を取得する() : void
}
class "端末の設定データ" as E2 <<entity>> {
  {field} <U+002B> Toniqシンセの使用
  {method} <U+002B> Toniqシンセの使用を保存する() : void
}
class "メロディ設定マスタ" as E3 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> 標準の音色
  {method} <U+002B> ジャンルの標準の音色を取得する() : void
}

B1 --> C1
C1 --> E1
C1 --> E2
C1 --> B2
C1 --> B3
C1 --> C2
C2 --> E1
C2 --> E3

@enduml
