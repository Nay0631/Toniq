@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "CustomScreen" as B1 <<boundary>> {
  {method} <U+002B> restartIfPlaying()
}
class "Playback" as C1 <<control>> {
  {method} <U+002B> play(options)
}
class "LayerManager" as C2 <<control>> {
  {method} <U+002B> reloadAllLayers()
}
class "MelodyPlayer" as C3 <<control>> {
  {field} <U+002D> INSTRUMENTS
  {method} <U+002B> initMelodySynth()
  {method} <U+002B> loadMelody(notes, loopEnd)
  {method} <U+002B> resolveMelodySound()
  {method} <U+002B> disposeMelody()
}
class "melody_params.json" as E1 <<entity>> {
  {field} <U+002B> instrument : string
}
class "AppState" as E2 <<entity>> {
  {field} <U+002B> melodyInstrument : string
  {method} <U+002B> setState(partial)
}

B1 --> C1
B1 --> E2
C1 --> C2
C2 --> C3
C3 --> E1
C3 --> E2

@enduml
