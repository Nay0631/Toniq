@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "ミュージックリスト画面" as B1 <<boundary>> {
  {method} <U+002B> 曲名を入力する・条件を押下する() : void
  {method} <U+002B> 絞り込んだ一覧を表示する() : void
}
class "楽曲の絞り込み" as C1 <<control>> {
  {method} <U+002B> 絞り込みの条件を変える() : void
  {method} <U+002D> 条件で絞り込んで並べる() : void
}
class "曲の管理" as C2 <<control>> {
  {method} <U+002B> 曲の一覧を取得する() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 検索語・ジャンル・お気に入り・並び順
  {method} <U+002B> 検索語・ジャンル・お気に入り・並び順を更新する() : void
}
class "楽曲データ" as E2 <<entity>> {
  {field} <U+002B> 曲名・ジャンル・お気に入り・日時
  {method} <U+002B> 保存した曲を取得する() : void
}

B1 --> C1
C1 --> E1
C1 --> C2
C2 --> E2
C1 --> B1

@enduml
