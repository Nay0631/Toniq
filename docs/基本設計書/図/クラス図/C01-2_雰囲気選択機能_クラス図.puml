@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "シンプルモード画面" as B1 <<boundary>> {
  {method} <U+002B> 雰囲気のチップを押下する() : void
  {method} <U+002B> 選択中の雰囲気を表示する() : void
}
class "雰囲気選択" as C1 <<control>> {
  {method} <U+002B> 雰囲気を選択する() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 雰囲気
  {method} <U+002B> 雰囲気を更新する() : void
}

B1 --> C1
C1 --> E1
C1 --> B1

@enduml
