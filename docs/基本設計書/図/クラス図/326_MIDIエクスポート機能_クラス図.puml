@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "SimpleScreen" as B1 <<boundary>> {
  {method} <U+002B> initSimpleScreen()
}
class "CustomScreen" as B2 <<boundary>> {
  {method} <U+002B> initCustomScreen()
}
class "MidiExporter" as C1 <<control>> {
  {method} <U+002B> exportMidi(progression, melodyNotes, key, bpm, filename)
  {method} <U+002D> durationToBeats(duration) : number
}
class "degree_resolver" as C2 <<control>> {
  {method} <U+002B> voiceProgression(progression, key, range)
  {method} <U+002B> resolveChord(degree, type, inversion, key, scale, octave)
}
class "ArpPlayer" as C3 <<control>> {
  {method} <U+002B> arpParam() : ArpParam
  {method} <U+002B> arpNotes(progression, key, param)
}
class "AppState" as E1 <<entity>> {
  {field} <U+002B> chordPattern
  {field} <U+002B> melodyNotes
  {field} <U+002B> key : string
  {field} <U+002B> bpm : number
}
class "MIDIファイル" as E2 <<entity>> {
  {field} <U+002B> Melody / Chord / Bass / Arpeggio
}

B1 --> C1
B2 --> C1
B1 --> E1
B2 --> E1
C1 --> C2
C1 --> C3
C1 --> E2

@enduml
