@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "アレンジ画面" as B1 <<boundary>> {
  {method} <U+002B> テスト中の機能のスイッチを押下する() : void
  {method} <U+002B> スイッチの ON/OFF を表示する() : void
}
class "テスト機能設定" as C1 <<control>> {
  {method} <U+002B> 機能を ON/OFF する() : void
}
class "端末の設定" as C2 <<control>> {
  {method} <U+002B> テスト中の機能を切り替える() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "ドラム演奏" as C4 <<control>> {
  {method} <U+002B> ドラムを鳴らす() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> エンディング・ドラムのフィル・ドラムの揺らぎ
  {method} <U+002B> テスト中の機能を更新する() : void
  {method} <U+002B> フィル・揺らぎを取得する() : void
}
class "端末の設定データ" as E2 <<entity>> {
  {field} <U+002B> テスト中の機能の ON/OFF
  {method} <U+002B> テスト中の機能を保存する() : void
}

B1 --> C1
C1 --> C2
C2 --> E1
C2 --> E2
C1 --> C3
C1 --> B1
C4 --> E1

@enduml
