@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "SimpleScreen" as B1 <<boundary>> {
  {method} <U+002B> initSimpleScreen()
}
class "CustomScreen" as B2 <<boundary>> {
  {method} <U+002B> initCustomScreen()
}
class "TapTempo" as C1 <<control>> {
  {field} <U+002D> tapTimes : number[]
  {field} <U+002D> lastTapTime : number
  {method} <U+002B> tap() : number
  {method} <U+002B> resetTap()
}
class "Playback" as C2 <<control>> {
  {method} <U+002B> isPlaying() : boolean
  {method} <U+002B> applyBpm()
}
class "AppState" as E1 <<entity>> {
  {field} <U+002B> bpm : number
  {field} <U+002B> tempoPreset : string
  {method} <U+002B> setState(partial)
}

B1 --> C1
B2 --> C1
B1 --> C2
B2 --> C2
C1 --> E1

@enduml
