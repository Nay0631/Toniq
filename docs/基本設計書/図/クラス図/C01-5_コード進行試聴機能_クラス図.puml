@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "カスタムモード画面" as B1 <<boundary>> {
  {method} <U+002B> コード進行の試聴ボタンを押下する() : void
}
class "再生" as C1 <<control>> {
  {method} <U+002B> コード進行を試聴する() : void
  {method} <U+002D> ほかの再生を止める() : void
  {method} <U+002D> 進行1周で止める予約をして鳴らす() : void
}
class "コード演奏" as C2 <<control>> {
  {method} <U+002B> コードを読み込む() : void
}
class "コード変換" as C3 <<control>> {
  {method} <U+002B> ボイシングを決める() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> コード進行
  {field} <U+002B> キー
  {method} <U+002B> コード進行とキーを取得する() : void
}
class "スケールマスタ" as E2 <<entity>> {
  {field} <U+002B> スケール
  {field} <U+002B> 音程
  {method} <U+002B> スケールの音程を取得する() : void
}

B1 --> C1
C1 --> C2
C2 --> E1
C2 --> C3
C3 --> E2

@enduml
