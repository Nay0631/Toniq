@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "MusicListScreen" as B1 <<boundary>> {
  {method} <U+002B> initMusicListScreen()
  {method} <U+002D> togglePlay(id)
  {method} <U+002D> useSong(id) : boolean
  {method} <U+002D> confirmDiscard(nextId) : boolean
  {method} <U+002D> startProgressLoop()
}
class "SongLibrary" as C1 <<control>> {
  {method} <U+002B> listSongs() : SavedSong[]
  {method} <U+002B> findSong(id) : SavedSong
  {method} <U+002B> loadSong(id) : boolean
}
class "VolumeManager" as C2 <<control>> {
  {method} <U+002B> applyAllVolumes()
}
class "History" as C3 <<control>> {
  {method} <U+002B> resetHistory()
}
class "Playback" as C4 <<control>> {
  {method} <U+002B> play(options)
  {method} <U+002B> stop()
  {method} <U+002B> getPositionSeconds() : number
}
class "SavedSong" as E1 <<entity>> {
  {field} <U+002B> id : string
  {field} <U+002B> name : string
  {field} <U+002B> favorite : boolean
  {field} <U+002B> createdAt : number
  {field} <U+002B> updatedAt : number
  {field} <U+002B> 曲の内容（SONG_FIELDS）
}
class "AppState" as E2 <<entity>> {
  {field} <U+002B> songId : string
  {method} <U+002B> setState(partial)
}

B1 --> C1
B1 --> C4
C1 --> E1
C1 --> E2
C1 --> C2
C1 --> C3

@enduml
