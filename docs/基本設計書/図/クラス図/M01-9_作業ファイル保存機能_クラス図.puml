@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "シンプルモード画面" as B1 <<boundary>> {
  {method} <U+002B> 作業ファイルボタンを押下する() : void
  {method} <U+002B> 「保存しました」と保存した場所を表示する() : void
  {method} <U+002B> 保存に失敗した理由を知らせる() : void
}
class "カスタムモード画面" as B2 <<boundary>> {
  {method} <U+002B> 作業ファイルボタンを押下する() : void
  {method} <U+002B> 「保存しました」と保存した場所を表示する() : void
  {method} <U+002B> 保存に失敗した理由を知らせる() : void
}
class "作業ファイル保存" as C1 <<control>> {
  {method} <U+002B> 今の曲を作業ファイルに保存する() : void
  {method} <U+002D> 保存しない() : void
}
class "曲の管理" as C2 <<control>> {
  {method} <U+002B> 曲ファイルの形式にする() : void
}
class "出力ファイル保存" as C3 <<control>> {
  {method} <U+002B> 保存先を選ばせて保存する() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 曲の内容
  {field} <U+002B> 今の曲（リストの曲か・曲名）
  {field} <U+002B> 作業ファイルの場所
  {method} <U+002B> 曲の内容・曲名・前回の保存先を取得する() : void
  {method} <U+002B> 保存した場所を更新する() : void
}
class "作業ファイル" as E2 <<entity>> {
  {field} <U+002B> 曲ファイルの形式（.toniq.json）の1曲
  {field} <U+002B> 保存先（output/projects など）
  {method} <U+002B> 保存する() : void
}

B1 --> C1
B2 --> C1
C1 --> E1
C1 --> C2
C1 --> C3
C3 --> E2
C1 --> B1
C1 --> B2

@enduml
