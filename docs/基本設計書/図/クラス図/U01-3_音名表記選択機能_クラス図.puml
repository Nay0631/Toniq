@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "設定画面" as B1 <<boundary>> {
  {method} <U+002B> 音名の表記を押下する() : void
}
class "音楽クイズ画面" as B2 <<boundary>> {
  {method} <U+002B> 音名の表記を押下する() : void
}
class "ピアノロール画面" as B3 <<boundary>> {
  {method} <U+002B> 鍵盤・音符の音名を表示し直す() : void
}
class "端末の設定" as C1 <<control>> {
  {method} <U+002B> 音名の表記を選ぶ() : void
}
class "クイズ出題" as C2 <<control>> {
  {method} <U+002B> 新しい問題を出す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 音名の表記
  {method} <U+002B> 音名の表記を更新する() : void
}
class "端末の設定データ" as E2 <<entity>> {
  {field} <U+002B> 音名の表記
  {method} <U+002B> 音名の表記を保存する() : void
}

B1 --> C1
B2 --> C1
C1 --> E1
C1 --> E2
C1 --> B3
B2 --> C2

@enduml
