@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "CustomScreen" as B1 <<boundary>> {
  {method} <U+002D> render()
}
class "Playback" as C1 <<control>> {
  {method} <U+002B> preview(layer, onEnded)
  {method} <U+002B> stop()
}
class "MixerEngine" as C2 <<control>> {
  {method} <U+002B> applyMixPreset(genre)
  {method} <U+002B> mixerReady()
}
class "LoopArranger" as C3 <<control>> {
  {method} <U+002B> setArrangementBypass(on)
}
class "LayerManager" as C4 <<control>> {
  {method} <U+002B> reloadLayer(layer)
}
class "ChordPlayer" as C5 <<control>> {
  {method} <U+002B> loadChordProgression(progression, key)
}
class "degree_resolver" as C6 <<control>> {
  {method} <U+002B> voiceProgression(progression, key, range)
  {method} <U+002B> resolveChord(degree, type, inversion, key, scale, octave)
}
class "chord_progressions.json" as E1 <<entity>> {
  {field} <U+002B> progression : ChordDegree[]
  {field} <U+002B> length_bars : number
}

B1 --> C1
C1 --> C2
C1 --> C3
C1 --> C4
C4 --> C5
C5 --> C6
C5 --> E1

@enduml
