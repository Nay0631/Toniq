@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "アレンジ画面" as B1 <<boundary>> {
  {method} <U+002B> セクションの行の周回を押下する() : void
  {method} <U+002B> 周回ごとの Aメロ・サビを表示する() : void
}
class "セクション切り替え" as C1 <<control>> {
  {method} <U+002B> その周回の Aメロ／サビを切り替える() : void
  {method} <U+002D> 押した周回を Aメロとサビで入れ替える() : void
}
class "曲の構成" as C2 <<control>> {
  {method} <U+002B> 周回ごとのセクションを取得する() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> セクション（周回ごとの Aメロ／サビ）
  {field} <U+002B> ジャンル・小節数
  {method} <U+002B> セクション・ジャンル・小節数を取得する() : void
  {method} <U+002B> セクションを更新する() : void
}
class "標準アレンジマスタ" as E2 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> 周回ごとのセクション
  {method} <U+002B> 標準のセクションを取得する() : void
}

B1 --> C1
C1 --> C2
C2 --> E1
C2 --> E2
C1 --> E1
C1 --> C3
C1 --> B1

@enduml
