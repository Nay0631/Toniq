@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "シンプルモード画面" as B1 <<boundary>> {
  {method} <U+002B> 生成するボタンを押下する() : void
  {method} <U+002B> 生成結果と残した内容を表示する() : void
  {method} <U+002B> 「雰囲気・ジャンル・テンポを変更」ボタンを押下する() : void
  {method} <U+002B> 設定画面（生成前）を表示する() : void
}
class "確認ダイアログ" as B2 <<boundary>> {
  {method} <U+002B> 今の曲が置き換わることを知らせる() : void
  {method} <U+002B> 戻り方を選ぶ() : void
}
class "楽曲生成" as C1 <<control>> {
  {method} <U+002B> 楽曲を生成する() : void
  {method} <U+002D> メロディなしで生成するか確認する() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 再生・クリック音を止める() : void
}
class "拍子" as C8 <<control>> {
  {method} <U+002B> ジャンルの標準の拍子にし、オリジナルのドラムを置き直す() : void
}
class "パターン選出" as C4 <<control>> {
  {method} <U+002B> コード進行・ドラム・サビの進行を選ぶ() : void
}
class "アレンジ管理" as C5 <<control>> {
  {method} <U+002B> 全パートがそろう周回数を求める() : void
}
class "曲の構成" as C6 <<control>> {
  {method} <U+002B> Aメロとサビのメロディを作る() : void
}
class "メロディ生成" as C7 <<control>> {
  {method} <U+002B> メロディを作る() : void
}
class "履歴管理" as C9 <<control>> {
  {method} <U+002B> 元に戻すの履歴を捨てる() : void
}
class "コードの説明" as C10 <<control>> {
  {method} <U+002B> キー・コード名の説明を作る() : void
}
class "設定画面に戻る" as C11 <<control>> {
  {method} <U+002B> 設定画面に戻る() : void
  {method} <U+002B> 選んだ戻り方を渡す() : void
  {method} <U+002D> 戻らない() : void
}
class "保存の確認" as C12 <<control>> {
  {method} <U+002B> ミュージックリストに保存する() : void
}
class "楽曲データ" as E8 <<entity>> {
  {field} <U+002B> 保存した曲
  {method} <U+002B> 曲を保存する() : void
}
class "シンプルモード表マスタ" as E1 <<entity>> {
  {field} <U+002B> ジャンル×雰囲気
  {field} <U+002B> コード進行の候補・ドラムの候補
  {method} <U+002B> ジャンル×雰囲気の候補を取得する() : void
}
class "ジャンルスケールマスタ" as E7 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> 合うスケール
  {method} <U+002B> ジャンルに合うスケールを取得する() : void
}
class "コード進行マスタ" as E2 <<entity>> {
  {field} <U+002B> ジャンル・雰囲気・スケール
  {field} <U+002B> ディグリーの並び（長さ）
  {method} <U+002B> コード進行と同じ長さ・スケールのサビの進行を取得する() : void
}
class "ドラムパターンマスタ" as E3 <<entity>> {
  {field} <U+002B> 16ステップのパターン
  {method} <U+002B> ドラムパターンを取得する() : void
}
class "標準アレンジマスタ" as E4 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> セクションごとの鳴らすパート
  {method} <U+002B> ジャンルの標準アレンジを取得する() : void
}
class "メロディ設定マスタ" as E5 <<entity>> {
  {field} <U+002B> リズム・フレーズ形式・音域
  {field} <U+002B> 標準の拍子
  {method} <U+002B> 標準の拍子を取得する() : void
  {method} <U+002B> 生成パラメータを取得する() : void
}
class "アプリの状態" as E6 <<entity>> {
  {field} <U+002B> 拍子
  {field} <U+002B> コード進行・サビの進行・ドラムパターン
  {field} <U+002B> メロディ・サビのメロディ
  {field} <U+002B> 小節数
  {field} <U+002B> 生成済み
  {field} <U+002B> 今の曲・構成・変えた所・セクション
  {method} <U+002B> 曲の内容を更新し生成済みにする() : void
}

B1 --> C1
C1 --> C3
C1 --> C8
C8 --> E5
C1 --> C4
C4 --> E1
C4 --> E7
C4 --> E2
C4 --> E3
C1 --> C5
C5 --> E4
C1 --> C6
C6 --> C7
C7 --> E5
C1 --> E6
C1 --> C9
C1 --> C10
C1 --> B1
B1 --> C11
C11 --> B2
B2 --> C11
C11 --> C12
C12 --> E8
C11 --> B1

@enduml
