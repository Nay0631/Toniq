@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "シンプルモード画面" as B1 <<boundary>> {
  {method} <U+002B> 生成するボタンを押下する() : void
  {method} <U+002B> 生成結果を表示する() : void
}
class "アレンジ画面" as B2 <<boundary>> {
  {method} <U+002B> メロディの差し替えボタンを押下する() : void
}
class "ピアノロール画面" as B3 <<boundary>> {
  {method} <U+002B> 表示する() : void
}
class "楽曲生成" as C1 <<control>> {
  {method} <U+002B> 楽曲を生成する() : void
}
class "メロディ再生成" as C2 <<control>> {
  {method} <U+002B> メロディを作り直す() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 再生・クリック音を止める() : void
  {method} <U+002B> 再生し直す() : void
}
class "パターン選出" as C4 <<control>> {
  {method} <U+002B> コード進行とドラムを選ぶ() : void
}
class "アレンジ管理" as C5 <<control>> {
  {method} <U+002B> 全パートがそろう周回数を求める() : void
}
class "メロディ生成" as C6 <<control>> {
  {method} <U+002B> メロディを作る() : void
}
class "シンプルモード表マスタ" as E1 <<entity>> {
  {field} <U+002B> ジャンル×雰囲気
  {field} <U+002B> コード進行の候補・ドラムの候補
  {method} <U+002B> ジャンル×雰囲気の候補を取得する() : void
}
class "メロディ設定マスタ" as E2 <<entity>> {
  {field} <U+002B> リズム・フレーズ形式・音域
  {method} <U+002B> 生成パラメータを取得する() : void
}
class "アプリの状態" as E3 <<entity>> {
  {field} <U+002B> コード進行・ドラムパターン・メロディ
  {field} <U+002B> 小節数
  {field} <U+002B> 生成済み
  {method} <U+002B> 曲の内容を更新し生成済みにする() : void
  {method} <U+002B> メロディを更新する() : void
}

B1 --> C1
C1 --> C3
C1 --> C4
C4 --> E1
C1 --> C5
C1 --> C6
C6 --> E2
C1 --> E3
C1 --> B1
B2 --> C2
C2 --> C6
C2 --> E3
C2 --> C3
C2 --> B3

@enduml
