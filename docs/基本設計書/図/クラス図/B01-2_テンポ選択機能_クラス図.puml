@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "シンプルモード画面" as B1 <<boundary>> {
  {method} <U+002B> テンポのチップを押下する() : void
}
class "テンポ選択" as C1 <<control>> {
  {method} <U+002B> テンポを選択する() : void
}
class "タップテンポ" as C2 <<control>> {
  {method} <U+002B> タップの記録を消す() : void
}
class "パターン選出" as C3 <<control>> {
  {method} <U+002B> ジャンルとテンポからBPMを求める() : void
}
class "再生" as C4 <<control>> {
  {method} <U+002B> テンポを反映する() : void
}
class "テンポマスタ" as E1 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> ゆっくり・普通・速いのBPM
  {method} <U+002B> BPMを取得する() : void
}
class "アプリの状態" as E2 <<entity>> {
  {field} <U+002B> テンポプリセット
  {field} <U+002B> BPM
  {method} <U+002B> テンポとBPMを更新する() : void
}

B1 --> C1
C1 --> C2
C1 --> C3
C3 --> E1
C1 --> E2
C1 --> C4

@enduml
