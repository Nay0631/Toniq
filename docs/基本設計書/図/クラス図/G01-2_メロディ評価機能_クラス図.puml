@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "メロディの評価画面" as B1 <<boundary>> {
  {method} <U+002B> 曲を切り替える（前・次・未評価へ）() : void
  {method} <U+002B> 再生する・サビから再生する() : void
  {method} <U+002B> 点数・タグ・メモを付ける() : void
  {method} <U+002B> CSV・JSON に書き出すボタンを押下する() : void
  {method} <U+002B> JSON を読み込むボタンを押下する() : void
  {method} <U+002B> この条件の評価を消すボタンを押下する() : void
  {method} <U+002B> 画面を離れる() : void
  {method} <U+002B> 曲の番号・内容を表示する() : void
  {method} <U+002B> 結果の表と同じ曲どうしの差を表示する() : void
}
class "評価" as C1 <<control>> {
  {method} <U+002B> 評価する曲を作る() : void
  {method} <U+002B> 採点する() : void
  {method} <U+002B> 評価を終える() : void
  {method} <U+002D> 未評価の次の曲へ進む() : void
}
class "一括計測" as C2 <<control>> {
  {method} <U+002B> 一括計測と同じシードで曲を作る() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 鳴らすパートで再生する() : void
}
class "自動チェック" as C5 <<control>> {
  {method} <U+002B> 自動チェックの結果を求める() : void
}
class "評価の管理" as C4 <<control>> {
  {method} <U+002B> 評価を保存する() : void
  {method} <U+002B> 条件ごとに集計し同じ曲どうしを比べる() : void
  {method} <U+002B> 評価を書き出す() : void
  {method} <U+002B> 評価を読み込む() : void
  {method} <U+002B> 条件の評価を消す() : void
  {method} <U+002D> 書き出して古い条件を消すよう知らせる() : void
  {method} <U+002D> 消すか確認する() : void
}
class "シンプルモード表マスタ" as E1 <<entity>> {
  {field} <U+002B> ジャンル×雰囲気
  {method} <U+002B> ジャンル×雰囲気の候補を取得する() : void
}
class "コード進行マスタ" as E2 <<entity>> {
  {method} <U+002B> コード進行を取得する() : void
}
class "ドラムパターンマスタ" as E3 <<entity>> {
  {method} <U+002B> ドラムパターンを取得する() : void
}
class "メロディ設定マスタ" as E4 <<entity>> {
  {method} <U+002B> 生成パラメータを取得する() : void
}
class "アプリの状態" as E5 <<entity>> {
  {field} <U+002B> 曲の内容
  {method} <U+002B> 曲の内容を差し替える() : void
  {method} <U+002B> 曲の内容を入る前の曲に戻す() : void
}
class "メロディの評価データ" as E6 <<entity>> {
  {field} <U+002B> 条件名・曲の番号
  {field} <U+002B> 点数・タグ・メモ
  {method} <U+002B> 評価を保存する() : void
  {method} <U+002B> 評価を取得する() : void
  {method} <U+002B> 評価を足す（同じ条件・同じ曲は置き換える）() : void
  {method} <U+002B> 条件の評価を消す() : void
}
class "評価ファイル" as E7 <<entity>> {
  {field} <U+002B> CSV・JSON
  {field} <U+002B> 保存先（output/quality）
  {method} <U+002B> CSV・JSON に書き出す() : void
  {method} <U+002B> JSON を読み込む() : void
}

B1 --> C1
B1 --> C3
B1 --> C4
C1 --> C2
C2 --> E1
C2 --> E2
C2 --> E3
C2 --> E4
C1 --> E5
C1 --> C4
C1 --> C5
C1 --> B1
C4 --> E6
C4 --> E7

@enduml
