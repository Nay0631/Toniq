@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "ミュージックリスト画面" as B1 <<boundary>> {
  {method} <U+002B> 「書き出したファイル」に切り替える() : void
}
class "書き出したファイル一覧" as B2 <<boundary>> {
  {method} <U+002B> 種類・並び順・「更新」を押下する() : void
  {method} <U+002B> 再生ボタンを押下する() : void
  {method} <U+002B> 「場所を開く」を押下する() : void
  {method} <U+002B> ごみ箱へ移すボタンを押下する() : void
  {method} <U+002B> 一覧と種類ごとのファイル数を表示する() : void
  {method} <U+002B> 一覧を読めなかったことを表示する() : void
  {method} <U+002B> 再生位置と長さを表示する() : void
  {method} <U+002B> 再生できなかったことを知らせる() : void
  {method} <U+002B> 移せなかったことを知らせる() : void
}
class "ファイルの絞り込み" as C1 <<control>> {
  {method} <U+002B> 表示を切り替える() : void
  {method} <U+002B> 絞り込みの条件を変える() : void
  {method} <U+002B> 一覧を読み直す() : void
}
class "ファイルの試聴" as C2 <<control>> {
  {field} <U+002D> 聴いているファイル
  {method} <U+002B> ファイルを聴く・止める() : void
  {method} <U+002D> 聴くのを止める() : void
}
class "ごみ箱へ移す" as C3 <<control>> {
  {method} <U+002B> ファイルをごみ箱へ移す() : void
  {method} <U+002D> 移さない() : void
}
class "出力ファイル保存" as C4 <<control>> {
  {field} <U+002D> 出力フォルダの場所（output/）
  {field} <U+002D> 種類ごとのフォルダ（audio・midi）
  {method} <U+002B> 書き出したファイルの一覧を読む() : void
  {method} <U+002B> WAV・MP3 を読み込む() : void
  {method} <U+002B> ファイルをエクスプローラーで表示する() : void
  {method} <U+002B> ごみ箱へ移す() : void
}
class "再生" as C5 <<control>> {
  {method} <U+002B> 曲の再生を止める() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> ミュージックリストの表示（保存した曲／書き出したファイル）
  {field} <U+002B> ファイルの種類（すべて／WAV／MP3／MIDI）
  {field} <U+002B> 並び順
  {method} <U+002B> 表示を書き出したファイルにする() : void
  {method} <U+002B> 種類・並び順を更新する() : void
}

B1 --> C1
B2 --> C1
B2 --> C2
B2 --> C3
B2 --> C4
C1 --> E1
C1 --> C4
C1 --> B2
C2 --> C5
C2 --> C4
C2 --> B2
C3 --> C4
C3 --> C1
C3 --> B2

@enduml
