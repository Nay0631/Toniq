@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "growパネル" as B1 <<boundary>> {
  {method} <U+002B> プリセットのボタンを押下する() : void
  {method} <U+002B> 選んでいるボタンを表示する() : void
}
class "音色設定" as C1 <<control>> {
  {method} <U+002B> メロディの音色を設定する() : void
}
class "音色試聴" as C2 <<control>> {
  {method} <U+002B> 主音を1音鳴らす() : void
}
class "grow" as C3 <<control>> {
  {method} <U+002B> 選んだ音色で鳴らす() : void
  {method} <U+002B> 鳴っているメロディにすぐ反映する() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> メロディの音色（空＝ジャンルの標準）
  {field} <U+002B> メロディの変えた値
  {method} <U+002B> メロディの音色を更新し、変えた値を捨てる() : void
}
class "growプリセット" as E2 <<entity>> {
  {field} <U+002B> ID
  {field} <U+002B> プリセット名
  {field} <U+002B> カテゴリ
  {field} <U+002B> 音作りの値
  {method} <U+002B> プリセットを取得する() : void
  {method} <U+002B> ジャンルの標準のプリセットを取得する() : void
}

B1 --> C1
C1 --> E2
C1 --> E1
C1 --> C2
C2 --> C3
C1 --> C3
C1 --> B1

@enduml
