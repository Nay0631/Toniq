@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "ミュージックリスト画面" as B1 <<boundary>> {
  {method} <U+002B> 曲の編集ボタンを押下する() : void
}
class "シンプルモード画面" as B2 <<boundary>> {
  {method} <U+002B> 生成後の画面を表示する() : void
}
class "カスタムモード画面" as B3 <<boundary>> {
  {method} <U+002B> 設定タブを表示する() : void
}
class "楽曲切り替え" as C1 <<control>> {
  {method} <U+002B> 選んだ曲を今の曲にする() : void
}
class "再生" as C2 <<control>> {
  {method} <U+002B> 再生を止める() : void
}
class "曲の管理" as C3 <<control>> {
  {method} <U+002B> 保存した曲を読み込む() : void
}
class "音量管理" as C4 <<control>> {
  {method} <U+002B> 音量を反映する() : void
}
class "履歴管理" as C5 <<control>> {
  {method} <U+002B> 履歴を捨てる() : void
}
class "画面切り替え" as C6 <<control>> {
  {method} <U+002B> 保存したモードの画面にする() : void
}
class "楽曲データ" as E1 <<entity>> {
  {field} <U+002B> モード
  {field} <U+002B> 曲の内容
  {method} <U+002B> 曲の内容を取得する() : void
}
class "アプリの状態" as E2 <<entity>> {
  {field} <U+002B> 曲の内容
  {field} <U+002B> 今の曲（リストの曲か）
  {method} <U+002B> 曲の内容を反映する() : void
}

B1 --> C1
C1 --> C2
C1 --> C3
C3 --> E1
C3 --> E2
C3 --> C4
C3 --> C5
C1 --> C6
C6 --> B2
C6 --> B3

@enduml
