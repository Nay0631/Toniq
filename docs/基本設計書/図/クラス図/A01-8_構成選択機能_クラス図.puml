@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "アレンジ画面" as B1 <<boundary>> {
  {method} <U+002B> 構成を選ぶ() : void
  {method} <U+002B> タイムライン・セクションの行・構成の表示を出す() : void
}
class "構成選択" as C1 <<control>> {
  {method} <U+002B> 構成を設定する() : void
}
class "アレンジ管理" as C2 <<control>> {
  {method} <U+002B> アレンジを組み直し、変えた所を当て直す() : void
}
class "再生" as C3 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 構成のプリセット
  {field} <U+002B> 変えた所
  {method} <U+002B> 構成のプリセットを更新する() : void
}
class "構成プリセットマスタ" as E2 <<entity>> {
  {field} <U+002B> 構成（標準・静かに始まる・サビを強く・短く繰り返す・だんだん盛り上がる・サビ頭）
  {field} <U+002B> 標準アレンジへの変形
  {method} <U+002B> 構成のプリセットの変形を取得する() : void
}
class "標準アレンジマスタ" as E3 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> セクションごとの鳴らすパート
  {method} <U+002B> ジャンルの標準アレンジを取得する() : void
}

B1 --> C1
C1 --> E1
C1 --> C2
C2 --> E3
C2 --> E2
C1 --> C3
C1 --> B1

@enduml
