@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "シンプルモード画面" as B1 <<boundary>> {
  {method} <U+002B> クリックで試聴ボタンを押下する() : void
}
class "カスタムモード画面" as B2 <<boundary>> {
  {method} <U+002B> 試聴ボタンを押下する() : void
}
class "クリック音" as C1 <<control>> {
  {method} <U+002B> クリック音を鳴らす() : void
  {method} <U+002B> クリック音を止める() : void
  {method} <U+002D> 次の拍のクリック音を予約する() : void
}
class "再生" as C2 <<control>> {
  {method} <U+002B> 曲の再生を止める() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> BPM
  {method} <U+002B> BPMを取得する() : void
}

B1 --> C1
B2 --> C1
B1 --> C2
B2 --> C2
C1 --> E1

@enduml
