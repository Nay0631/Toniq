@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "設定画面" as B1 <<boundary>> {
  {method} <U+002B> 用語の説明のスイッチを押下する() : void
  {method} <U+002B> 点線の下線の表示を切り替える() : void
}
class "用語の説明" as C1 <<control>> {
  {field} <U+002D> 用語と説明の一覧
  {method} <U+002B> 用語の説明を切り替える() : void
  {method} <U+002D> 表示中の説明を消す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 用語の説明の ON/OFF
  {method} <U+002B> 用語の説明の ON/OFF を更新する() : void
}
class "端末の設定データ" as E2 <<entity>> {
  {field} <U+002B> 用語の説明の ON/OFF
  {method} <U+002B> 用語の説明の ON/OFF を保存する() : void
}

B1 --> C1
C1 --> E1
C1 --> E2
C1 --> B1

@enduml
