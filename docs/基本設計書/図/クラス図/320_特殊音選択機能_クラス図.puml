@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "CustomScreen" as B1 <<boundary>> {
  {method} <U+002B> restartIfPlaying()
}
class "LayerManager" as C1 <<control>> {
  {method} <U+002B> setLayerEnabled(layer, enabled)
  {method} <U+002B> reloadLayer(layer)
  {method} <U+002D> disposeLayer(layer)
}
class "PadPlayer" as C2 <<control>> {
  {method} <U+002B> loadPadPattern(progression, key)
  {method} <U+002B> disposePad()
}
class "ArpPlayer" as C3 <<control>> {
  {method} <U+002B> loadArpPattern(progression, key)
  {method} <U+002B> disposeArp()
}
class "SignaturePlayer" as C4 <<control>> {
  {field} <U+002D> SIGNATURES
  {method} <U+002B> loadSignature(progression, key)
  {method} <U+002B> disposeSignature()
}
class "FxPlayer" as C5 <<control>> {
  {field} <U+002D> FX_DEFS
  {field} <U+002D> GENRE_FX
  {method} <U+002B> loadFx(progression)
  {method} <U+002B> disposeFx()
}
class "Playback" as C6 <<control>> {
  {method} <U+002B> play(options)
}
class "AppState" as E1 <<entity>> {
  {field} <U+002B> parts : Record<LayerName, boolean>
  {field} <U+002B> fxType : FxType
  {method} <U+002B> setState(partial)
}

B1 --> C1
B1 --> C6
B1 --> E1
C1 --> C2
C1 --> C3
C1 --> C4
C1 --> C5
C1 --> E1

@enduml
