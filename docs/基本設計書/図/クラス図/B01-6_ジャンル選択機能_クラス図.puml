@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "シンプルモード画面" as B1 <<boundary>> {
  {method} <U+002B> ジャンルのチップを押下する() : void
}
class "カスタムモード画面" as B2 <<boundary>> {
  {method} <U+002B> ジャンルを選ぶ() : void
}
class "ジャンル設定" as C1 <<control>> {
  {method} <U+002B> ジャンルを設定する() : void
}
class "パターン選出" as C2 <<control>> {
  {method} <U+002B> BPMを求める() : void
}
class "ジャンル試聴" as C3 <<control>> {
  {method} <U+002B> 新しいジャンルのサンプルを鳴らす() : void
}
class "再生" as C4 <<control>> {
  {method} <U+002B> 再生し直す() : void
}
class "ミックス" as C5 <<control>> {
  {method} <U+002B> ミックスをジャンルに合わせる() : void
}
class "テンポマスタ" as E1 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> ゆっくり・普通・速いのBPM
  {method} <U+002B> BPMを取得する() : void
}
class "アプリの状態" as E2 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> BPM
  {field} <U+002B> ドラムのカテゴリ
  {method} <U+002B> ジャンルとBPMを更新する() : void
}
class "ミックス設定マスタ" as E3 <<entity>> {
  {field} <U+002B> ジャンル
  {field} <U+002B> リバーブ・EQ・コンプ・リミッター・音量
  {method} <U+002B> ミックス設定を取得する() : void
}

B1 --> C1
B2 --> C1
C1 --> C2
C2 --> E1
C1 --> E2
C1 --> C3
C1 --> C4
C4 --> C5
C5 --> E3

@enduml
