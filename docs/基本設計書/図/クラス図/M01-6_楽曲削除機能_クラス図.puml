@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "ミュージックリスト画面" as B1 <<boundary>> {
  {method} <U+002B> 「削除」を押下する() : void
  {method} <U+002B> 曲の一覧を表示し直す() : void
  {method} <U+002B> 保存容量の案内を知らせる() : void
}
class "楽曲削除" as C1 <<control>> {
  {method} <U+002B> 曲を削除する() : void
  {method} <U+002D> 削除しない() : void
}
class "再生" as C2 <<control>> {
  {method} <U+002B> 再生を止める() : void
}
class "曲の管理" as C3 <<control>> {
  {method} <U+002B> 曲を削除する() : void
  {method} <U+002D> 削除しない() : void
}
class "楽曲データ" as E1 <<entity>> {
  {field} <U+002B> 保存した曲
  {method} <U+002B> 曲を削除する() : void
}
class "アプリの状態" as E2 <<entity>> {
  {field} <U+002B> 今の曲（リストの曲か）
  {method} <U+002B> 未保存の曲にする() : void
}

B1 --> C1
C1 --> C2
C1 --> C3
C3 --> E1
C3 --> E2
C1 --> B1

@enduml
