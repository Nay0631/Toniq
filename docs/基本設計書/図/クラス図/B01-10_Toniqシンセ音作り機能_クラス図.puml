@startuml
!include ../astah-class-style.puml
mainframe **pkg**

class "Toniqシンセパネル" as B1 <<boundary>> {
  {method} <U+002B> プリセットを選ぶ() : void
  {method} <U+002B> 試聴ボタンを押下する() : void
  {method} <U+002B> メロディに使うボタンを押下する() : void
  {method} <U+002B> ノブの値とプリセット名を表示する() : void
  {method} <U+002B> 停止ボタンを表示する() : void
  {method} <U+002B> 試聴ボタンを表示する() : void
  {method} <U+002B> メロディで使用中と表示する() : void
}
class "音作り設定" as C1 <<control>> {
  {method} <U+002B> 音作りの値を設定する() : void
  {method} <U+002B> メロディに使う() : void
}
class "Toniqシンセ試聴の切り替え" as C2 <<control>> {
  {method} <U+002B> 試聴を切り替える() : void
}
class "メロディ演奏" as C3 <<control>> {
  {method} <U+002B> 音作りの値をすぐ反映する() : void
  {method} <U+002B> フレーズを鳴らす() : void
  {method} <U+002B> 試聴を止める() : void
}
class "Toniqシンセ" as C4 <<control>> {
  {method} <U+002B> 音作りの値を当てる() : void
  {method} <U+002B> Toniqシンセで鳴らす() : void
}
class "再生" as C5 <<control>> {
  {method} <U+002B> 再生中の曲を止める() : void
  {method} <U+002B> 再生し直す() : void
}
class "アプリの状態" as E1 <<entity>> {
  {field} <U+002B> 音作りの値
  {field} <U+002B> メロディの音色
  {field} <U+002B> キー・スケール・BPM
  {method} <U+002B> 音作りの値を更新する() : void
  {method} <U+002B> メロディの音色をToniqシンセにする() : void
  {method} <U+002B> キー・スケール・BPM・音作りの値を取得する() : void
}
class "Toniqシンセプリセット" as E2 <<entity>> {
  {field} <U+002B> プリセット名
  {field} <U+002B> 音作りの値
  {method} <U+002B> プリセットの値を取得する() : void
}

B1 --> C1
B1 --> C2
C1 --> E2
C1 --> E1
C1 --> C3
C1 --> C5
C1 --> B1
C2 --> C5
C2 --> C3
C2 --> B1
C3 --> C4
C3 --> E1

@enduml
