@startuml
!include ../astah-state-style.puml
mainframe **stm** 全体_画面遷移図

state "メニュー画面" as S001
S001 : entry / モードと設定のカードを表示
S001 : exit / 終了（アプリを閉じる）

state "シンプルモード画面" as S002
S002 : entry / ジャンル・雰囲気・テンポを表示
S002 : do / 楽曲の設定
S002 : exit / メニューに戻る

state "シンプルモード生成後画面" as S006
S006 : entry / 生成結果を表示
S006 : do / 再生・差し替え・書き出し
S006 : exit / メニューに戻る

state "カスタムモード画面" as S003
S003 : entry / 設定タブを表示
S003 : do / 楽曲の要素の設定
S003 : exit / メニューに戻る

state "アレンジ画面" as S004
S004 : entry / アレンジャータブを表示
S004 : do / パートの配置・音量の調節
S004 : exit / メニューに戻る

state "ピアノロール画面" as S005
S005 : entry / ピアノロールタブを表示
S005 : do / メロディの入力・編集
S005 : exit / メニューに戻る

state "ミュージックリスト画面" as S009
S009 : entry / 保存した曲の一覧を表示
S009 : do / 曲の再生・管理
S009 : exit / メニューに戻る

state "音楽クイズ画面" as S010
S010 : entry / 問題を表示
S010 : do / 出題・採点
S010 : exit / メニューに戻る

state "設定画面" as S011
S011 : entry / 設定の一覧を表示
S011 : do / 見た目・音名・再生の設定
S011 : exit / メニューに戻る

[*] --> S001

S001 --> S002 : シンプルモード
S001 --> S003 : カスタムモード
S001 --> S009 : ミュージックリスト
S001 --> S010 : 音楽クイズ
S001 --> S011 : 設定

S002 --> S006 : 生成する
S006 --> S002 : 設定を変更
S006 --> S003 : カスタムモードで編集する

S002 --> S005 : ピアノロールタブ
S006 --> S005 : ピアノロールを開く
S005 --> S002 : 設定タブ\n[シンプルモード・生成前]
S005 --> S006 : 設定タブ\n[シンプルモード・生成後]

S003 --> S004 : アレンジャータブ
S004 --> S003 : 設定タブ
S003 --> S005 : ピアノロールタブ
S005 --> S003 : 設定タブ\n[カスタムモード]
S004 --> S005 : ピアノロールタブ
S005 --> S004 : アレンジャータブ\n[カスタムモード]

S009 --> S006 : 編集\n[シンプルモードの曲]
S009 --> S003 : 編集\n[カスタムモードの曲]
S009 --> S002 : シンプルモードでつくる\n[曲がないとき]
S009 --> S003 : カスタムモードでつくる\n[曲がないとき]

@enduml
