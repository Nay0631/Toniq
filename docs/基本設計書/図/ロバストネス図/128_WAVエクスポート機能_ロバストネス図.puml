@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 128_WAVエクスポート機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面\n（WAVで書き出すボタン）" as B1
boundary "カスタムモード画面\n（WAV ボタン）" as B2
control "再生を止める" as C1
control "ドラム音源を読み込む\n（ワンショット音源のとき）" as C2
control "曲全体をオフラインで鳴らす\n（ON のパートだけ）" as C3
control "16bit PCM の WAV に変換する" as C4
control "WAV ファイルを保存する" as C5
entity "ドラム音源\n（public/samples/drums）" as E1
entity "曲の状態\n（AppState）" as E2
entity "ミックスプリセット\n（mix_presets.json）" as E3
entity "WAV ファイル\n（toniq_ジャンル_….wav）" as E4

A1 --> B1
A1 --> B2
B1 --> C1
B2 --> C1
C1 --> C2
C2 --> E1
C2 --> C3
C3 --> E2
C3 --> E3
C3 --> C4
C4 --> C5
C5 --> E4

@enduml
