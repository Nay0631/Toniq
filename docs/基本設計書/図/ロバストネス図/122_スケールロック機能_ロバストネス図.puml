@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 122_スケールロック機能_ロバストネス図

actor "利用者" as A1
boundary "ピアノロール\n（スケールロックボタン）" as B1
boundary "ピアノロール\n（グリッド）" as B2
boundary "カスタムモード画面\n（スケールロックのスイッチ）" as B3
control "ピアノロールの\nスケールロックを切り替える" as C1
control "キーとスケールから\nスケールの7音を求める" as C2
control "スケール外の音は置かせない\n（動かしたらスケール音に寄せる）" as C3
control "コード進行の\nスケールロックを切り替える" as C4
control "コード進行の候補を\n同じスケールに絞る" as C5
entity "曲の状態\n（AppState）" as E1
entity "スケールの音\n（SCALE_TONES）" as E2
entity "コード進行DB\n（chord_progressions.json）" as E3

A1 --> B1
A1 --> B2
A1 --> B3
B1 --> C1
C1 --> E1
B2 --> C2
C2 --> E1
C2 --> E2
C2 --> C3
B3 --> C4
C4 --> E1
C4 --> C5
C5 --> E3

@enduml
