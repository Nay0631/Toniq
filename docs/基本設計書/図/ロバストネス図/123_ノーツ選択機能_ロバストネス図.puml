@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 123_ノーツ選択機能_ロバストネス図

actor "利用者" as A1
boundary "ピアノロール\n（音符のクリック・ドラッグ）" as B1
boundary "ピアノロール\n（右クリック・Delete キー）" as B2
control "音を選択して試聴する" as C1
control "位置・高さ・長さを変える\n（スケールロック中はスケール音に寄せる）" as C2
control "選んだ音を削除する" as C3
control "メロディを更新し\n「自分で入力」にする" as C4
control "再生中ならメロディだけ\n読み込み直す" as C5
entity "スケールの音\n（SCALE_TONES）" as E1
entity "曲の状態\n（AppState）" as E2
entity "再生\n（Tone.Transport）" as E3

A1 --> B1
A1 --> B2
B1 --> C1
C1 --> C2
C2 --> E1
C2 --> C4
B2 --> C3
C3 --> C4
C4 --> E2
C4 --> C5
C5 --> E3

@enduml
