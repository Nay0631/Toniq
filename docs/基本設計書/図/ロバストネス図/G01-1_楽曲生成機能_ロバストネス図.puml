@startuml
!include ../astah-robustness-style.puml
mainframe **uc** G01-1_楽曲生成機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面" as B1
boundary "確認ダイアログ" as B2
control "楽曲生成" as C1
control "再生" as C2
control "パターン選出" as C3
control "アレンジ管理" as C4
control "曲の構成" as C5
control "メロディ生成" as C6
control "拍子" as C7
control "履歴管理" as C8
control "コードの説明" as C9
control "設定画面に戻る" as C10
control "保存の確認" as C11
entity "シンプルモード表マスタ" as E1
entity "コード進行マスタ" as E2
entity "ドラムパターンマスタ" as E3
entity "標準アレンジマスタ" as E4
entity "メロディ設定マスタ" as E5
entity "アプリの状態" as E6
entity "ジャンルスケールマスタ" as E7
entity "楽曲データ" as E8

A1 --> B1 : 生成するボタンを押下する
B1 --> C1 : 楽曲を生成する
C1 --> C2 : 再生・クリック音を止める
C1 --> C7 : ジャンルの標準の拍子にし、\nオリジナルのドラムを置き直す
C7 --> E5 : 標準の拍子を取得する
C1 --> C3 : コード進行・ドラム・\nサビの進行を選ぶ
C3 --> E1 : ジャンル×雰囲気の\n候補を取得する
C3 --> E7 : ジャンルに合う\nスケールを取得する
C3 --> E2 : コード進行と同じ長さ・\nスケールのサビの進行を取得する
C3 --> E3 : ドラムパターンを取得する\n（オリジナルは残す）
C1 --> C4 : 全パートがそろう\n周回数を求める
C4 --> E4 : ジャンルの標準アレンジを取得する
C1 --> C5 : 自動生成なら Aメロと\nサビのメロディを作る
C5 --> C6 : メロディを作る\n（サビは高めの音域）
C6 --> E5 : 生成パラメータを取得する
C1 --> E6 : 曲の内容を更新し生成済みにする\n（構成は標準に、変えた所・\nセクションは空に、今の曲は未保存に）
C1 --> C8 : 元に戻すの履歴を捨てる
C1 --> C9 : キー・コード名の\n説明を作る
C1 --> B1 : 生成結果と\n残した内容を表示する
A1 --> B1 : 「雰囲気・ジャンル・\nテンポを変更」ボタンを\n押下する
B1 --> C10 : 設定画面に戻る
C10 --> B2 : 今の曲が置き換わる\nことを知らせる
A1 --> B2 : 戻り方を選ぶ
B2 --> C10 : 選んだ戻り方を渡す
C10 --> C11 : 「保存してから戻る」\nなら保存する
C11 --> E8 : 曲を保存する
C10 --> B1 : 設定画面（生成前）を\n表示する

@enduml
