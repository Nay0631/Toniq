@startuml
!include ../astah-robustness-style.puml
mainframe **uc** G01-1_楽曲生成機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面" as B1
boundary "アレンジ画面" as B2
boundary "ピアノロール画面" as B3
control "楽曲生成" as C1
control "再生" as C2
control "パターン選出" as C3
control "アレンジ管理" as C4
control "メロディ生成" as C5
control "メロディ再生成" as C6
entity "シンプルモード表マスタ" as E1
entity "コード進行マスタ" as E2
entity "ドラムパターンマスタ" as E3
entity "標準アレンジマスタ" as E4
entity "メロディ設定マスタ" as E5
entity "アプリの状態" as E6

A1 --> B1 : 生成するボタンを押下する
A1 --> B2 : メロディの差し替えボタンを押下する
B1 --> C1 : 楽曲を生成する
C1 --> C2 : 再生・クリック音を止める
C1 --> C3 : コード進行とドラムを選ぶ
C3 --> E1 : ジャンル×雰囲気の候補を取得する
C3 --> E2 : コード進行を取得する
C3 --> E3 : ドラムパターンを取得する
C1 --> C4 : 全パートがそろう周回数を求める
C4 --> E4 : ジャンルの標準アレンジを取得する
C1 --> C5 : 自動生成ならメロディを作る
C5 --> E5 : 生成パラメータを取得する
C1 --> E6 : 曲の内容を更新し生成済みにする
C1 --> B1 : 生成結果を表示する
B2 --> C6 : メロディを作り直す
C6 --> B3 : 「自分で入力」ならピアノロールを開く
C6 --> C5 : メロディを作る
C6 --> E6 : メロディを更新する
C6 --> C2 : 再生中なら再生し直す

@enduml
