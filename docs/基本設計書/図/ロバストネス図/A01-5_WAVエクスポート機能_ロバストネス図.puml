@startuml
!include ../astah-robustness-style.puml
mainframe **uc** A01-5_WAVエクスポート機能_ロバストネス図

control "出力ファイル保存" as C8
actor "利用者" as A1
boundary "シンプルモード画面" as B1
boundary "カスタムモード画面" as B2
boundary "ミュージックリスト画面" as B5
boundary "ファイル名ダイアログ" as B4
boundary "書き出しダイアログ" as B3
control "ファイル名入力" as C7
control "再生" as C1
control "ドラム音源読み込み" as C2
control "ミックス" as C3
control "grow" as C9
control "各パートの演奏" as C4
control "音声合成" as C5
control "音声変換" as C6
control "楽曲切り替え" as C11
control "保存の確認" as C12
entity "ドラム音源ファイル" as E1
entity "アプリの状態" as E2
entity "ミックス設定マスタ" as E3
entity "growプリセット" as E5
entity "WAVファイル" as E4
entity "楽曲データ" as E9

A1 --> B1 : WAVで書き出すボタンを押下する
A1 --> B2 : WAV ボタンを押下する
B1 --> C7 : ファイル名を聞く
B2 --> C7 : ファイル名を聞く
C7 --> B4 : 初期値のファイル名と\n注意書きで\nダイアログを表示する
A1 --> B4 : ファイル名・保存するかを\n選んで書き出すボタンを\n押下する
B4 --> C7 : ファイル名を確定する
C7 --> C12 : 「ミュージックリストにも\n保存する」なら\n先に保存する
C12 --> E9 : 曲を保存する
B1 --> C1 : WAV で書き出す（再生中なら止める）
B2 --> C1 : WAV で書き出す（再生中なら止める）
C1 --> B3 : 書き出しダイアログを開き、\n段階と進み具合（失敗したら\nメッセージ）を表示する
C1 --> C2 : サンプル音源なら読み込む
C2 --> E1 : ジャンルの音源を取得する
C1 --> C3 : ミックスをジャンルに合わせる
C3 --> E3 : ミックス設定を取得する
C1 --> C9 : grow の準備を待つ
C9 --> E5 : プリセットを取得する
C1 --> E2 : ON のパートと曲の内容を取得する
C1 --> C5 : 曲の長さ＋2秒の音声を区切りながら合成する
C5 --> C4 : 演奏の予定を組み立てる
C1 --> C6 : 16bit PCM の WAV に変換する
C1 --> C8 : 出力フォルダに保存する
C8 --> E4 : 保存する（同じ名前なら\n「 (2)」などを付ける）
C8 --> B1 : 保存した場所を表示し\nフォルダを開くか確認する
C8 --> B2 : 保存した場所を表示し\nフォルダを開くか確認する
A1 --> B1 : OK を押下する
A1 --> B2 : OK を押下する
B1 --> C8 : ファイルをフォルダで表示する
B2 --> C8 : ファイルをフォルダで表示する

A1 --> B5 : 曲のメニューの\n「WAV で書き出す」を押下する
B5 --> C11 : その曲を今の曲として\n読み込む
C11 --> E9 : 曲の内容を取得する
B5 --> C7 : ファイル名を聞く
B5 --> C1 : 決めたファイル名で\n書き出す
C8 --> B5 : 保存した場所を表示し\n書き出したファイルの\n一覧を読み直す
A1 --> B3 : 「中断する」を押下する\n（Esc キー）
B3 --> C1 : 書き出しを中断する

@enduml
