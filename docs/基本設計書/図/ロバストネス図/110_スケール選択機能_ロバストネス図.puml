@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 110_スケール選択機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面\n（スケールドロップダウン）" as B1
control "そのスケールのコード進行を選ぶ\n（同じ雰囲気を優先）" as C1
control "コード進行を更新する" as C2
control "自動生成のメロディを作り直す" as C3
control "再生中なら再生し直す" as C4
entity "コード進行DB\n（chord_progressions.json）" as E1
entity "曲の状態\n（AppState）" as E2
entity "再生\n（Tone.Transport）" as E3

A1 --> B1
B1 --> C1
C1 --> E1
C1 --> C2
C2 --> E2
C2 --> C3
C2 --> C4
C4 --> E3

@enduml
