@startuml
!include ../astah-robustness-style.puml
mainframe **uc** A01-4_MP3エクスポート機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面" as B1
boundary "カスタムモード画面" as B2
boundary "書き出しダイアログ" as B3
control "再生" as C1
control "ドラム音源読み込み" as C2
control "ミックス" as C3
control "各パートの演奏" as C4
control "音声合成" as C5
control "音声変換" as C6
entity "ドラム音源ファイル" as E1
entity "アプリの状態" as E2
entity "ミックス設定マスタ" as E3
entity "MP3ファイル" as E4

A1 --> B1 : MP3で書き出すボタンを押下する
A1 --> B2 : MP3 ボタンを押下する
B1 --> C1 : MP3 で書き出す（再生中なら止める）
B2 --> C1 : MP3 で書き出す（再生中なら止める）
C1 --> B3 : 書き出しダイアログを開き、段階と進み具合を表示する
C1 --> C2 : サンプル音源なら読み込む
C2 --> E1 : ジャンルの音源を取得する
C1 --> C3 : ミックスをジャンルに合わせる
C3 --> E3 : ミックス設定を取得する
C1 --> E2 : ON のパートと曲の内容を取得する
C1 --> C5 : 曲の長さ＋2秒の音声を区切りながら合成する
C5 --> C4 : 演奏の予定を組み立てる
C1 --> C6 : MP3（192kbps）に区切りながら変換する
C1 --> E4 : 保存する
C1 --> B3 : 失敗したらメッセージを表示する

@enduml
