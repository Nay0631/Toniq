@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 114_コード進行選択機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面\n（コード差し替えの再抽選）" as B1
boundary "カスタムモード画面\n（コード進行ドロップダウン・◀▶）" as B2
control "別のコード進行を再抽選する" as C1
control "選んだコード進行を取り出す" as C2
control "コード進行を更新する" as C3
control "自動生成のメロディを作り直す" as C4
control "再生中なら再生し直す" as C5
entity "シンプルモード表\n（easy_mode_table.json）" as E1
entity "コード進行DB\n（chord_progressions.json）" as E2
entity "曲の状態\n（AppState）" as E3
entity "再生\n（Tone.Transport）" as E4

A1 --> B1
A1 --> B2
B1 --> C1
B2 --> C2
C1 --> E1
C1 --> E2
C2 --> E2
C1 --> C3
C2 --> C3
C3 --> E3
C3 --> C4
C3 --> C5
C5 --> E4

@enduml
