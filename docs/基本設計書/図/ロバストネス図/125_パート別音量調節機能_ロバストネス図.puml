@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 125_パート別音量調節機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面\nミキサー（フェーダー）" as B1
control "パートの音量を更新する" as C1
control "0〜100 を dB に変換する" as C2
control "パートの音量ノードに反映する" as C3
entity "曲の状態\n（AppState）" as E1
entity "パートの音量ノード\n（Tone.Volume）" as E2

A1 --> B1
B1 --> C1
C1 --> E1
C1 --> C2
C2 --> C3
C3 --> E2

@enduml
