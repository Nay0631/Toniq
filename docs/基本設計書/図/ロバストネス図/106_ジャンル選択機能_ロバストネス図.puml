@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 106_ジャンル選択機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面\n（ジャンルのチップ）" as B1
boundary "カスタムモード画面\n（ジャンルのドロップダウン）" as B2
control "ジャンルのテンポを求める\n（テンポがプリセットのとき）" as C1
control "ジャンル・BPM・\nドラムのカテゴリを更新する" as C2
control "サンプル再生中なら\nそのジャンルのサンプルに切り替える" as C3
control "再生中なら再生し直す\n（ミックスをジャンルに合わせる）" as C4
entity "テンポプリセット\n（tempo_presets.json）" as E1
entity "曲の状態\n（AppState）" as E2
entity "ミックスプリセット\n（mix_presets.json）" as E3
entity "再生\n（Tone.Transport）" as E4

A1 --> B1
A1 --> B2
B1 --> C1
B2 --> C1
C1 --> E1
C1 --> C2
C2 --> E2
C2 --> C3
C2 --> C4
C3 --> E4
C4 --> E3
C4 --> E4

@enduml
