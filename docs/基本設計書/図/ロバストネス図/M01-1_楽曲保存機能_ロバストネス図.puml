@startuml
!include ../astah-robustness-style.puml
mainframe **uc** M01-1_楽曲保存機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面" as B1
boundary "カスタムモード画面" as B2
boundary "確認ダイアログ" as B3
boundary "メニュー画面" as B4
control "曲の管理" as C1
control "メニューに戻る確認" as C2
control "画面切り替え" as C3
entity "アプリの状態" as E1
entity "楽曲データ" as E2

A1 --> B1 : 保存ボタンを押下する\n（「保存・書き出し」の欄）
A1 --> B2 : 保存ボタンを押下する
B1 --> C1 : 今の曲を保存する
B2 --> C1 : 今の曲を保存する
C1 --> E1 : 曲の内容と今の曲（リストの曲か）を取得する
C1 --> E2 : リストの曲なら上書き、ほかは名前を付けて追加する
C1 --> E1 : 保存した曲を今の曲にする
C1 --> B1 : 「保存しました」、または保存容量の\n案内と保存し直すよう知らせる
C1 --> B2 : 「保存しました」、または保存容量の\n案内と保存し直すよう知らせる

A1 --> B2 : 「メニューに戻る」を押下する
B2 --> C2 : メニューに戻る
C2 --> B3 : 保存していない変更が\nあれば楽曲を保存するか\n聞く
A1 --> B3 : 保存して戻る・\n保存せずに戻るを選ぶ
B3 --> C2 : 選んだ戻り方を渡す
C2 --> C1 : 保存して戻るなら\n今の曲を保存する
C2 --> C3 : メニューに戻る
C3 --> B4 : メニュー画面を表示する

@enduml
