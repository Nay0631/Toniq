@startuml
!include ../astah-robustness-style.puml
mainframe **uc** D01-3_ドラム試聴機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面" as B1
control "再生" as C1
control "ドラム音源読み込み" as C2
control "ドラム演奏" as C3
control "ドラムキット作成" as C4
entity "ドラム音源ファイル" as E1
entity "アプリの状態" as E2

A1 --> B1 : ドラムの試聴ボタンを押下する
B1 --> C1 : ドラムを試聴する
C1 --> C1 : ほかの再生を止め、2小節で止める
C1 --> C2 : サンプル音源なら読み込む
C2 --> E1 : ジャンルの音源を取得する
C1 --> C3 : ドラムを読み込む
C3 --> E2 : ドラムパターンを取得する
C3 --> C4 : ジャンルのドラムキットを作る

@enduml
