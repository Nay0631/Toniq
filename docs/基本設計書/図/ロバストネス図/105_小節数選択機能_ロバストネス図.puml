@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 105_小節数選択機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面\n（小節数ドロップダウン）" as B1
control "小節数を更新する" as C1
control "再生中なら先頭から\n再生し直す" as C2
control "小節数で自動停止する\n（ループ再生なら先頭へ戻る）" as C3
entity "曲の状態\n（AppState）" as E1
entity "再生\n（Tone.Transport）" as E2

A1 --> B1
B1 --> C1
C1 --> E1
C1 --> C2
C2 --> C3
C3 --> E2

@enduml
