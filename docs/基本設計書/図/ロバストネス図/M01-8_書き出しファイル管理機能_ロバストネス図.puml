@startuml
!include ../astah-robustness-style.puml
mainframe **uc** M01-8_書き出しファイル管理機能_ロバストネス図

actor "利用者" as A1
boundary "書き出したファイル一覧" as B2
control "ファイルの絞り込み" as C1
control "ファイルの試聴" as C2
control "ごみ箱へ移す" as C3
control "出力ファイル保存" as C4
control "再生" as C5
entity "アプリの状態" as E1
entity "WAVファイル" as E2
entity "MP3ファイル" as E3
entity "MIDIファイル" as E4
boundary "ミュージックリスト画面" as B1

A1 --> B1 : 「書き出したファイル」に\n切り替える
A1 --> B2 : 種類・並び順・\n「更新」を押下する
A1 --> B2 : 再生ボタンを押下する
A1 --> B2 : 「場所を開く」・\nごみ箱へ移すボタンを\n押下する
B1 --> C1 : 表示を切り替える
B2 --> C1 : 絞り込みの条件を変える
B2 --> C2 : ファイルを聴く・止める
B2 --> C3 : ファイルをごみ箱へ移す
B2 --> C4 : ファイルを\nエクスプローラーで表示する
C1 --> E1 : 表示・種類・\n並び順を更新する
C1 --> C4 : 書き出したファイルの\n一覧を読む
C4 --> E2 : 読む・ごみ箱へ移す
C4 --> E3 : 読む・ごみ箱へ移す
C4 --> E4 : 読む・ごみ箱へ移す
C1 --> B2 : 一覧と種類ごとの\nファイル数を表示する
C2 --> C5 : 曲の再生を止める
C2 --> C4 : WAV・MP3 を読み込む
C2 --> B2 : 再生位置と長さを\n表示する
C3 --> C4 : ごみ箱へ移す
C3 --> C1 : 一覧を読み直す
C3 --> B2 : 移せなかったことを\n知らせる

@enduml
