@startuml
!include ../astah-robustness-style.puml
mainframe **uc** M01-9_作業ファイル保存機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面" as B1
boundary "カスタムモード画面" as B2
control "作業ファイル保存" as C1
control "曲の管理" as C2
control "出力ファイル保存" as C3
entity "アプリの状態" as E1
entity "作業ファイル" as E2

A1 --> B1 : 作業ファイルボタンを押下する
A1 --> B2 : 作業ファイルボタンを押下する
B1 --> C1 : 今の曲を作業ファイルに保存する
B2 --> C1 : 今の曲を作業ファイルに保存する
C1 --> E1 : 曲の内容・曲名・前回の保存先を取得する
C1 --> C2 : 曲ファイルの形式にする
C1 --> C3 : 保存先を選ばせて保存する（前回の\n保存先か output/projects から）
C3 --> E2 : 保存する
C1 --> C1 : 保存先のダイアログで\n取り消した（保存しない）
C1 --> E1 : 保存した場所を更新する
C1 --> B1 : 「保存しました」と保存した場所\n（失敗したら理由）を表示する
C1 --> B2 : 「保存しました」と保存した場所\n（失敗したら理由）を表示する

@enduml
