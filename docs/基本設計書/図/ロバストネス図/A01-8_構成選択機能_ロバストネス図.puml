@startuml
!include ../astah-robustness-style.puml
mainframe **uc** A01-8_構成選択機能_ロバストネス図

actor "利用者" as A1
boundary "アレンジ画面" as B1
control "構成選択" as C1
control "アレンジ管理" as C2
control "再生" as C3
entity "アプリの状態" as E1
entity "構成プリセットマスタ" as E2
entity "標準アレンジマスタ" as E3

A1 --> B1 : 構成を選ぶ
B1 --> C1 : 構成を設定する
C1 --> E1 : 構成のプリセットを更新する
C1 --> C2 : アレンジを組み直し、\n変えた所を当て直す
C2 --> E3 : ジャンルの標準アレンジを\n取得する
C2 --> E2 : 構成のプリセットの\n変形を取得する
C1 --> C3 : 再生中なら再生し直す
C1 --> B1 : タイムライン・セクションの行・\n構成の表示を出す

@enduml
