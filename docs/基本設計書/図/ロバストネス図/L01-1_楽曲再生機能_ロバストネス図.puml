@startuml
!include ../astah-robustness-style.puml
mainframe **uc** L01-1_楽曲再生機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面" as B2
boundary "ミュージックリスト画面" as B3
control "スペースキー" as C7
control "楽曲切り替え" as C1
control "曲の管理" as C2
control "再生" as C3
control "grow" as C6
control "各パートの演奏" as C4
control "アレンジ管理" as C5
control "ファイルの試聴" as C8
control "画面切り替え" as C9
entity "楽曲データ" as E1
entity "アプリの状態" as E2
entity "growプリセット" as E3
boundary "シンプルモード画面" as B1

A1 --> B1 : 再生ボタン・\nスペースキーを押下する
A1 --> B2 : 再生ボタン・\nスペースキーを押下する
A1 --> B3 : 曲の再生ボタンを押下する
B1 --> C7 : 再生／停止を切り替える
B2 --> C7 : 再生／停止を切り替える
C7 --> C3 : 再生する（アレンジャーは\n再生開始位置から）・止める
B1 --> C3 : 再生する
B2 --> C3 : 再生する
B3 --> C1 : 選んだ曲を今の曲にする
C1 --> C8 : 書き出したファイルを\n聴いていたら止める
C1 --> C2 : 保存した曲を読み込む
C2 --> E1 : 曲の内容を取得する
C2 --> E2 : 曲の内容を反映する
C1 --> C3 : 再生する
C3 --> E2 : 曲の内容を取得する
C3 --> C6 : grow の準備を待つ
C6 --> E3 : プリセットを取得する
C3 --> C4 : ON のパートを読み込む\n（最後の小節は\n主和音で終わる）
C3 --> C5 : 周回を数え、くり返す\n範囲と止める時刻を決める
C3 --> B3 : 再生位置を表示する
C3 --> B2 : 停止ボタンを出す・\n再生できなかったら\n知らせる
A1 --> B2 : ほかの画面へ移る
B2 --> C9 : 画面を切り替える
C9 --> C3 : 再生を止める

@enduml
