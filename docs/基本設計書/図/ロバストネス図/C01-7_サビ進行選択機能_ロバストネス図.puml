@startuml
!include ../astah-robustness-style.puml
mainframe **uc** C01-7_サビ進行選択機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面" as B1
control "サビ進行設定" as C1
control "パターン選出" as C2
control "曲の構成" as C3
control "メロディ生成" as C4
control "再生" as C5
entity "コード進行マスタ" as E1
entity "アプリの状態" as E2
entity "メロディ設定マスタ" as E3

A1 --> B1 : サビのドロップダウンで進行を選ぶ
A1 --> B1 : サビの差し替えボタンを押下する
B1 --> C1 : サビの進行を切り替える・差し替える
C1 --> E2 : コード進行・ジャンル・雰囲気を取得する
C1 --> C2 : 今のサビ以外から選ぶ（差し替えのとき）
C2 --> E1 : 同じ長さ・スケールの候補を取得する
C1 --> E1 : 選んだコード進行を取得する
C1 --> C1 : 候補がない\n（差し替えない）
C1 --> E2 : サビの進行を更新する（なしなら空にする）
C1 --> C3 : メロディがあればサビのメロディだけ作り直す
C3 --> C4 : 高めの音域でメロディを作る
C4 --> E3 : 生成パラメータを取得する
C1 --> E2 : サビのメロディを更新する
C1 --> C5 : 再生中なら再生し直す
C1 --> B1 : サビの進行を表示する

@enduml
