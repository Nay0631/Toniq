@startuml
!include ../astah-robustness-style.puml
mainframe **uc** C01-7_サビ進行選択機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面" as B1
control "サビ進行設定" as C1
control "曲の構成" as C3
control "メロディ生成" as C4
control "再生" as C5
entity "コード進行マスタ" as E1
entity "アプリの状態" as E2
entity "メロディ設定マスタ" as E3

A1 --> B1 : サビのドロップダウン・\n◀▶で進行を選ぶ
B1 --> C1 : サビの進行を切り替える
C1 --> E2 : コード進行・ジャンル・\n雰囲気を取得する
C1 --> E1 : 同じ長さ・スケールの\n候補を取得する
C1 --> E2 : サビの進行を更新する\n（なしなら空にする）
C1 --> C3 : メロディがあれば\nサビのメロディだけ作り直す
C3 --> C4 : 高めの音域で\nメロディを作る
C4 --> E3 : 生成パラメータを取得する
C1 --> C5 : 再生中なら再生し直す
C1 --> B1 : サビの進行を表示する

@enduml
