@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 104_BPM試聴機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面\n（クリックで試聴ボタン）" as B1
boundary "カスタムモード画面\n（試聴ボタン）" as B2
control "曲の再生を止める" as C1
control "クリック音を鳴らす／止める" as C2
control "拍ごとにBPMを読んで\n次のクリックを予約する" as C3
entity "再生\n（Tone.Transport）" as E1
entity "曲の状態\n（AppState）" as E2
entity "クリック音用の音声\n（AudioContext）" as E3

A1 --> B1
A1 --> B2
B1 --> C1
B2 --> C1
C1 --> E1
B1 --> C2
B2 --> C2
C2 --> C3
C3 --> E2
C3 --> E3

@enduml
