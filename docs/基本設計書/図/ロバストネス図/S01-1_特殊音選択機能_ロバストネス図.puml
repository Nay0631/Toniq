@startuml
!include ../astah-robustness-style.puml
mainframe **uc** S01-1_特殊音選択機能_ロバストネス図

actor "利用者" as A1
boundary "もっと調整" as B2
boundary "カスタムモード画面" as B1
boundary "アレンジ画面" as B3
control "追加パート設定" as C5
control "パート管理" as C1
control "各パートの演奏" as C2
control "FX設定" as C3
control "再生" as C4
control "画面切り替え" as C6
entity "アプリの状態" as E1
entity "ベース設定マスタ" as E2

A1 --> B2 : 追加パートを使う\nボタンを押下する
A1 --> B2 : サブベースを選ぶ
A1 --> B2 : アレンジャーで →\nを押下する
A1 --> B1 : FX / SE の種類を選ぶ・\n試聴する
B2 --> C5 : 追加パートをまとめて\nON/OFF する
B2 --> C5 : サブベースを設定する
B2 --> C6 : アレンジャータブを開く
C6 --> B3 : アレンジャーを表示する
C5 --> C1 : 5つの追加パートを\nON/OFF する
C1 --> E1 : パートの ON/OFF を更新する
C1 --> C2 : OFF なら音源を破棄する・\n再生中に ON ならすぐ読み込む
C5 --> E2 : ジャンルのサブベースの\n標準を取得する
C5 --> E1 : サブベースを更新する
C5 --> C4 : サブベースは\n再生中なら再生し直す
C5 --> B2 : ON のパートの名前と\n変更の数を表示する
B1 --> C3 : FX / SE の種類を設定する
C3 --> E1 : FX / SE の種類を更新する
C3 --> C4 : 再生中なら再生し直す
B1 --> C4 : FX / SE を試聴する

@enduml
