@startuml
!include ../astah-robustness-style.puml
mainframe **uc** D01-4_ドラムパターン入力機能_ロバストネス図

actor "利用者" as A1
boundary "ドラムロール" as B1
control "ドラム編集" as C1
control "ドラム演奏" as C2
entity "アプリの状態" as E1
entity "ドラムパターンマスタ" as E2

A1 --> B1 : マスをクリック・ドラッグ・\n右クリックする
A1 --> B1 : 長さ・強さを選ぶ
A1 --> B1 : パターンを読み込む・\nクリアを押下する
A1 --> B1 : 行の見出しを押下する
B1 --> C1 : ドラムを編集する
B1 --> C2 : その音を試聴する
C1 --> E2 : 読み込むパターンを取得する
C1 --> C1 : 作ったドラムを置き換える・\n消す確認で取り消した\n（何もしない）
C1 --> E1 : オリジナルのドラムと\n置く強さを更新する
C1 --> C2 : 再生中なら次の音から\nすぐ反映する
C1 --> B1 : 置いた音と注意を表示する

@enduml
