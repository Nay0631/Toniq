@startuml
!include ../astah-robustness-style.puml
mainframe **uc** B01-10_grow音作り機能_ロバストネス図

actor "利用者" as A1
boundary "growパネル" as B1
control "音作り設定" as C1
control "音色試聴" as C2
control "grow" as C3
entity "アプリの状態" as E1
entity "growプリセット" as E2

A1 --> B1 : 対象を選ぶ・\nプリセットのボタンを押下する
A1 --> B1 : つまみ・ドロップダウン・\nチェックボックスを動かす
A1 --> B1 : プリセットに戻す・すべてを\n標準に戻すボタンを押下する
A1 --> B1 : 試し弾きのキーを押す
B1 --> C1 : 音作りの値を設定する
B1 --> C2 : 押している間だけ\n対象のパートの音で鳴らす
C1 --> E2 : パートに合うカテゴリの\nプリセットを取得する
C1 --> E1 : 対象のパートの\n音作りの値を更新する
C1 --> C2 : プリセットを選んだら\n停止中なら主音を1音鳴らす
C2 --> C3 : 今の音色で鳴らす
C1 --> C3 : 鳴っている grow に\nすぐ反映する
C1 --> B1 : ボタン・つまみの値と\n変更を表示する

@enduml
