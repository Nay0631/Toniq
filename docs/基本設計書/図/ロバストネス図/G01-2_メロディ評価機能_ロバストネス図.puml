@startuml
!include ../astah-robustness-style.puml
mainframe **uc** G01-2_メロディ評価機能_ロバストネス図

actor "利用者" as A1
boundary "メロディの評価画面" as B1
control "評価" as C1
control "一括計測" as C2
control "再生" as C3
control "評価の管理" as C4
control "自動チェック" as C5
entity "シンプルモード表マスタ" as E1
entity "コード進行マスタ" as E2
entity "ドラムパターンマスタ" as E3
entity "メロディ設定マスタ" as E4
entity "アプリの状態" as E5
entity "メロディの評価データ" as E6
entity "評価ファイル" as E7

A1 --> B1 : 条件名・シード・\n絞り込みを選ぶ
A1 --> B1 : 曲を切り替える・\n再生する
A1 --> B1 : 点数・タグ・メモを付ける
A1 --> B1 : 書き出す・読み込む・\n消すを押下する
B1 --> C1 : 評価する曲を\n作って聴く・採点する
C1 --> C2 : 一括計測と同じ\nシードで曲を作る
C2 --> E1 : ジャンル×雰囲気の\n候補を取得する
C2 --> E2 : コード進行を取得する
C2 --> E3 : ドラムパターンを取得する
C2 --> E4 : 生成パラメータを取得する
C1 --> E5 : 曲の内容を差し替え、\n離れたら元に戻す
B1 --> C3 : 鳴らすパートで再生する\n（サビから）
C1 --> C5 : 点数を付けたら\n結果を求める
C1 --> C4 : 評価を保存・集計する
B1 --> C4 : 評価を書き出す・\n読み込む・消す
C4 --> C4 : 消す確認で取り消した・\n保存できない\n（知らせる）
C4 --> E6 : 評価を保存・取得する
C4 --> E7 : CSV・JSON に書き出す・\nJSON を読み込む
C1 --> B1 : 曲の内容・結果の表・\n同じ曲どうしの差を表示する

@enduml
