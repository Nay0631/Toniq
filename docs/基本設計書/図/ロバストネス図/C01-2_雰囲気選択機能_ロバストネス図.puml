@startuml
!include ../astah-robustness-style.puml
mainframe **uc** C01-2_雰囲気選択機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面" as B1
control "雰囲気選択" as C1
control "パターン選出" as C2
control "ジャンル試聴" as C3
entity "アプリの状態" as E1
entity "テンポマスタ" as E2

A1 --> B1 : 雰囲気のチップを押下する
B1 --> C1 : 雰囲気を選択する
C1 --> E1 : 雰囲気（ジャンルが合わなければ\n合うジャンルの先頭・BPMも）を更新する
C1 --> C2 : ジャンルが変わり、テンポが\nプリセットならBPMを求める
C2 --> E2 : BPMを取得する
C1 --> C3 : ジャンルが変わり、サンプル再生中なら\n新しいジャンルで鳴らし直す
C1 --> B1 : 選択中の雰囲気と\n雰囲気に合うジャンルのチップを表示する

@enduml
