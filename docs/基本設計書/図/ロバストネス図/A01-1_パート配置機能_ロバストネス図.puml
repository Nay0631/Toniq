@startuml
!include ../astah-robustness-style.puml
mainframe **uc** A01-1_パート配置機能_ロバストネス図

actor "利用者" as A1
boundary "アレンジ画面" as B1
control "ブロック編集" as C1
control "アレンジ管理" as C2
control "パート管理" as C3
control "各パートの演奏" as C4
entity "アプリの状態" as E1
entity "標準アレンジマスタ" as E2
entity "構成プリセットマスタ" as E3

A1 --> B1 : タイムラインを押下・\nドラッグ・右クリックする
A1 --> B1 : ドラム・FX のブロックの\nパターン・種類を選ぶ
A1 --> B1 : 変えた所を消す\nボタンを押下する
B1 --> C1 : ブロックを置く・動かす・\n削除する
C1 --> C2 : 今のアレンジを組み立て、\nセクションごとに\nプリセットと比べる
C2 --> E2 : ジャンルの標準アレンジを\n取得する
C2 --> E3 : 構成のプリセットを取得する
C2 --> E1 : 構成・変えた所・\n小節数を取得する
C1 --> E1 : 変えた所を更新する\n（消すならセクションも空にする）
C1 --> C3 : OFF のパートに\n置いたら ON にする
C1 --> B1 : タイムラインと\n変更の数を表示する
C4 --> C2 : 再生中、発音のたびに\n鳴らす小節か確かめる

@enduml
