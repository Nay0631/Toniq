@startuml
!include ../astah-robustness-style.puml
mainframe **uc** A01-1_パート配置機能_ロバストネス図

actor "利用者" as A1
boundary "アレンジ画面" as B1
control "ブロック編集" as C1
control "アレンジ管理" as C2
control "パート管理" as C3
control "各パートの演奏" as C4
entity "アプリの状態" as E1
entity "標準アレンジマスタ" as E2

A1 --> B1 : タイムラインを押下・ドラッグ・右クリックする
A1 --> B1 : 標準に戻すボタンを押下する
B1 --> C1 : ブロックを置く・動かす・削除する
C1 --> C2 : 今のアレンジを取得する
C2 --> E1 : アレンジ・ジャンル・小節数を取得する
C2 --> E2 : 編集していなければジャンルの標準アレンジを取得する
C1 --> C1 : 置ける空きがない（置かない）
C1 --> E1 : アレンジを更新する（標準に戻すなら空にする）
C1 --> C3 : OFF のパートに置いたら ON にする
C1 --> B1 : タイムラインを表示する
C4 --> C2 : 再生中、発音のたびに鳴らす小節か確かめる

@enduml
