@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 124_パート配置機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面\nアレンジャータブ（タイムライン）" as B1
control "ブロックを置く\n（その小節を含む周回1周分）" as C1
control "ブロックを移動・\n長さ変更する" as C2
control "ブロックを削除する" as C3
control "前後のブロックとの\n空き範囲を求める" as C4
control "アレンジを更新する" as C5
control "OFF のパートに置いたら\nON にする" as C6
control "再生中は小節ごとに\n鳴らすかを判定する" as C7
entity "曲の状態\n（AppState）" as E1
entity "再生\n（Tone.Transport）" as E2

A1 --> B1
B1 --> C1
B1 --> C2
B1 --> C3
C1 --> C4
C2 --> C4
C4 --> C5
C3 --> C5
C5 --> E1
C1 --> C6
C6 --> E1
C5 --> C7
C7 --> E2

@enduml
