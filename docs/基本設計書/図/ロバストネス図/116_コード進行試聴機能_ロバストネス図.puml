@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 116_コード進行試聴機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面\n（コード進行の試聴ボタン）" as B1
control "ほかの再生・クリック音を止める" as C1
control "コードを読み込む\n（アレンジの判定を外す）" as C2
control "ディグリーを実音に変換し\nボイシングを決める" as C3
control "進行1周分だけ鳴らす" as C4
entity "曲の状態\n（AppState）" as E1
entity "コード進行DB\n（chord_progressions.json）" as E2
entity "再生\n（Tone.Transport）" as E3

A1 --> B1
B1 --> C1
C1 --> C2
C2 --> E1
C2 --> C3
C3 --> E2
C3 --> C4
C4 --> E3

@enduml
