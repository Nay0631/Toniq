@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 117_ドラムカテゴリ選択機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面\n（ドラムのカテゴリドロップダウン）" as B1
control "ドラムのカテゴリを更新する" as C1
control "カテゴリで\nドラムパターンの候補を絞る" as C2
control "候補になければ\n先頭のパターンに切り替える" as C3
control "再生中なら再生し直す" as C4
entity "曲の状態\n（AppState）" as E1
entity "ドラムパターンDB\n（drum_patterns.json）" as E2
entity "再生\n（Tone.Transport）" as E3

A1 --> B1
B1 --> C1
C1 --> E1
C1 --> C2
C2 --> E2
C2 --> C3
C3 --> E1
C3 --> C4
C4 --> E3

@enduml
