@startuml
!include ../astah-robustness-style.puml
mainframe **uc** A01-3_MIDIエクスポート機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面" as B2
boundary "ミュージックリスト画面" as B5
boundary "ファイル名ダイアログ" as B3
control "ファイル名入力" as C6
control "曲の構成" as C2
control "アレンジ管理" as C3
control "コード変換" as C4
control "各パートの演奏" as C5
control "出力ファイル保存" as C7
control "楽曲切り替え" as C11
control "保存の確認" as C12
control "拍子" as C8
control "グルーヴ" as C13
entity "アプリの状態" as E1
entity "標準アレンジマスタ" as E2
entity "スケールマスタ" as E3
entity "ドラムパターンマスタ" as E4
entity "ベース設定マスタ" as E5
entity "アルペジオ設定マスタ" as E6
entity "MIDIファイル" as E7
entity "楽曲データ" as E9
entity "構成プリセットマスタ" as E8
boundary "シンプルモード画面" as B1
control "MIDI書き出し" as C1

A1 --> B1 : MIDIで書き出すボタンを押下する
A1 --> B2 : MIDI ボタンを押下する
B1 --> C6 : ファイル名を聞く
B2 --> C6 : ファイル名を聞く
C6 --> B3 : 初期値のファイル名と\n注意書きで\nダイアログを表示する
A1 --> B3 : ファイル名・保存するかを\n選んで書き出すボタンを\n押下する
B3 --> C6 : ファイル名を確定する
C6 --> C12 : 「ミュージックリストにも\n保存する」なら\n先に保存する
C12 --> E9 : 曲を保存する
B1 --> C1 : 決めたファイル名で MIDI で書き出す
B2 --> C1 : 決めたファイル名で MIDI で書き出す
C1 --> E1 : キー・BPM・拍子・小節数・\nパートの ON/OFF・\nスウィングを取得する
C1 --> C2 : 曲全体のコード進行と\nメロディを求める\n（セクション・転調・\nエンディング込み）
C2 --> E2 : 標準のセクションを\n取得する
C1 --> C3 : 小節ごとに鳴らすか確かめる
C3 --> E2 : 標準アレンジを取得する
C3 --> E8 : 構成のプリセットを\n取得する
C1 --> C4 : コード・パッドのボイシングを求める
C4 --> E3 : スケールの音程を取得する
C1 --> C5 : コード・パッド・アルペジオ・\nベース・カウンターメロディ・\nドラム・パーカッションの音を並べる
C5 --> E4 : ブロックのドラムパターンを\n取得する（オリジナルは\nアプリの状態から）
C5 --> E5 : ジャンルのベースのパターンを取得する
C5 --> E6 : ジャンルのアルペジオの設定を取得する
C1 --> C13 : 発音位置を\nスウィングでずらす
C1 --> C8 : 拍子と3連符の\n位置を求める
C1 --> C7 : 8トラックを書いたファイルを\n出力フォルダに保存する
C7 --> E7 : 保存する（同じ名前なら\n「 (2)」などを付ける）
C7 --> B1 : 保存した場所を表示し\nフォルダを開くか確認する
C7 --> B2 : 保存した場所を表示し\nフォルダを開くか確認する
A1 --> B1 : OK を押下する
A1 --> B2 : OK を押下する
B1 --> C7 : ファイルをフォルダで表示する
B2 --> C7 : ファイルをフォルダで表示する

A1 --> B5 : 曲のメニューの\n「MIDI で書き出す」を押下する
B5 --> C11 : その曲を今の曲として\n読み込む
C11 --> E9 : 曲の内容を取得する
B5 --> C6 : ファイル名を聞く
B5 --> C1 : 決めたファイル名で\n書き出す
C7 --> B5 : 保存した場所を表示し\n書き出したファイルの\n一覧を読み直す

@enduml
