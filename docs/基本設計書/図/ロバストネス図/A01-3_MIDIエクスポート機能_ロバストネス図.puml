@startuml
!include ../astah-robustness-style.puml
mainframe **uc** A01-3_MIDIエクスポート機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面" as B1
boundary "カスタムモード画面" as B2
control "MIDI書き出し" as C1
control "曲の構成" as C2
control "アレンジ管理" as C3
control "コード変換" as C4
control "各パートの演奏" as C5
entity "アプリの状態" as E1
entity "標準アレンジマスタ" as E2
entity "スケールマスタ" as E3
entity "ドラムパターンマスタ" as E4
entity "ベース設定マスタ" as E5
entity "アルペジオ設定マスタ" as E6
entity "MIDIファイル" as E7

A1 --> B1 : MIDIで書き出すボタンを押下する
A1 --> B2 : MIDI ボタンを押下する
B1 --> C1 : MIDI で書き出す
B2 --> C1 : MIDI で書き出す
C1 --> E1 : キー・BPM・小節数・パートの ON/OFF・スウィングを取得する
C1 --> C2 : 曲全体のコード進行とメロディを求める（セクション・エンディング込み）
C2 --> E2 : セクションを編集していなければ標準のセクションを取得する
C1 --> C3 : 小節ごとに鳴らすか確かめる
C3 --> E2 : アレンジを編集していなければ標準アレンジを取得する
C1 --> C4 : コード・パッドのボイシングを求める
C4 --> E3 : スケールの音程を取得する
C1 --> C5 : コード・パッド・アルペジオ・ベース・ドラムの音を並べる
C5 --> E4 : ブロックのドラムパターンを取得する
C5 --> E5 : ジャンルのベースのパターンを取得する
C5 --> E6 : ジャンルのアルペジオの設定を取得する
C1 --> C1 : スウィングに\n合わせて発音位置をずらす
C1 --> E7 : 6トラックを書いて保存する

@enduml
