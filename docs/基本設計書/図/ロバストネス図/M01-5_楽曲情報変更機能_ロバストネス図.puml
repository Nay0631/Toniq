@startuml
!include ../astah-robustness-style.puml
mainframe **uc** M01-5_楽曲情報変更機能_ロバストネス図

actor "利用者" as A1
boundary "ミュージックリスト画面" as B1
control "曲の管理" as C1
entity "楽曲データ" as E1

A1 --> B1 : 曲名を入力して Enter を押す
A1 --> B1 : ☆ ボタンを押下する
B1 --> C1 : 曲名を変える
B1 --> C1 : お気に入りを切り替える
C1 --> C1 : 曲名が空（変えない）
C1 --> E1 : 曲名・お気に入りを更新する
C1 --> B1 : 曲の一覧を表示し直す

@enduml
