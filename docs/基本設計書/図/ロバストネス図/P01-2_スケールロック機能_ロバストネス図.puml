@startuml
!include ../astah-robustness-style.puml
mainframe **uc** P01-2_スケールロック機能_ロバストネス図

actor "利用者" as A1
boundary "ピアノロール画面" as B1
boundary "カスタムモード画面" as B2
control "スケールロック設定" as C1
control "音符編集" as C2
control "スケール判定" as C3
entity "アプリの状態" as E1
entity "スケールマスタ" as E2
entity "コード進行マスタ" as E3

A1 --> B1 : スケールロックボタンを押下する
A1 --> B1 : 音を置く・動かす
A1 --> B2 : スケールロックのスイッチを押下する
B1 --> C1 : ピアノロールのロックを切り替える
B2 --> C1 : コード進行のロックを切り替える
C1 --> E1 : スケールロックを更新する
B1 --> C2 : 音を置く・動かす
C2 --> C3 : スケールの音か確かめる
C3 --> E1 : キーとスケールを取得する
C3 --> E2 : スケールの7音を取得する
C2 --> C2 : スケール外（置かない・スケール音に寄せる）
C1 --> E3 : 同じスケールのコード進行に絞る
C1 --> B2 : 絞ったコード進行の一覧を表示する

@enduml
