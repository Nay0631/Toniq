@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 107_ジャンル試聴機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面\n（サンプルを聴くボタン）" as B1
control "ジャンル・雰囲気から\nコード進行・ドラムを選ぶ" as C1
control "メロディを自動生成する" as C2
control "サンプルを鳴らす\n（全パート・1周分）" as C3
control "曲の内容を一時的に差し替え、\n止めたら元に戻す" as C4
entity "シンプルモード表\n（easy_mode_table.json）" as E1
entity "コード進行DB\n（chord_progressions.json）" as E2
entity "ドラムパターンDB\n（drum_patterns.json）" as E3
entity "メロディ生成パラメータ\n（melody_params.json）" as E4
entity "曲の状態\n（AppState）" as E5
entity "再生\n（Tone.Transport）" as E6

A1 --> B1
B1 --> C1
C1 --> E1
C1 --> E2
C1 --> E3
C1 --> C2
C2 --> E4
C2 --> C3
C3 --> C4
C4 --> E5
C3 --> E6

@enduml
