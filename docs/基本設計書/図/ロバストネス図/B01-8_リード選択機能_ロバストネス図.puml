@startuml
!include ../astah-robustness-style.puml
mainframe **uc** B01-8_リード選択機能_ロバストネス図

actor "利用者" as A1
boundary "growパネル" as B1
control "音色設定" as C1
control "音色試聴" as C2
control "grow" as C3
entity "アプリの状態" as E1
entity "growプリセット" as E2

A1 --> B1 : 対象がメロディのとき\nプリセットのボタンを押下する
B1 --> C1 : メロディの音色を設定する
C1 --> E2 : プリセット（ジャンルの標準）を\n取得する
C1 --> E1 : メロディの音色を更新し、\n変えた値を捨てる
C1 --> C2 : 停止中なら主音を1音鳴らす
C2 --> C3 : 選んだ音色で鳴らす
C1 --> C3 : 再生中なら鳴っている\nメロディにすぐ反映する
C1 --> B1 : 選んでいるボタンを表示する

@enduml
