@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 118_ドラムパターン選択機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面\n（ドラム差し替えの再抽選）" as B1
boundary "カスタムモード画面\n（ドラムパターンドロップダウン・◀▶）" as B2
control "別のドラムパターンを再抽選する" as C1
control "選んだドラムパターンを取り出す" as C2
control "ドラムパターンを更新する" as C3
control "再生中なら再生し直す" as C4
entity "シンプルモード表\n（easy_mode_table.json）" as E1
entity "ドラムパターンDB\n（drum_patterns.json）" as E2
entity "曲の状態\n（AppState）" as E3
entity "再生\n（Tone.Transport）" as E4

A1 --> B1
A1 --> B2
B1 --> C1
B2 --> C2
C1 --> E1
C1 --> E2
C2 --> E2
C1 --> C3
C2 --> C3
C3 --> E3
C3 --> C4
C4 --> E4

@enduml
