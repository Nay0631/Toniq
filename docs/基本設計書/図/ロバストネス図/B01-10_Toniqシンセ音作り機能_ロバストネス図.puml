@startuml
!include ../astah-robustness-style.puml
mainframe **uc** B01-10_Toniqシンセ音作り機能_ロバストネス図

actor "利用者" as A1
boundary "Toniqシンセパネル" as B1
control "音作り設定" as C1
control "Toniqシンセ試聴の切り替え" as C2
control "メロディ演奏" as C3
control "Toniqシンセ" as C4
control "再生" as C5
entity "アプリの状態" as E1
entity "Toniqシンセプリセット" as E2

A1 --> B1 : プリセットを選ぶ・ノブやセレクトを動かす
A1 --> B1 : 試聴ボタンを押下する
A1 --> B1 : メロディに使うボタンを押下する
B1 --> C1 : 音作りの値を設定する
C1 --> E2 : プリセットの値を取得する
C1 --> E1 : 音作りの値を更新する
C1 --> C3 : 鳴っているメロディ・試聴の音にすぐ反映する
C3 --> C4 : 音作りの値を当てる
C1 --> B1 : ノブの値とプリセット名（一致しなければカスタム）を表示する
B1 --> C2 : 試聴を切り替える
C2 --> C5 : 再生中の曲を止める
C2 --> C3 : 今のキー・スケールのフレーズを鳴らす（鳴っていれば止める）
C3 --> E1 : キー・スケール・BPM・音作りの値を取得する
C3 --> C4 : Toniqシンセで鳴らす
C2 --> B1 : ボタンの表示（■ 停止／▷ 試聴）を変える
B1 --> C1 : メロディに使う
C1 --> C1 : すでに Toniqシンセを使っている（ボタンを押せない）
C1 --> E1 : メロディの音色を Toniqシンセにする
C1 --> C5 : 再生中なら再生し直す
C1 --> B1 : メロディで使用中と表示する

@enduml
