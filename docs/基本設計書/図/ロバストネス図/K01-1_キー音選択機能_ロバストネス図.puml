@startuml
!include ../astah-robustness-style.puml
mainframe **uc** K01-1_キー音選択機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面" as B1
control "キー設定" as C1
control "メロディ生成" as C2
control "コード変換" as C3
control "再生" as C4
entity "アプリの状態" as E1
entity "メロディ設定マスタ" as E2
entity "スケールマスタ" as E3

A1 --> B1 : ルート音を選ぶ
B1 --> C1 : キーを設定する
C1 --> E1 : キーを更新する
C1 --> C2 : 自動生成のメロディがあれば作り直す
C2 --> E2 : 生成パラメータを取得する
C1 --> C3 : キーに合わせたコード名を求める
C3 --> E3 : スケールの音程を取得する
C3 --> B1 : コード名を表示する
C1 --> C4 : 再生中なら再生し直す

@enduml
