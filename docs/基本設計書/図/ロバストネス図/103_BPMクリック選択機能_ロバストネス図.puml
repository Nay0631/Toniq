@startuml
!include ../astah-robustness-style.puml
mainframe **uc** 103_BPMクリック選択機能_ロバストネス図

actor "利用者" as A1
boundary "シンプルモード画面\n（タップで調整ボタン）" as B1
boundary "カスタムモード画面\n（タップボタン）" as B2
control "タップの時刻を記録する\n（2秒空いたらリセット）" as C1
control "直近8回の間隔の平均から\nBPMを求める" as C2
control "BPMを更新する" as C3
control "再生中のテンポに反映する" as C4
entity "曲の状態\n（AppState）" as E1
entity "再生\n（Tone.Transport）" as E2

A1 --> B1
A1 --> B2
B1 --> C1
B2 --> C1
C1 --> C2
C2 --> C3
C3 --> E1
C3 --> C4
C4 --> E2

@enduml
