@startuml
!include ../astah-robustness-style.puml
mainframe **uc** B01-9_グルーヴ調整機能_ロバストネス図

actor "利用者" as A1
boundary "もっと調整" as B1
control "グルーヴ設定" as C1
control "グルーヴ" as C2
control "ドラム演奏" as C3
entity "アプリの状態" as E1
entity "ミックス設定マスタ" as E2

A1 --> B1 : スウィング・サイドチェインの\nノブを回す・標準ボタンを押下する
A1 --> B1 : 跳ねる単位を選ぶ
B1 --> C1 : グルーヴを設定する
C1 --> E1 : スウィング・サイドチェイン・\n跳ねる単位を更新する
C1 --> C2 : スウィングを変えたら\nすぐ反映する
C2 --> E1 : スウィングの量・単位・\n拍子を取得する
C2 --> E2 : 量が空なら\nジャンルの標準の量を取得する
C2 --> C2 : 3連符の拍子\n（スウィングをかけない）
C3 --> C2 : 再生中、キックが鳴るたびに\nほかのパートを沈める
C1 --> B1 : ノブの値と\n変更の数を表示する

@enduml
