@startuml
!include ../astah-robustness-style.puml
mainframe **uc** B01-9_グルーヴ調整機能_ロバストネス図

actor "利用者" as A1
boundary "カスタムモード画面" as B1
control "グルーヴ設定" as C1
control "グルーヴ" as C2
control "ドラム演奏" as C3
entity "アプリの状態" as E1
entity "ミックス設定マスタ" as E2

A1 --> B1 : スウィング・サイドチェインのノブを回す
A1 --> B1 : 標準ボタンを押下する
B1 --> C1 : グルーヴの量を設定する
C1 --> E1 : スウィング・サイドチェインを更新する（標準なら空にする）
C1 --> C2 : スウィングを変えたらすぐ反映する
C2 --> E1 : スウィング・サイドチェインの量を取得する
C2 --> E2 : 量が空ならジャンルの標準の量を取得する
C3 --> C2 : 再生中、キックが鳴るたびにほかのパートを沈める
C1 --> B1 : ノブの値を表示する

@enduml
