@startuml
!include ../astah-er-style.puml

' 仕様書 12.1 テーブル定義（主キー・主な項目に書いた参照先）から描く（エンティティ・キー・線の種類は IDEF1X、多重度は UML の表記）。
' 名前を箱の上に出し、線の端を箱の縁につけ、多重度の文字を線の端の横に置くのは docs/基本設計書/tools/er_layout.mjs（SVG に変換したあとに実行する）

' ---------- ジャンル・雰囲気（ほかのマスタのキーの元） ----------

entity "ジャンルマスタ" as T13 {
  ジャンル
  --
}
entity "雰囲気マスタ" as T14 {
  雰囲気
  --
}

' ---------- ジャンルごとの設定（ジャンル 1 件に 1 件） ----------

entity "テンポマスタ" as T04 <<依存>> {
  ジャンル (FK)
  --
  ゆっくりのBPM
  普通のBPM
  速いのBPM
}
entity "メロディ設定マスタ" as T05 <<依存>> {
  ジャンル (FK)
  --
  リズムのテンプレート[]
  サビのリズムのテンプレート[]
  フレーズ形式[]
  最大の跳躍
  順次進行を好むか
  音域
  Aメロの音域
  サビの音域
  使う音の数の上限
  標準の音色
  標準の拍子
}
entity "ミックス設定マスタ" as T06 <<依存>> {
  ジャンル (FK)
  --
  リバーブ
  EQ
  コンプレッサー
  リミッター
  持ち上げ量
  スウィング
  サイドチェイン
}
entity "ベース設定マスタ" as T07 <<依存>> {
  ジャンル (FK)
  --
  パターン[]
  フィル
  オクターブのずらし
  サブベースの標準
  音色
}
entity "アルペジオ設定マスタ" as T08 <<依存>> {
  ジャンル (FK)
  --
  音色
  刻み
  パターン
  オクターブ数
  音の長さ
  ローパス
  ディレイ
}
entity "ジャンルスケールマスタ" as T12 <<依存>> {
  ジャンル (FK)
  --
  スケール[]
}

' ---------- シンプルモード（ジャンル×雰囲気）と候補 ----------

entity "シンプルモード表マスタ" as T03 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  --
  BPM
}
entity "シンプルモード候補コード進行" as T15 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  コード進行ID (FK)
  --
}
entity "シンプルモード候補ドラムパターン" as T16 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  ドラムパターンID (FK)
  --
}

entity "コード進行マスタ" as T01 {
  コード進行ID
  --
  名前
  BPMの範囲
  基本のスケール
  小節数
  進行（ディグリー・種類・転回形・長さ）[]
  コードのリズム
  メモ
}
entity "ドラムパターンマスタ" as T02 {
  ドラムパターンID
  --
  名前
  BPMの範囲
  ステップ数
  ステップの単位
  トラック（パターン・強さ・音の番号）[]
}

' ---------- コード進行・ドラムパターンのジャンル・雰囲気（多対多を関連エンティティに分けたもの） ----------

entity "コード進行のジャンル" as T18 <<依存>> {
  コード進行ID (FK)
  ジャンル (FK)
  --
}
entity "コード進行の雰囲気" as T19 <<依存>> {
  コード進行ID (FK)
  雰囲気 (FK)
  --
}
entity "ドラムパターンのジャンル" as T20 <<依存>> {
  ドラムパターンID (FK)
  ジャンル (FK)
  --
}
entity "ドラムパターンの雰囲気" as T21 <<依存>> {
  ドラムパターンID (FK)
  雰囲気 (FK)
  --
}

' ---------- 曲と音色 ----------

entity "growプリセット" as T11 {
  growプリセットID
  --
  名前
  カテゴリ
  パラメーターの値[]
}
entity "楽曲データ" as T09 {
  楽曲ID
  --
  名前
  お気に入り
  作成日時
  更新日時
  モード
  ジャンル (FK)
  雰囲気 (FK)
  キー
  BPM
  小節数
  拍子
  コード進行（コード進行マスタの1件の複製）
  サビのコード進行（コード進行マスタの1件の複製）
  ドラムパターン（ドラムパターンマスタの1件の複製）
  メロディ
  サビのメロディ
  セクション・転調
  メロディの音色.growプリセットID (FK)
  コードの音色.growプリセットID (FK)
  グルーヴ（スウィング・サイドチェイン）
  アレンジ（構成のプリセット・変えた所）
  パートのON/OFF・音量・定位
}
entity "楽曲のパートの音色" as T17 <<依存>> {
  楽曲ID (FK)
  パート
  --
  growプリセットID (FK)
  パラメーターの値[]
}
entity "端末の設定データ" as T10 {
  設定キー
  --
  値
}

' ---------- リレーション ----------

' 多重度は UML の表記で線の両端に書く（1 = ちょうど1件、0..1 = 0件か1件、0..* = 0件以上、1..* = 1件以上）。
' 実線 = 依存（親の主キーが子の主キーに入る）、破線 = 非依存（子の主キー以外の属性に入る）。線に関係の名前は書かない

' ジャンル 1 件に設定 1 件（依存）
T13 "1" -- "1" T04
T13 "1" -- "1" T05
T13 "1" -- "1" T06
T13 "1" -- "1" T07
T13 "1" -- "1" T08
T13 "1" -- "1" T12

' ジャンル×雰囲気の組（依存）
T13 "1" -- "0..*" T03
T14 "1" -- "0..*" T03

' 候補（多対多を関連エンティティに分けたもの。依存。ジャンル×雰囲気の1行に候補は1件以上）
T03 "1" -- "1..*" T15
T01 "1" -- "0..*" T15
T03 "1" -- "1..*" T16
T02 "1" -- "0..*" T16

' コード進行・ドラムパターンのジャンル・雰囲気（多対多を関連エンティティに分けたもの。依存。進行・パターンの1件にジャンル・雰囲気は1件以上）
' 進行・パターンの側は「子 "1..*" -- "1" 親」の順に書き、コード進行マスタ・ドラムパターンマスタを関連エンティティの下に置く（親が上だと線が絡むため。線の意味は同じ）
T13 "1" -- "0..*" T18
T14 "1" -- "0..*" T19
T13 "1" -- "0..*" T20
T14 "1" -- "0..*" T21
T18 "1..*" -- "1" T01
T19 "1..*" -- "1" T01
T20 "1..*" -- "1" T02
T21 "1..*" -- "1" T02

' 曲のジャンル・雰囲気（非依存）
T13 "1" .. "0..*" T09
T14 "1" .. "0..*" T09

' 音色のプリセット（非依存。空ならジャンルの標準なので、プリセットの側は 0..1）
T11 "0..1" .. "0..*" T09
T11 "0..1" .. "0..*" T09
T09 "1" -- "0..*" T17
T11 "0..1" .. "0..*" T17

' 端末の設定データはほかのテーブルと独立
T09 -[hidden]- T10

' 配置だけの指定（ジャンルごとの設定を2段に並べて、横に広がりすぎないようにする）
T04 -[hidden]- T05
T12 -[hidden]- T06
T07 -[hidden]- T08
' 関連エンティティを左からドラムパターンのジャンル・コード進行のジャンル・コード進行の雰囲気・ドラムパターンの雰囲気の順に並べる（交差を1本にする）
T20 -[hidden]r- T18
T18 -[hidden]r- T19
T19 -[hidden]r- T21

' 実体（何に保存しているか）の凡例。仕様書 12.1 の「実体」の列をまとめたもの。
' テーブル名は図の箱の名前のとおりに省略せず書き、区切りは「、」、説明は「…」の後ろ。同じ見出しの中で次の行に移るときも行の終わりに「、」を打つ（「・」でまとめると同じものが2回あるように読めるため）
legend bottom right
  <b>実体（何に保存しているか）</b>
  ■ JSON ファイル（1つのファイルが1つのマスタ）
  　コード進行マスタ、ドラムパターンマスタ、シンプルモード表マスタ、テンポマスタ、メロディ設定マスタ、
  　ミックス設定マスタ、ベース設定マスタ、アルペジオ設定マスタ、ジャンルスケールマスタ
  ■ ファイルはない（図の記法として、別のエンティティに分けて描いたもの）
  　ジャンルマスタ、雰囲気マスタ … 値の一覧（上の JSON のキーとして使う値）、
  　シンプルモード候補コード進行、シンプルモード候補ドラムパターン … シンプルモード表マスタの JSON の中の ID の並び、
  　コード進行のジャンル、コード進行の雰囲気 … コード進行マスタの JSON の中の並び、
  　ドラムパターンのジャンル、ドラムパターンの雰囲気 … ドラムパターンマスタの JSON の中の並び、
  　楽曲のパートの音色 … 楽曲データの中の項目
  ■ そのほか
  　growプリセット … grow の wasm、
  　楽曲データ、端末の設定データ … ブラウザの localStorage
endlegend

@enduml
