@startuml
!include ../astah-er-style.puml

' 仕様書 12.1 テーブル定義・12.2 の関係から描く（IDEF1X）。
' 名前を箱の上に出し、子の側の丸を黒丸にして箱の縁につけるのは docs/基本設計書/tools/er_layout.mjs（SVG に変換したあとに実行する）

' ---------- ジャンル・雰囲気（ほかのマスタのキーの元） ----------

entity "ジャンルマスタ" as T14 {
  ジャンル
  --
}
entity "雰囲気マスタ" as T15 {
  雰囲気
  --
}

' ---------- ジャンルごとの設定（ジャンル 1 件に 1 件） ----------

entity "テンポマスタ" as T04 <<依存>> {
  ジャンル (FK)
  --
  ゆっくりのBPM
  普通のBPM
  速いのBPM
}
entity "メロディ設定マスタ" as T05 <<依存>> {
  ジャンル (FK)
  --
  リズムのテンプレート[]
  サビのリズムのテンプレート[]
  フレーズ形式[]
  最大の跳躍
  順次進行を好むか
  音域
  Aメロの音域
  サビの音域
  使う音の数の上限
  標準の音色
  標準の拍子
}
entity "ミックス設定マスタ" as T06 <<依存>> {
  ジャンル (FK)
  --
  リバーブ
  EQ
  コンプレッサー
  リミッター
  持ち上げ量
  スウィング
  サイドチェイン
}
entity "ベース設定マスタ" as T07 <<依存>> {
  ジャンル (FK)
  --
  パターン[]
  フィル
  オクターブのずらし
  サブベースの標準
  音色
}
entity "アルペジオ設定マスタ" as T08 <<依存>> {
  ジャンル (FK)
  --
  音色
  刻み
  パターン
  オクターブ数
  音の長さ
  ローパス
  ディレイ
}
entity "ジャンルスケールマスタ" as T12 <<依存>> {
  ジャンル (FK)
  --
  スケール[]
}

' ---------- シンプルモード（ジャンル×雰囲気）と候補 ----------

entity "シンプルモード表マスタ" as T03 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  --
  BPM
}
entity "シンプルモード候補コード進行" as T16 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  コード進行ID (FK)
  --
}
entity "シンプルモード候補ドラムパターン" as T17 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  ドラムパターンID (FK)
  --
}

entity "コード進行マスタ" as T01 {
  コード進行ID
  --
  名前
  雰囲気[]
  ジャンル[]
  BPMの範囲
  基本のスケール
  小節数
  進行（ディグリー・種類・転回形・長さ）[]
  コードのリズム
  メモ
}
entity "ドラムパターンマスタ" as T02 {
  ドラムパターンID
  --
  名前
  ジャンル[]
  雰囲気[]
  BPMの範囲
  ステップ数
  ステップの単位
  トラック（パターン・強さ・音の番号）[]
}

' ---------- 曲と音色 ----------

entity "lidlessプリセット" as T11 {
  lidlessプリセットID
  --
  名前
  カテゴリ
  パラメーターの値[]
}
entity "楽曲データ" as T09 {
  楽曲ID
  --
  名前
  お気に入り
  作成日時
  更新日時
  モード
  ジャンル (FK)
  雰囲気 (FK)
  キー
  BPM
  小節数
  拍子
  コード進行（コード進行マスタの1件の複製）
  サビのコード進行（コード進行マスタの1件の複製）
  ドラムパターン（ドラムパターンマスタの1件の複製）
  メロディ
  サビのメロディ
  セクション・転調
  メロディの音色.lidlessプリセットID (FK)
  コードの音色.lidlessプリセットID (FK)
  グルーヴ（スウィング・サイドチェイン）
  アレンジ（構成のプリセット・変えた所）
  パートのON/OFF・音量・定位
}
entity "楽曲のパートの音色" as T18 <<依存>> {
  楽曲ID (FK)
  パート
  --
  lidlessプリセットID (FK)
  パラメーターの値[]
}
entity "端末の設定データ" as T10 {
  設定キー
  --
  値
}

' ---------- リレーション ----------

' ジャンル 1 件に設定 1 件（依存。子の側の「1」は 1 件ちょうど）
T14 --0 "1" T04 : 決める
T14 --0 "1" T05 : 決める
T14 --0 "1" T06 : 決める
T14 --0 "1" T07 : 決める
T14 --0 "1" T08 : 決める
T14 --0 "1" T12 : 決める

' ジャンル×雰囲気の組（依存）
T14 --0 T03 : 組む
T15 --0 T03 : 組む

' 候補（多対多を関連エンティティに分けたもの。依存）
T03 --0 "P" T16 : 候補に持つ
T01 --0 T16 : 候補になる
T03 --0 "P" T17 : 候補に持つ
T02 --0 T17 : 候補になる

' 曲のジャンル・雰囲気（非依存）
T14 ..0 T09 : 分類する
T15 ..0 T09 : 分類する

' 音色のプリセット（非依存。空ならジャンルの標準）
T11 o..0 T09 : メロディの音色になる
T11 o..0 T09 : コードの音色になる
T09 --0 T18 : 持つ
T11 o..0 T18 : 音色になる

' 端末の設定データはほかのテーブルと独立
T09 -[hidden]- T10

' 配置だけの指定（ジャンルごとの設定を2段に並べて、横に広がりすぎないようにする）
T04 -[hidden]- T05
T12 -[hidden]- T06
T07 -[hidden]- T08

@enduml
