@startuml
!include ../astah-er-style.puml

' 仕様書 12.1 テーブル定義・12.2 の関係から描く（IDEF1X）。
' 名前を箱の上に出し、子の側の丸を黒丸にするのは docs/基本設計書/tools/er_layout.mjs（SVG に変換したあとに実行する）

entity "テンポマスタ" as T04 {
  ジャンル
  --
  ゆっくりのBPM
  普通のBPM
  速いのBPM
}
entity "メロディ設定マスタ" as T05 {
  ジャンル
  --
  リズムのテンプレート[]
  サビのリズムのテンプレート[]
  フレーズ形式[]
  最大の跳躍
  順次進行を好むか
  音域
  Aメロの音域
  サビの音域
  使う音の数の上限
  標準の音色
  標準の拍子
}
entity "ミックス設定マスタ" as T06 {
  ジャンル
  --
  リバーブ
  EQ
  コンプレッサー
  リミッター
  持ち上げ量
  スウィング
  サイドチェイン
}
entity "ベース設定マスタ" as T07 {
  ジャンル
  --
  パターン[]
  フィル
  オクターブのずらし
  サブベースの標準
  音色
}
entity "アルペジオ設定マスタ" as T08 {
  ジャンル
  --
  音色
  刻み
  パターン
  オクターブ数
  音の長さ
  ローパス
  ディレイ
}
entity "ジャンルスケールマスタ" as T12 {
  ジャンル
  --
  スケール[]
}

entity "シンプルモード表マスタ" as T03 <<依存>> {
  ジャンル (FK)
  雰囲気
  --
  BPM
  コード進行IDの候補[]
  ドラムパターンIDの候補[]
}

entity "コード進行マスタ" as T01 {
  コード進行ID
  --
  名前
  雰囲気[]
  ジャンル[]
  BPMの範囲
  基本のスケール
  小節数
  進行（ディグリー・種類・転回形・長さ）[]
  コードのリズム
  メモ
}
entity "ドラムパターンマスタ" as T02 {
  ドラムパターンID
  --
  名前
  ジャンル[]
  雰囲気[]
  BPMの範囲
  ステップ数
  ステップの単位
  トラック（パターン・強さ・音の番号）[]
}

entity "lidlessプリセット" as T11 {
  lidlessプリセットID
  --
  名前
  カテゴリ
  パラメーターの値[]
}
entity "楽曲データ" as T09 {
  楽曲ID
  --
  名前
  お気に入り
  作成日時
  更新日時
  モード
  ジャンル
  雰囲気
  キー
  BPM
  小節数
  拍子
  コード進行（コード進行マスタの1件の複製）
  サビのコード進行（コード進行マスタの1件の複製）
  ドラムパターン（ドラムパターンマスタの1件の複製）
  メロディ
  サビのメロディ
  セクション・転調
  メロディの音色 (FK)
  コードの音色 (FK)
  パートごとの音色 (FK)
  グルーヴ（スウィング・サイドチェイン）
  アレンジ（構成のプリセット・変えた所）
  パートのON/OFF・音量・定位
}
entity "端末の設定データ" as T10 {
  設定キー
  --
  値
}

' ジャンル名をキーに 1 対 1 のマスタ → シンプルモード表マスタ（ジャンル×雰囲気）
T04 --0 T03
T05 --0 T03
T06 --0 T03
T07 --0 T03
T08 --0 T03
T12 --0 T03

' 候補のコード進行・ドラムパターン（多対多）
T03 0--0 T01
T03 0--0 T02

' 音色のプリセット（空ならジャンルの標準）
T11 o..0 T09

' 楽曲データ・端末の設定データはほかのテーブルと独立（コード進行・ドラムパターンは複製して持つ）
T09 -[hidden]- T10

@enduml
