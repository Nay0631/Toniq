@startuml
!include ../astah-er-style.puml

' 仕様書 12.1 テーブル定義・12.2 の関係から描く（エンティティ・キー・線の種類は IDEF1X、多重度は UML の表記）。
' 名前を箱の上に出し、線の端を箱の縁につけ、多重度の文字を線の端の横に置くのは docs/基本設計書/tools/er_layout.mjs（SVG に変換したあとに実行する）

' ---------- ジャンル・雰囲気（ほかのマスタのキーの元） ----------

entity "ジャンルマスタ" as T14 {
  ジャンル
  --
}
entity "雰囲気マスタ" as T15 {
  雰囲気
  --
}

' ---------- ジャンルごとの設定（ジャンル 1 件に 1 件） ----------

entity "テンポマスタ" as T04 <<依存>> {
  ジャンル (FK)
  --
  ゆっくりのBPM
  普通のBPM
  速いのBPM
}
entity "メロディ設定マスタ" as T05 <<依存>> {
  ジャンル (FK)
  --
  リズムのテンプレート[]
  サビのリズムのテンプレート[]
  フレーズ形式[]
  最大の跳躍
  順次進行を好むか
  音域
  Aメロの音域
  サビの音域
  使う音の数の上限
  標準の音色
  標準の拍子
}
entity "ミックス設定マスタ" as T06 <<依存>> {
  ジャンル (FK)
  --
  リバーブ
  EQ
  コンプレッサー
  リミッター
  持ち上げ量
  スウィング
  サイドチェイン
}
entity "ベース設定マスタ" as T07 <<依存>> {
  ジャンル (FK)
  --
  パターン[]
  フィル
  オクターブのずらし
  サブベースの標準
  音色
}
entity "アルペジオ設定マスタ" as T08 <<依存>> {
  ジャンル (FK)
  --
  音色
  刻み
  パターン
  オクターブ数
  音の長さ
  ローパス
  ディレイ
}
entity "ジャンルスケールマスタ" as T12 <<依存>> {
  ジャンル (FK)
  --
  スケール[]
}

' ---------- シンプルモード（ジャンル×雰囲気）と候補 ----------

entity "シンプルモード表マスタ" as T03 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  --
  BPM
}
entity "シンプルモード候補コード進行" as T16 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  コード進行ID (FK)
  --
}
entity "シンプルモード候補ドラムパターン" as T17 <<依存>> {
  ジャンル (FK)
  雰囲気 (FK)
  ドラムパターンID (FK)
  --
}

entity "コード進行マスタ" as T01 {
  コード進行ID
  --
  名前
  雰囲気[]
  ジャンル[]
  BPMの範囲
  基本のスケール
  小節数
  進行（ディグリー・種類・転回形・長さ）[]
  コードのリズム
  メモ
}
entity "ドラムパターンマスタ" as T02 {
  ドラムパターンID
  --
  名前
  ジャンル[]
  雰囲気[]
  BPMの範囲
  ステップ数
  ステップの単位
  トラック（パターン・強さ・音の番号）[]
}

' ---------- 曲と音色 ----------

entity "lidlessプリセット" as T11 {
  lidlessプリセットID
  --
  名前
  カテゴリ
  パラメーターの値[]
}
entity "楽曲データ" as T09 {
  楽曲ID
  --
  名前
  お気に入り
  作成日時
  更新日時
  モード
  ジャンル (FK)
  雰囲気 (FK)
  キー
  BPM
  小節数
  拍子
  コード進行（コード進行マスタの1件の複製）
  サビのコード進行（コード進行マスタの1件の複製）
  ドラムパターン（ドラムパターンマスタの1件の複製）
  メロディ
  サビのメロディ
  セクション・転調
  メロディの音色.lidlessプリセットID (FK)
  コードの音色.lidlessプリセットID (FK)
  グルーヴ（スウィング・サイドチェイン）
  アレンジ（構成のプリセット・変えた所）
  パートのON/OFF・音量・定位
}
entity "楽曲のパートの音色" as T18 <<依存>> {
  楽曲ID (FK)
  パート
  --
  lidlessプリセットID (FK)
  パラメーターの値[]
}
entity "端末の設定データ" as T10 {
  設定キー
  --
  値
}

' ---------- リレーション ----------

' 多重度は UML の表記で線の両端に書く（1 = ちょうど1件、0..1 = 0件か1件、0..* = 0件以上、1..* = 1件以上）。
' 実線 = 依存（親の主キーが子の主キーに入る）、破線 = 非依存（子の主キー以外の属性に入る）。線に関係の名前は書かない

' ジャンル 1 件に設定 1 件（依存）
T14 "1" -- "1" T04
T14 "1" -- "1" T05
T14 "1" -- "1" T06
T14 "1" -- "1" T07
T14 "1" -- "1" T08
T14 "1" -- "1" T12

' ジャンル×雰囲気の組（依存）
T14 "1" -- "0..*" T03
T15 "1" -- "0..*" T03

' 候補（多対多を関連エンティティに分けたもの。依存。ジャンル×雰囲気の1行に候補は1件以上）
T03 "1" -- "1..*" T16
T01 "1" -- "0..*" T16
T03 "1" -- "1..*" T17
T02 "1" -- "0..*" T17

' 曲のジャンル・雰囲気（非依存）
T14 "1" .. "0..*" T09
T15 "1" .. "0..*" T09

' 音色のプリセット（非依存。空ならジャンルの標準なので、プリセットの側は 0..1）
T11 "0..1" .. "0..*" T09
T11 "0..1" .. "0..*" T09
T09 "1" -- "0..*" T18
T11 "0..1" .. "0..*" T18

' 端末の設定データはほかのテーブルと独立
T09 -[hidden]- T10

' 配置だけの指定（ジャンルごとの設定を2段に並べて、横に広がりすぎないようにする）
T04 -[hidden]- T05
T12 -[hidden]- T06
T07 -[hidden]- T08

@enduml
