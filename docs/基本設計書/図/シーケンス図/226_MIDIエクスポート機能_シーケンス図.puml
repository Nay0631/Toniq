@startuml
!include ../astah-sequence-style.puml
mainframe sd 226_MIDIエクスポート機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
entity ":AppState" as L3
control ":MidiExporter" as L4
control ":degree_resolver" as L5
control ":ArpPlayer" as L6
entity ":MIDIファイル" as L7

note over L2 : シンプルモード画面（SimpleScreen）の\n「MIDIで書き出す」ボタンも同じ流れ

L1 -> L2 : MIDI ボタンを押下する()
activate L2
L2 -> L3 : getState()
activate L3
deactivate L3
L2 -> L4 : exportMidi(chordPattern, melodyNotes, key, bpm)
activate L4
L4 -> L4 : テンポと拍子（4/4）を書く()
activate L4
deactivate L4
L4 -> L4 : メロディのトラックを作る()
activate L4
deactivate L4
L4 -> L5 : voiceProgression(progression, key, VOICING_RANGES.chord)
activate L5
deactivate L5
L4 -> L4 : コードのトラックを作る()
activate L4
deactivate L4
loop コードごと
  L4 -> L5 : resolveChord(degree, type, inversion, key, scale, octave)
  activate L5
  deactivate L5
end
L4 -> L4 : ベースのトラックを作る()
activate L4
deactivate L4
L4 -> L6 : arpParam()
activate L6
deactivate L6
L4 -> L6 : arpNotes(progression, key, param)
activate L6
deactivate L6
L4 -> L4 : アルペジオのトラックを作る()
activate L4
deactivate L4
L4 -> L7 : ダウンロードして保存する(toniq_export.mid)
activate L7
deactivate L7
deactivate L4
deactivate L2

@enduml
