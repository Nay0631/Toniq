@startuml
!include ../astah-sequence-style.puml
mainframe sd 201_BPM選択機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
entity ":AppState" as L3
control ":Playback" as L4
entity ":Tone.Transport" as L5

L1 -> L2 : BPMノブを回す()
activate L2
L2 -> L2 : setBpm(bpm)
activate L2
L2 -> L2 : BPMを20〜240に丸める()
activate L2
deactivate L2
L2 -> L3 : setState(bpm, tempoPreset)
activate L3
deactivate L3
L2 -> L4 : isPlaying()
activate L4
deactivate L4
opt 再生中
  L2 -> L4 : applyBpm()
  activate L4
  L4 -> L5 : BPMを設定する(bpm)
  activate L5
  deactivate L5
  deactivate L4
end
deactivate L2
L2 -> L2 : render()
activate L2
deactivate L2
deactivate L2

@enduml
