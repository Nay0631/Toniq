@startuml
!include ../astah-sequence-style.puml
mainframe sd B01-8_リード選択機能_シーケンス図

actor ":利用者" as L1
boundary ":growパネル" as L2
control ":音色設定" as L3
entity ":growプリセット" as L4
entity ":アプリの状態" as L5
control ":音色試聴" as L6
control ":grow" as L7

note over L2 : 「対象」がメロディのとき。選べるのは「ジャンルの標準」と\nリード・和音・プラック・パッドのカテゴリのプリセット

L1 -> L2 : プリセットのチップを押下する() : void
activate L2
L2 -> L3 : メロディの音色を設定する() : void
activate L3
alt プリセット
  L3 -> L4 : プリセットを取得する() : void
  activate L4
  deactivate L4
else ジャンルの標準
  L3 -> L4 : ジャンルの標準のプリセットを取得する() : void
  activate L4
  deactivate L4
end
L3 -> L5 : メロディの音色を更新し、変えた値を捨てる() : void
activate L5
deactivate L5
alt 停止中
  L3 -> L6 : 主音を1音鳴らす() : void
  activate L6
  L6 -> L7 : 選んだ音色で鳴らす() : void
  activate L7
  deactivate L7
  deactivate L6
else 再生中
  L3 -> L7 : 鳴っているメロディにすぐ反映する() : void
  activate L7
  deactivate L7
end
L3 -> L2 : 選んでいるチップを表示する() : void
activate L2
deactivate L2
deactivate L3
deactivate L2

@enduml
