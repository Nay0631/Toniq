@startuml
!include ../astah-sequence-style.puml
mainframe sd U01-4_ループ再生切替機能_シーケンス図

actor ":利用者" as L1
boundary ":設定画面" as L2
control ":端末の設定" as L3
entity ":アプリの状態" as L4
entity ":端末の設定データ" as L5
control ":再生" as L6

L1 -> L2 : ループ再生のスイッチを押下する() : void
activate L2
L2 -> L3 : ループ再生を切り替える() : void
activate L3
L3 -> L4 : ループ再生を更新する() : void
activate L4
deactivate L4
L3 -> L5 : ループ再生を保存する() : void
activate L5
deactivate L5
opt 曲を再生中
  L3 -> L6 : 曲の終わり方を切り替える() : void
  activate L6
  alt ループ再生が ON
    L6 -> L6 : 先頭〜小節数でループさせる() : void
    activate L6
    deactivate L6
  else ループ再生が OFF
    L6 -> L6 : 小節数で止める予約をする() : void
    activate L6
    deactivate L6
  end
  deactivate L6
end
deactivate L3
deactivate L2

@enduml
