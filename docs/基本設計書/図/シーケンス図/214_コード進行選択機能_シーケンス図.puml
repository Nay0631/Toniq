@startuml
!include ../astah-sequence-style.puml
mainframe sd 214_コード進行選択機能_シーケンス図

actor ":利用者" as L1
boundary ":SimpleScreen" as L2
boundary ":CustomScreen" as L3
control ":SimpleModeResolver" as L4
entity ":chord_progressions.json" as L5
entity ":AppState" as L6
control ":MelodyGenerator" as L7
control ":Playback" as L8

alt シンプルモード画面（コードの再抽選）
  L1 -> L2 : コードの再抽選ボタンを押下する()
  activate L2
  L2 -> L4 : rerollChord(genre, mood, currentId)
  activate L4
  L4 -> L5 : ジャンル・雰囲気が合う進行を取得する()
  activate L5
  deactivate L5
  L4 -> L4 : 今の進行以外からランダムに選ぶ()
  activate L4
  deactivate L4
  deactivate L4
  L2 -> L6 : setState(chordPattern)
  activate L6
  deactivate L6
  L2 -> L6 : setState(bars)
  activate L6
  deactivate L6
  opt メロディが自動生成
    L2 -> L7 : generateMelody(chordPattern, key, genre)
    activate L7
    deactivate L7
    L2 -> L6 : setState(melodyNotes)
    activate L6
    deactivate L6
  end
  L2 -> L2 : render()
  activate L2
  deactivate L2
  L2 -> L2 : restartIfPlaying()
  activate L2
  opt 再生中
    L2 -> L8 : play(onEnded)
    activate L8
    deactivate L8
  end
  deactivate L2
  deactivate L2
else カスタムモード画面（ドロップダウン・◀▶）
  L1 -> L3 : コード進行を選ぶ()
  activate L3
  L3 -> L5 : 選んだ進行を取得する(id)
  activate L5
  deactivate L5
  L3 -> L3 : setChordPattern(next)
  activate L3
  L3 -> L6 : setState(chordPattern)
  activate L6
  deactivate L6
  opt 自動生成のメロディがある
    L3 -> L7 : generateMelody(chordPattern, key, genre)
    activate L7
    deactivate L7
    L3 -> L6 : setState(melodyNotes)
    activate L6
    deactivate L6
  end
  deactivate L3
  L3 -> L3 : render()
  activate L3
  deactivate L3
  L3 -> L3 : restartIfPlaying()
  activate L3
  opt 再生中
    L3 -> L8 : play(fromBar, onLoopChange, onEnded)
    activate L8
    deactivate L8
  end
  deactivate L3
  deactivate L3
end

@enduml
