@startuml
!include ../astah-sequence-style.puml
mainframe sd L01-1_楽曲再生機能_シーケンス図

actor ":利用者" as L1
boundary ":カスタムモード画面" as L2
control ":スペースキー" as L11
boundary ":ミュージックリスト画面" as L3
control ":楽曲切り替え" as L4
control ":曲の管理" as L5
entity ":楽曲データ" as L6
entity ":アプリの状態" as L7
control ":再生" as L8
control ":grow" as L12
entity ":growプリセット" as L13
control ":各パートの演奏" as L9
control ":アレンジ管理" as L10
control ":ファイルの試聴" as L14
control ":画面切り替え" as L15

note over L2 : シンプルモード画面（生成後）の再生ボタン・スペースキーも同じ流れ。\n曲の最後の小節は主和音の全音符で終わり（エンディング）、ドラムはセクションの変わり目などにフィルを入れる

alt モード画面で再生ボタン
  L1 -> L2 : 再生ボタンを押下する() : void
  activate L2
  L2 -> L8 : 再生する() : void
  activate L8
  L8 -> L7 : 曲の内容を取得する() : void
  activate L7
  deactivate L7
  L8 -> L12 : grow の準備を待つ() : void
  activate L12
  L12 -> L13 : プリセットを取得する() : void
  activate L13
  deactivate L13
  deactivate L12
  alt 読み込めた
    L8 -> L9 : ON のパートを読み込む() : void
    activate L9
    deactivate L9
    L8 -> L10 : 周回を数え、くり返す範囲を決める() : void
    activate L10
    deactivate L10
    note right of L10 : ピアノロールでメロディを編集している間は\n選んでいるセクション、区間ループがあるときは\nその区間をくり返す
    L8 -> L8 : 曲の終わりで止める予約をする() : void
    activate L8
    deactivate L8
    note right of L8 : 終わりの時刻はオーディオの時計で決める\n（最小化していても止まる）。エンディングは\n1小節あとに止める。ループ再生なら先頭へ戻る
    L8 -> L2 : 停止ボタンを出す() : void
    activate L2
    deactivate L2
  else 読み込みで例外が出た
    L8 -> L2 : 再生できなかったことを知らせる() : void
    activate L2
    deactivate L2
  end
  deactivate L8
  deactivate L2
else スペースキー（どのタブでも）
  L1 -> L2 : スペースキーを押下する() : void
  activate L2
  L2 -> L11 : 再生／停止を切り替える() : void
  activate L11
  note right of L11 : 文字の入力欄・ドロップダウンの操作中、\nダイアログの表示中は効かない。押し続けても繰り返さない
  alt 停止中
    L11 -> L8 : 再生する() : void
    activate L8
    note right of L8 : アレンジャータブは再生開始位置から、\nほかは先頭から（以降は再生ボタンと同じ）
    deactivate L8
  else 再生中
    L11 -> L8 : 停止する() : void
    activate L8
    deactivate L8
  end
  deactivate L11
  deactivate L2
else ミュージックリストで再生
  L1 -> L3 : 曲の再生ボタンを押下する() : void
  activate L3
  L3 -> L4 : 選んだ曲を今の曲にする() : void
  activate L4
  opt 今の曲と別の曲
    opt 今の曲に保存していない変更がある
      L4 -> L1 : 別の曲を開くか確認する() : void
      activate L1
      deactivate L1
    end
    L4 -> L5 : 保存した曲を読み込む() : void
    activate L5
    L5 -> L6 : 曲の内容を取得する() : void
    activate L6
    deactivate L6
    L5 -> L7 : 曲の内容を反映する() : void
    activate L7
    deactivate L7
    deactivate L5
  end
  L4 -> L14 : 書き出したファイルを聴いていたら止める() : void
  activate L14
  deactivate L14
  L4 -> L8 : 再生する() : void
  activate L8
  L8 -> L12 : grow の準備を待つ() : void
  activate L12
  deactivate L12
  L8 -> L9 : ON のパートを読み込む() : void
  activate L9
  deactivate L9
  L8 -> L3 : 再生位置を表示する() : void
  activate L3
  deactivate L3
  deactivate L8
  deactivate L4
  deactivate L3
else ほかの画面へ移る
  L1 -> L2 : ほかの画面へ移る() : void
  activate L2
  L2 -> L15 : 画面を切り替える() : void
  activate L15
  L15 -> L8 : 停止する() : void
  activate L8
  deactivate L8
  deactivate L15
  deactivate L2
end

@enduml
