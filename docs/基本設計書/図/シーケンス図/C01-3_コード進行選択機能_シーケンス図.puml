@startuml
!include ../astah-sequence-style.puml
mainframe sd C01-3_コード進行選択機能_シーケンス図

actor ":利用者" as L1
boundary ":シンプルモード画面" as L2
boundary ":カスタムモード画面" as L3
control ":コード進行設定" as L4
control ":パターン選出" as L5
entity ":シンプルモード表マスタ" as L6
entity ":コード進行マスタ" as L7
entity ":アプリの状態" as L8
control ":メロディ生成" as L9
control ":再生" as L10

alt シンプルモード画面（再抽選）
  L1 -> L2 : コードの再抽選ボタンを押下する() : void
  activate L2
  L2 -> L4 : コード進行を再抽選する() : void
  activate L4
  L4 -> L5 : 今の進行以外から選ぶ() : void
  activate L5
  L5 -> L6 : ジャンル×雰囲気の候補を取得する() : void
  activate L6
  deactivate L6
  L5 -> L7 : 候補のコード進行を取得する() : void
  activate L7
  deactivate L7
  deactivate L5
  L4 -> L8 : コード進行と小節数を更新する() : void
  activate L8
  deactivate L8
  opt メロディが自動生成
    L4 -> L9 : メロディを生成する() : void
    activate L9
    deactivate L9
    L4 -> L8 : メロディを更新する() : void
    activate L8
    deactivate L8
  end
  opt 再生中
    L4 -> L10 : 再生し直す() : void
    activate L10
    deactivate L10
  end
  deactivate L4
  deactivate L2
else カスタムモード画面（ドロップダウン・◀▶）
  L1 -> L3 : コード進行を選ぶ() : void
  activate L3
  L3 -> L4 : 選んだコード進行に切り替える() : void
  activate L4
  L4 -> L7 : 選んだコード進行を取得する() : void
  activate L7
  deactivate L7
  L4 -> L8 : コード進行を更新する() : void
  activate L8
  deactivate L8
  opt 自動生成のメロディがある
    L4 -> L9 : メロディを生成する() : void
    activate L9
    deactivate L9
    L4 -> L8 : メロディを更新する() : void
    activate L8
    deactivate L8
  end
  opt 再生中
    L4 -> L10 : 再生し直す() : void
    activate L10
    deactivate L10
  end
  deactivate L4
  deactivate L3
end

@enduml
