@startuml
!include ../astah-sequence-style.puml
mainframe sd C01-8_転調選択機能_シーケンス図

actor ":利用者" as L1
boundary ":もっと調整" as L2
control ":転調設定" as L3
entity ":アプリの状態" as L4
control ":再生" as L5
control ":曲の構成" as L6
control ":コード変換" as L7

note over L2 : 転調：しない／半音・全音・短3度・4度上げる。\n転調する所：最後のサビから／サビだけ

L1 -> L2 : 転調・転調する所を選ぶ() : void
activate L2
L2 -> L3 : 転調を設定する() : void
activate L3
L3 -> L4 : 転調の幅・転調する所を更新する() : void
activate L4
deactivate L4
L3 -> L2 : 変更の数を表示する() : void
activate L2
deactivate L2
opt 再生中
  L3 -> L5 : 再生し直す() : void
  activate L5
  L5 -> L6 : 転調する周回を求める() : void
  activate L6
  opt サビがない
    L6 -> L6 : 転調しない() : void
    activate L6
    deactivate L6
  end
  deactivate L6
  L5 -> L7 : 上げたキーでコードを求める() : void
  activate L7
  note right of L7 : メロディは同じ半音だけ上げる
  deactivate L7
  deactivate L5
end
deactivate L3
deactivate L2

@enduml
