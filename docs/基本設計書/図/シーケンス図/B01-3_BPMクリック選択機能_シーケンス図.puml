@startuml
!include ../astah-sequence-style.puml
mainframe sd B01-3_BPMクリック選択機能_シーケンス図

actor ":利用者" as L1
boundary ":カスタムモード画面" as L2
control ":タップテンポ" as L3
entity ":アプリの状態" as L4
control ":再生" as L5

note over L2 : シンプルモード画面の「タップで調整」も同じ流れ\n（テンポを反映するのはサンプル再生中）

L1 -> L2 : タップボタンを押下する() : void
activate L2
L2 -> L3 : タップを記録する() : void
activate L3
alt 前回から2秒以内で、タップが2回以上
  L3 -> L3 : 直近8回の間隔の平均からBPMを求める() : void
  activate L3
  deactivate L3
  L3 -> L4 : BPMを更新する() : void
  activate L4
  deactivate L4
else 1回目、または2秒以上空いた
  L3 -> L3 : 記録をやり直す() : void
  activate L3
  deactivate L3
end
deactivate L3
opt BPMを求めた、かつ再生中
  L2 -> L5 : テンポを反映する() : void
  activate L5
  deactivate L5
end
deactivate L2

@enduml
