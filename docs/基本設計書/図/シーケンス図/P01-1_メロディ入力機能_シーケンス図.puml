@startuml
!include ../astah-sequence-style.puml
mainframe sd P01-1_メロディ入力機能_シーケンス図

actor ":利用者" as L1
boundary ":ピアノロール画面" as L2
control ":音符編集" as L3
control ":スケール判定" as L4
entity ":アプリの状態" as L5
entity ":スケールマスタ" as L6
control ":メロディ演奏" as L7
control ":パート管理" as L8
control ":曲の構成" as L9
control ":メロディ生成" as L10
control ":再生" as L11
control ":アレンジ管理" as L12

note over L2 : 編集するセクション（Aメロ／サビ）・音符の長さ（3連符の拍子では「4分3連」「8分3連」）は\nツールバーで選ぶ。タイピングピアノは Z〜/ の段と Q〜] の段（上の段が黒鍵）、↓↑ でオクターブ。\n置く場所は音符長にかかわらず1マスごとに選べる（音符長は新しく置く音の長さ）

alt 音を置く
  L1 -> L2 : グリッドを押下する・タイピングピアノのキーを押す() : void
  activate L2
  L2 -> L3 : 音を置く() : void
  activate L3
  L3 -> L4 : 置ける音か確かめる() : void
  activate L4
  L4 -> L5 : キー・スケール・スケールロックを取得する() : void
  activate L5
  deactivate L5
  L4 -> L6 : スケールの7音を取得する() : void
  activate L6
  deactivate L6
  deactivate L4
  alt 置ける音
    L3 -> L7 : 置いた音を今の音色で試聴する() : void
    activate L7
    deactivate L7
    L3 -> L3 : 後ろの音にかかる長さを手前まで短くする() : void
    activate L3
    deactivate L3
    L3 -> L5 : 編集中のセクションのメロディを更新し「自分で入力」にする() : void
    activate L5
    deactivate L5
    opt 再生中
      L3 -> L8 : メロディを読み込み直す() : void
      activate L8
      deactivate L8
    end
    L3 -> L2 : 音符を表示する() : void
    activate L2
    deactivate L2
  else ほかの音が鳴っている所（同じ時刻を含む）
    L3 -> L2 : 「ここにはすでに音があります」の注意を5秒出す() : void
    activate L2
    deactivate L2
    note right of L2 : 置いてある音は消さない。\n鍵盤入力なら入力位置も進めない
  else 音域外・スケール外
    L3 -> L3 : 置かずに終わる() : void
    activate L3
    deactivate L3
  end
  deactivate L3
  deactivate L2
else 自動生成
  L1 -> L2 : 自動生成ボタンを押下する() : void
  activate L2
  L2 -> L3 : 自動生成のメロディに置き換える() : void
  activate L3
  opt 手入力のメロディがある
    L3 -> L3 : 置き換えるか確認する() : void
    activate L3
    deactivate L3
    note right of L3 : 取り消したら何もしない
  end
  L3 -> L9 : Aメロとサビのメロディを作る() : void
  activate L9
  L9 -> L10 : メロディを作る() : void
  activate L10
  deactivate L10
  deactivate L9
  L3 -> L5 : メロディとサビのメロディを更新し「自動生成」にする() : void
  activate L5
  deactivate L5
  opt 再生中
    L3 -> L8 : メロディを読み込み直す() : void
    activate L8
    deactivate L8
  end
  L3 -> L2 : 音符を表示する() : void
  activate L2
  deactivate L2
  deactivate L3
  deactivate L2
else クリア
  L1 -> L2 : クリアボタンを押下する() : void
  activate L2
  L2 -> L3 : すべて消す() : void
  activate L3
  opt 音がある
    L3 -> L3 : 消すか確認する() : void
    activate L3
    deactivate L3
    note right of L3 : 取り消したら何もしない
  end
  L3 -> L5 : 編集中のセクションのメロディを更新し「自分で入力」にする() : void
  activate L5
  deactivate L5
  opt 再生中
    L3 -> L8 : メロディを読み込み直す() : void
    activate L8
    deactivate L8
  end
  L3 -> L2 : 音符を表示する() : void
  activate L2
  deactivate L2
  deactivate L3
  deactivate L2
else 表示の拡大・縮小
  L1 -> L2 : 表示の拡大・縮小ボタンを押下する() : void
  activate L2
  note right of L2 : Ctrl＋ホイール（横）・Ctrl＋Shift＋ホイール（縦）でも。\n横 100〜800％・縦 70〜200％
  L2 -> L3 : 表示を拡大・縮小する() : void
  activate L3
  L3 -> L5 : 拡大率を更新する() : void
  activate L5
  deactivate L5
  L3 -> L2 : 音符と拡大率を表示する() : void
  activate L2
  deactivate L2
  deactivate L3
  deactivate L2
else 再生
  L1 -> L2 : 情報バーの「再生」・スペースキーを押下する() : void
  activate L2
  L2 -> L11 : 選んでいるセクションの最初の周回をくり返し鳴らす() : void
  activate L11
  note right of L11 : 選んだセクションの周回が曲にないときは\n曲全体を鳴らす（そのことを下に出す）
  L11 -> L12 : メロディを置いていない小節でもメロディを鳴らす() : void
  activate L12
  deactivate L12
  deactivate L11
  deactivate L2
end

@enduml
