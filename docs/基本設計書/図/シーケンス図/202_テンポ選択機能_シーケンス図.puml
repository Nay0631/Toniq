@startuml
!include ../astah-sequence-style.puml
mainframe sd 202_テンポ選択機能_シーケンス図

actor ":利用者" as L1
boundary ":SimpleScreen" as L2
control ":TapTempo" as L3
control ":SimpleModeResolver" as L4
entity ":tempo_presets.json" as L5
entity ":AppState" as L6
control ":Playback" as L7

L1 -> L2 : テンポのチップを押下する()
activate L2
L2 -> L3 : resetTap()
activate L3
deactivate L3
L2 -> L4 : resolveTempoPreset(genre, preset)
activate L4
L4 -> L5 : ジャンルとテンポのBPMを取得する()
activate L5
deactivate L5
deactivate L4
L2 -> L6 : setState(tempoPreset, bpm)
activate L6
deactivate L6
L2 -> L7 : isSamplePlaying()
activate L7
deactivate L7
opt ジャンルのサンプルを再生中
  L2 -> L7 : applyBpm()
  activate L7
  deactivate L7
end
L2 -> L2 : render()
activate L2
deactivate L2
deactivate L2

@enduml
