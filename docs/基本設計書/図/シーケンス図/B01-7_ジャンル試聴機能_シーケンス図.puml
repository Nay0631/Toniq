@startuml
!include ../astah-sequence-style.puml
mainframe sd B01-7_ジャンル試聴機能_シーケンス図

actor ":利用者" as L1
boundary ":シンプルモード画面" as L2
control ":ジャンル試聴" as L3
control ":パターン選出" as L4
entity ":シンプルモード表マスタ" as L5
entity ":コード進行マスタ" as L6
entity ":ドラムパターンマスタ" as L7
control ":メロディ生成" as L8
entity ":メロディ設定マスタ" as L9
control ":再生" as L10
entity ":アプリの状態" as L11

alt サンプルが止まっている
  L1 -> L2 : サンプルを聴くボタンを押下する() : void
  activate L2
  L2 -> L3 : サンプルを鳴らす() : void
  activate L3
  L3 -> L4 : コード進行とドラムを選ぶ() : void
  activate L4
  L4 -> L5 : ジャンル×雰囲気の候補を取得する() : void
  activate L5
  deactivate L5
  L4 -> L6 : コード進行を取得する() : void
  activate L6
  deactivate L6
  L4 -> L7 : ドラムパターンを取得する() : void
  activate L7
  deactivate L7
  deactivate L4
  L3 -> L8 : メロディを生成する() : void
  activate L8
  L8 -> L9 : 生成パラメータを取得する() : void
  activate L9
  deactivate L9
  deactivate L8
  L3 -> L10 : サンプルを1周再生する() : void
  activate L10
  note right of L10 : ドラム・パーカッション・コード・ベース・\nパッド・シグネチャー・メロディを\nアレンジに関係なく同時に鳴らす
  L10 -> L11 : 曲の内容を一時的に差し替える() : void
  activate L11
  deactivate L11
  deactivate L10
  deactivate L3
  deactivate L2
else サンプルを再生中
  L1 -> L2 : サンプルを止めるボタンを押下する() : void
  activate L2
  L2 -> L10 : 停止する() : void
  activate L10
  L10 -> L11 : 曲の内容を元に戻す() : void
  activate L11
  deactivate L11
  deactivate L10
  deactivate L2
end

@enduml
