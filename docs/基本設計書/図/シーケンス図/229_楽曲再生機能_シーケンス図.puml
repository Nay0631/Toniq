@startuml
!include ../astah-sequence-style.puml
mainframe sd 229_楽曲再生機能_シーケンス図

actor ":利用者" as L1
boundary ":MusicListScreen" as L2
control ":SongLibrary" as L3
entity ":localStorage" as L4
entity ":AppState" as L5
control ":VolumeManager" as L6
control ":History" as L7
control ":Playback" as L8
entity ":Tone.Transport" as L9

L1 -> L2 : 曲の再生ボタンを押下する()
activate L2
L2 -> L2 : togglePlay(id)
activate L2
alt その曲を再生中
  L2 -> L8 : stop()
  activate L8
  deactivate L8
else 再生していない
  L2 -> L2 : useSong(id)
  activate L2
  opt 今の曲と別の曲
    L2 -> L2 : confirmDiscard(id)
    activate L2
    L2 -> L3 : findSong(songId)
    activate L3
    L3 -> L4 : 保存した曲を読む(toniq.songs)
    activate L4
    deactivate L4
    deactivate L3
    opt 今の曲がリストに保存されていない
      L2 -> L1 : 失われてよいか確認する()
      activate L1
      deactivate L1
    end
    deactivate L2
    L2 -> L8 : stop()
    activate L8
    deactivate L8
    L2 -> L3 : loadSong(id)
    activate L3
    L3 -> L4 : 保存した曲を読む(toniq.songs)
    activate L4
    deactivate L4
    L3 -> L5 : setState(曲の内容, songId, generated, startBar)
    activate L5
    deactivate L5
    L3 -> L6 : applyAllVolumes()
    activate L6
    deactivate L6
    L3 -> L7 : resetHistory()
    activate L7
    deactivate L7
    deactivate L3
  end
  deactivate L2
  L2 -> L8 : play(onEnded)
  activate L8
  L8 -> L8 : reloadAllLayers() / startLoopArranger()
  activate L8
  deactivate L8
  L8 -> L9 : start()
  activate L9
  deactivate L9
  deactivate L8
  L2 -> L2 : startProgressLoop()
  activate L2
  deactivate L2
end
L2 -> L2 : render()
activate L2
deactivate L2
deactivate L2
deactivate L2

@enduml
