@startuml
!include ../astah-sequence-style.puml
mainframe sd 210_スケール選択機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
entity ":chord_progressions.json" as L3
entity ":AppState" as L4
control ":MelodyGenerator" as L5
control ":Playback" as L6

L1 -> L2 : スケールを選ぶ()
activate L2
L2 -> L3 : そのスケールのコード進行を取得する(scale)
activate L3
deactivate L3
L2 -> L2 : 同じ雰囲気の進行を優先して選ぶ()
activate L2
deactivate L2
L2 -> L2 : setChordPattern(next)
activate L2
L2 -> L4 : setState(chordPattern)
activate L4
deactivate L4
opt 自動生成のメロディがある
  L2 -> L4 : setState(melodyVersion)
  activate L4
  deactivate L4
  L2 -> L5 : generateMelody(chordPattern, key, genre)
  activate L5
  deactivate L5
  L2 -> L4 : setState(melodyNotes)
  activate L4
  deactivate L4
end
deactivate L2
L2 -> L2 : render()
activate L2
deactivate L2
L2 -> L2 : restartIfPlaying()
activate L2
opt 再生中
  L2 -> L6 : play(fromBar, onLoopChange, onEnded)
  activate L6
  deactivate L6
end
deactivate L2
deactivate L2

@enduml
