@startuml
!include ../astah-sequence-style.puml
mainframe sd 225_パート別音量調節機能_シーケンス図

actor ":利用者" as L1
boundary ":MixerPanel" as L2
control ":VolumeManager" as L3
entity ":AppState" as L4
entity ":Tone.Volume" as L5

L1 -> L2 : フェーダーを動かす()
activate L2
L2 -> L3 : setVolume(part, value)
activate L3
L3 -> L4 : setState(volumes)
activate L4
deactivate L4
opt パートの音量ノードがある（再生中）
  L3 -> L3 : toDb(value)
  activate L3
  deactivate L3
  L3 -> L5 : 音量（dB）を設定する(db)
  activate L5
  deactivate L5
end
deactivate L3
L2 -> L2 : 音量の数値を表示する()
activate L2
deactivate L2
deactivate L2

@enduml
