@startuml
!include ../astah-sequence-style.puml
mainframe sd 220_特殊音選択機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
control ":LayerManager" as L3
entity ":AppState" as L4
control ":各パートのPlayer" as L5
control ":Playback" as L6

alt パッド・アルペジオ・シグネチャーの ON/OFF
  L1 -> L2 : ON/OFF ボタンを押下する()
  activate L2
  L2 -> L3 : setLayerEnabled(part, enabled)
  activate L3
  L3 -> L4 : setState(parts)
  activate L4
  deactivate L4
  alt OFF にした
    L3 -> L5 : dispose*()
    activate L5
    deactivate L5
  else ON にした（再生中）
    L3 -> L3 : reloadLayer(part)
    activate L3
    L3 -> L5 : load*(chordPattern, key)
    activate L5
    deactivate L5
    deactivate L3
  end
  deactivate L3
  L2 -> L2 : render()
  activate L2
  deactivate L2
  deactivate L2
else FX / SE の種類
  L1 -> L2 : FX / SE の種類を選ぶ()
  activate L2
  L2 -> L4 : setState(fxType)
  activate L4
  deactivate L4
  L2 -> L2 : render()
  activate L2
  deactivate L2
  L2 -> L2 : restartIfPlaying()
  activate L2
  opt 再生中
    L2 -> L6 : play(fromBar, onLoopChange, onEnded)
    activate L6
    deactivate L6
  end
  deactivate L2
  deactivate L2
end

@enduml
