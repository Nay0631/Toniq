@startuml
!include ../astah-sequence-style.puml
mainframe sd 208_リード選択機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
entity ":AppState" as L3
control ":Playback" as L4
control ":LayerManager" as L5
control ":MelodyPlayer" as L6
entity ":melody_params.json" as L7

L1 -> L2 : メロディの音色を選ぶ()
activate L2
L2 -> L3 : setState(melodyInstrument)
activate L3
deactivate L3
L2 -> L2 : render()
activate L2
deactivate L2
L2 -> L2 : restartIfPlaying()
activate L2
opt 再生中
  L2 -> L4 : play(fromBar, onLoopChange, onEnded)
  activate L4
  L4 -> L4 : stop()
  activate L4
  deactivate L4
  L4 -> L5 : reloadAllLayers()
  activate L5
  L5 -> L6 : loadMelody(melodyNotes, loopEnd)
  activate L6
  L6 -> L6 : initMelodySynth()
  activate L6
  L6 -> L6 : resolveMelodySound()
  activate L6
  L6 -> L3 : getState()
  activate L3
  deactivate L3
  opt 音色が auto（ジャンルの標準）
    L6 -> L7 : ジャンルの標準の音色を取得する()
    activate L7
    deactivate L7
  end
  deactivate L6
  deactivate L6
  deactivate L6
  deactivate L5
  deactivate L4
end
deactivate L2
deactivate L2

@enduml
