@startuml
!include ../astah-sequence-style.puml
mainframe sd 219_ドラム試聴機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
control ":Playback" as L3
control ":DrumSamples" as L4
control ":LayerManager" as L5
control ":DrumEngine" as L6
control ":SynthFactory" as L7
entity ":Tone.Transport" as L8

L1 -> L2 : ドラムの試聴ボタンを押下する()
activate L2
L2 -> L3 : preview("drum", onEnded)
activate L3
L3 -> L3 : stop()
activate L3
deactivate L3
L3 -> L3 : audioReady(genre)
activate L3
opt ドラムの音源がワンショット音源
  L3 -> L4 : prepareDrumSamples(genre)
  activate L4
  deactivate L4
end
deactivate L3
L3 -> L5 : reloadLayer("drum")
activate L5
L5 -> L6 : loadDrumPattern(drumPattern)
activate L6
L6 -> L7 : createDrumKit(genre, trackNames, source)
activate L7
deactivate L7
L6 -> L8 : 16ステップの Sequence を登録する()
activate L8
deactivate L8
deactivate L6
deactivate L5
L3 -> L8 : scheduleOnce(stop, 2小節)
activate L8
deactivate L8
L3 -> L8 : start()
activate L8
deactivate L8
deactivate L3
L2 -> L2 : render()
activate L2
deactivate L2
deactivate L2

@enduml
