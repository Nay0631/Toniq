@startuml
!include ../astah-sequence-style.puml
mainframe sd B01-5_小節数選択機能_シーケンス図

actor ":利用者" as L1
boundary ":カスタムモード画面" as L2
control ":小節数設定" as L3
entity ":アプリの状態" as L4
control ":再生" as L5

L1 -> L2 : 小節数を選ぶ() : void
activate L2
L2 -> L3 : 小節数を設定する() : void
activate L3
L3 -> L4 : 小節数を更新する() : void
activate L4
deactivate L4
opt 再生中
  L3 -> L5 : 先頭から再生し直す() : void
  activate L5
  L5 -> L4 : 小節数を取得する() : void
  activate L4
  deactivate L4
  L5 -> L5 : 小節数で自動停止を予約する() : void
  activate L5
  deactivate L5
  deactivate L5
end
deactivate L3
deactivate L2

@enduml
