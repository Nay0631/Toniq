@startuml
!include ../astah-sequence-style.puml
mainframe sd 205_小節数選択機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
entity ":AppState" as L3
control ":Playback" as L4
control ":LayerManager" as L5
control ":LoopArranger" as L6
entity ":Tone.Transport" as L7

L1 -> L2 : 小節数を選ぶ()
activate L2
L2 -> L3 : setState(bars)
activate L3
deactivate L3
L2 -> L2 : render()
activate L2
deactivate L2
L2 -> L2 : restartIfPlaying()
activate L2
L2 -> L4 : isPlaying()
activate L4
deactivate L4
opt 再生中
  L2 -> L4 : play(fromBar, onLoopChange, onEnded)
  activate L4
  L4 -> L4 : stop()
  activate L4
  deactivate L4
  L4 -> L5 : reloadAllLayers()
  activate L5
  deactivate L5
  L4 -> L6 : startLoopArranger(loopBars, fromBar)
  activate L6
  deactivate L6
  L4 -> L4 : applyLoopPlayback()
  activate L4
  alt ループ再生が ON
    L4 -> L7 : 先頭〜bars小節でループさせる()
    activate L7
    deactivate L7
  else ループ再生が OFF
    L4 -> L7 : scheduleOnce(stop, bars小節)
    activate L7
    deactivate L7
  end
  deactivate L4
  L4 -> L7 : start(fromBar)
  activate L7
  deactivate L7
  deactivate L4
end
deactivate L2
deactivate L2

@enduml
