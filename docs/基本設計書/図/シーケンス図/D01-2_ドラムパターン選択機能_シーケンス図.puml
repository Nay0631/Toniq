@startuml
!include ../astah-sequence-style.puml
mainframe sd D01-2_ドラムパターン選択機能_シーケンス図

actor ":利用者" as L1
boundary ":シンプルモード画面" as L2
boundary ":カスタムモード画面" as L3
control ":ドラムパターン設定" as L4
control ":パターン選出" as L5
entity ":シンプルモード表マスタ" as L6
entity ":ドラムパターンマスタ" as L7
entity ":アプリの状態" as L8
control ":再生" as L9

alt シンプルモード画面（再抽選）
  L1 -> L2 : ドラムの再抽選ボタンを押下する() : void
  activate L2
  L2 -> L4 : ドラムパターンを再抽選する() : void
  activate L4
  L4 -> L5 : 今のパターン以外から選ぶ() : void
  activate L5
  L5 -> L6 : ジャンル×雰囲気の候補を取得する() : void
  activate L6
  deactivate L6
  L5 -> L7 : 候補のパターンを取得する() : void
  activate L7
  deactivate L7
  deactivate L5
  L4 -> L8 : ドラムパターンを更新する() : void
  activate L8
  deactivate L8
  opt 再生中
    L4 -> L9 : 再生し直す() : void
    activate L9
    deactivate L9
  end
  deactivate L4
  deactivate L2
else カスタムモード画面（ドロップダウン・◀▶）
  L1 -> L3 : ドラムパターンを選ぶ() : void
  activate L3
  L3 -> L4 : 選んだパターンに切り替える() : void
  activate L4
  L4 -> L7 : 選んだパターンを取得する() : void
  activate L7
  deactivate L7
  L4 -> L8 : ドラムパターンを更新する() : void
  activate L8
  deactivate L8
  opt 再生中
    L4 -> L9 : 再生し直す() : void
    activate L9
    deactivate L9
  end
  deactivate L4
  deactivate L3
end

@enduml
