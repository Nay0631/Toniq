@startuml
!include ../astah-sequence-style.puml
mainframe sd A01-1_パート配置機能_シーケンス図

actor ":利用者" as L1
boundary ":アレンジ画面" as L2
control ":ブロック編集" as L3
control ":アレンジ管理" as L4
entity ":アプリの状態" as L5
entity ":標準アレンジマスタ" as L6
entity ":構成プリセットマスタ" as L10
control ":パート管理" as L7
control ":各パートの演奏" as L8

note over L2 : ドラッグ中は描き直さず、離したときに1回だけ保存する。\nドラム・FX のブロックのパターン・種類を選んだときも同じ流れ

alt ブロックを置く・動かす・削除する
  L1 -> L2 : タイムラインを押下・ドラッグ・右クリックする() : void
  activate L2
  L2 -> L3 : ブロックを置く・動かす・削除する() : void
  activate L3
  L3 -> L4 : 今のアレンジを組み立てる() : void
  activate L4
  L4 -> L5 : 構成・変えた所・小節数を取得する() : void
  activate L5
  deactivate L5
  L4 -> L6 : ジャンルの標準アレンジを取得する() : void
  activate L6
  deactivate L6
  L4 -> L10 : 構成のプリセットを取得する() : void
  activate L10
  deactivate L10
  deactivate L4
  L3 -> L3 : 1小節単位で前後に重ならないように置く() : void
  activate L3
  deactivate L3
  L3 -> L4 : セクションごとにプリセットと比べる() : void
  activate L4
  deactivate L4
  L3 -> L5 : 変えた所を更新する() : void
  activate L5
  deactivate L5
  opt OFF のパートに置いた
    L3 -> L7 : パートを ON にする() : void
    activate L7
    deactivate L7
  end
  L3 -> L2 : タイムラインと変更の数を表示する() : void
  activate L2
  deactivate L2
  deactivate L3
  deactivate L2
else 変えた所を消す
  L1 -> L2 : 変えた所を消すボタンを押下する() : void
  activate L2
  L2 -> L3 : 変えた所を消す() : void
  activate L3
  L3 -> L5 : 変えた所とセクションを空にする() : void
  activate L5
  deactivate L5
  L3 -> L2 : タイムラインと変更の数を表示する() : void
  activate L2
  deactivate L2
  deactivate L3
  deactivate L2
end

loop 再生中、各パートの発音ごと
  L8 -> L4 : 鳴らす小節か確かめる() : void
  activate L4
  L4 -> L5 : 構成・変えた所を取得する() : void
  activate L5
  deactivate L5
  deactivate L4
end

@enduml
