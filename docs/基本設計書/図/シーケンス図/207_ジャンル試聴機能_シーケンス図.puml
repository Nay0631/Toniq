@startuml
!include ../astah-sequence-style.puml
mainframe sd 207_ジャンル試聴機能_シーケンス図

actor ":利用者" as L1
boundary ":SimpleScreen" as L2
control ":SimpleModeResolver" as L3
entity ":easy_mode_table.json" as L4
control ":MelodyGenerator" as L5
control ":Playback" as L6
entity ":AppState" as L7
control ":LoopArranger" as L8
control ":LayerManager" as L9
entity ":Tone.Transport" as L10

L1 -> L2 : サンプルを聴くボタンを押下する()
activate L2
L2 -> L6 : isSamplePlaying()
activate L6
deactivate L6
alt サンプルを再生中
  L2 -> L6 : stop()
  activate L6
  L6 -> L7 : setState(元の曲の内容)
  activate L7
  deactivate L7
  deactivate L6
else 止まっている
  L2 -> L2 : playGenreSample()
  activate L2
  L2 -> L3 : resolveSimpleMode(genre, mood)
  activate L3
  L3 -> L4 : コード進行・ドラムの候補を取得する()
  activate L4
  deactivate L4
  deactivate L3
  L2 -> L5 : generateMelody(chordPattern, key, genre)
  activate L5
  deactivate L5
  L2 -> L6 : playSample(sample, onEnded)
  activate L6
  L6 -> L6 : stop()
  activate L6
  deactivate L6
  L6 -> L6 : audioReady(genre)
  activate L6
  deactivate L6
  L6 -> L7 : setState(サンプルのコード進行・ドラム・メロディ)
  activate L7
  deactivate L7
  L6 -> L8 : setArrangementBypass(true)
  activate L8
  deactivate L8
  loop ドラム・コード・ベース・パッド・シグネチャー・メロディ
    L6 -> L9 : reloadLayer(layer)
    activate L9
    deactivate L9
  end
  L6 -> L10 : scheduleOnce(stop, 1周分の小節)
  activate L10
  deactivate L10
  L6 -> L10 : start()
  activate L10
  deactivate L10
  deactivate L6
  deactivate L2
end
L2 -> L2 : render()
activate L2
deactivate L2
deactivate L2

@enduml
