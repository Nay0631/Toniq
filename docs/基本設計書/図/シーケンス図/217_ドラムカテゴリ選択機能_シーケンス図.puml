@startuml
!include ../astah-sequence-style.puml
mainframe sd 217_ドラムカテゴリ選択機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
entity ":AppState" as L3
entity ":drum_patterns.json" as L4
control ":Playback" as L5

L1 -> L2 : ドラムのカテゴリを選ぶ()
activate L2
L2 -> L3 : setState(drumCategory)
activate L3
deactivate L3
L2 -> L2 : drumCandidates()
activate L2
L2 -> L4 : カテゴリのタグを持つパターンを取得する(drumCategory)
activate L4
deactivate L4
deactivate L2
opt 今のパターンが候補にない
  L2 -> L3 : setState(drumPattern)
  activate L3
  deactivate L3
end
L2 -> L2 : render()
activate L2
deactivate L2
L2 -> L2 : restartIfPlaying()
activate L2
opt 再生中
  L2 -> L5 : play(fromBar, onLoopChange, onEnded)
  activate L5
  deactivate L5
end
deactivate L2
deactivate L2

@enduml
