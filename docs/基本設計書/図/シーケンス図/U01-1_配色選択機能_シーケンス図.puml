@startuml
!include ../astah-sequence-style.puml
mainframe sd U01-1_配色選択機能_シーケンス図

actor ":利用者" as L1
boundary ":設定画面" as L2
control ":見た目設定" as L3
entity ":アプリの状態" as L4
entity ":端末の設定データ" as L5

L1 -> L2 : 配色を押下する() : void
activate L2
L2 -> L3 : 配色を選ぶ() : void
activate L3
opt OS に合わせる
  L3 -> L3 : OS の配色を調べる() : void
  activate L3
  deactivate L3
end
L3 -> L4 : 配色を更新する() : void
activate L4
deactivate L4
L3 -> L5 : 配色を保存する() : void
activate L5
deactivate L5
L3 -> L2 : 画面の配色を変える() : void
activate L2
deactivate L2
deactivate L3
deactivate L2

@enduml
