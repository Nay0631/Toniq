@startuml
!include ../astah-sequence-style.puml
mainframe sd 228_WAVエクスポート機能_シーケンス図

actor ":利用者" as L1
boundary ":CustomScreen" as L2
control ":Playback" as L3
control ":DrumSamples" as L4
control ":MixerEngine" as L5
control ":各パートのPlayer" as L6
control ":LayerManager" as L7
entity ":WAVファイル" as L8

note over L2 : シンプルモード画面（SimpleScreen）の\n「WAVで書き出す」ボタンも同じ流れ

L1 -> L2 : WAV ボタンを押下する()
activate L2
L2 -> L2 : ボタンを「レンダリング中…」にする()
activate L2
deactivate L2
L2 -> L3 : renderWav()
activate L3
L3 -> L3 : stop()
activate L3
deactivate L3
opt ドラムの音源がワンショット音源
  L3 -> L4 : prepareDrumSamples(genre)
  activate L4
  deactivate L4
end
group Tone.Offline（曲の長さ＋2秒をレンダリング）
  L3 -> L5 : applyMixPreset(genre)
  activate L5
  deactivate L5
  L3 -> L5 : mixerReady()
  activate L5
  deactivate L5
  loop ON のパートごと
    L3 -> L6 : init*Synth()
    activate L6
    deactivate L6
    L3 -> L6 : load*(chordPattern, key)
    activate L6
    deactivate L6
  end
end
L3 -> L7 : disposeAllLayers()
activate L7
deactivate L7
L3 -> L3 : audioBufferToWav(buffer)
activate L3
deactivate L3
deactivate L3
L2 -> L3 : downloadBlob(blob, filename)
activate L3
L3 -> L8 : ダウンロードして保存する(toniq_ジャンル_キー.wav)
activate L8
deactivate L8
deactivate L3
L2 -> L2 : ボタンを元に戻す()
activate L2
deactivate L2
deactivate L2

@enduml
