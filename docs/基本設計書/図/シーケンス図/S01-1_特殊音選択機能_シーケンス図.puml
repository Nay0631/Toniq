@startuml
!include ../astah-sequence-style.puml
mainframe sd S01-1_特殊音選択機能_シーケンス図

actor ":利用者" as L1
boundary ":カスタムモード画面" as L2
control ":パート管理" as L3
entity ":アプリの状態" as L4
control ":各パートの演奏" as L5
control ":FX設定" as L6
control ":再生" as L7

alt パッド・アルペジオ・シグネチャーの ON/OFF
  L1 -> L2 : ON/OFF ボタンを押下する() : void
  activate L2
  L2 -> L3 : パートを ON/OFF する() : void
  activate L3
  L3 -> L4 : パートの ON/OFF を更新する() : void
  activate L4
  deactivate L4
  alt OFF にした
    L3 -> L5 : 音源を破棄する() : void
    activate L5
    deactivate L5
  else 再生中に ON にした
    L3 -> L5 : 音源を読み込む() : void
    activate L5
    deactivate L5
  end
  deactivate L3
  deactivate L2
else FX / SE の種類
  L1 -> L2 : FX / SE の種類を選ぶ() : void
  activate L2
  L2 -> L6 : FX / SE の種類を設定する() : void
  activate L6
  L6 -> L4 : FX / SE の種類を更新する() : void
  activate L4
  deactivate L4
  opt 再生中
    L6 -> L7 : 再生し直す() : void
    activate L7
    deactivate L7
  end
  deactivate L6
  deactivate L2
else FX / SE の試聴
  L1 -> L2 : FX / SE の試聴ボタンを押下する() : void
  activate L2
  L2 -> L7 : FX / SE を試聴する() : void
  activate L7
  deactivate L7
  deactivate L2
end

@enduml
