@startuml
!include ../astah-sequence-style.puml
mainframe sd B01-9_グルーヴ調整機能_シーケンス図

actor ":利用者" as L1
boundary ":もっと調整" as L2
control ":グルーヴ設定" as L3
entity ":アプリの状態" as L4
control ":グルーヴ" as L5
entity ":ミックス設定マスタ" as L6
control ":ドラム演奏" as L7

note over L2 : 「標準」ボタンも同じ流れ（量を空にして、ジャンルの標準の量に戻す）。\n跳ねる単位（16分音符／8分音符（シャッフル））のドロップダウンも同じ流れ

L1 -> L2 : スウィング・サイドチェインのつまみを回す() : void
activate L2
L2 -> L3 : グルーヴを設定する() : void
activate L3
L3 -> L4 : スウィング・サイドチェイン・跳ねる単位を更新する() : void
activate L4
deactivate L4
opt スウィング・跳ねる単位を変えた
  L3 -> L5 : スウィングを反映する() : void
  activate L5
  L5 -> L4 : スウィングの量・単位・拍子を取得する() : void
  activate L4
  deactivate L4
  opt 量が空
    L5 -> L6 : ジャンルの標準の量を取得する() : void
    activate L6
    deactivate L6
  end
  alt 拍子が 4/4 の3連符
    L5 -> L5 : スウィングをかけない() : void
    activate L5
    deactivate L5
  else それ以外
    L5 -> L5 : 裏の16分音符・8分音符をずらす() : void
    activate L5
    deactivate L5
  end
  deactivate L5
end
L3 -> L2 : つまみの値と変更の数を表示する() : void
activate L2
deactivate L2
deactivate L3
deactivate L2

loop 再生中、キックが鳴るたび
  L7 -> L5 : ほかのパートを沈める() : void
  activate L5
  L5 -> L4 : サイドチェインの量を取得する() : void
  activate L4
  deactivate L4
  opt 量が空
    L5 -> L6 : ジャンルの標準の量を取得する() : void
    activate L6
    deactivate L6
  end
  deactivate L5
end

@enduml
