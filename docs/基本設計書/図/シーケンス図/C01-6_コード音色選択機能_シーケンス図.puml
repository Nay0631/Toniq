@startuml
!include ../astah-sequence-style.puml
mainframe sd C01-6_コード音色選択機能_シーケンス図

actor ":利用者" as L1
boundary ":カスタムモード画面" as L2
control ":コード音色設定" as L3
entity ":アプリの状態" as L4
control ":再生" as L5
control ":コード演奏" as L6

L1 -> L2 : コードの音色を選ぶ() : void
activate L2
L2 -> L3 : コードの音色を設定する() : void
activate L3
L3 -> L4 : コードの音色を更新する() : void
activate L4
deactivate L4
opt 再生中
  L3 -> L5 : 再生し直す() : void
  activate L5
  L5 -> L6 : コードの音源を作り直す() : void
  activate L6
  L6 -> L4 : 音色を取得する() : void
  activate L4
  deactivate L4
  deactivate L6
  deactivate L5
end
deactivate L3
deactivate L2

@enduml
