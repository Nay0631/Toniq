@startuml
!include ../astah-sequence-style.puml
mainframe sd B01-4_BPM試聴機能_シーケンス図

actor ":利用者" as L1
boundary ":カスタムモード画面" as L2
control ":再生" as L3
control ":クリック音" as L4
entity ":アプリの状態" as L5

note over L2 : シンプルモード画面の「テンポを聴く」ボタンも同じ流れ。\n4/4 で、1拍目は高い音にする

L1 -> L2 : 「メトロノーム」ボタンを押下する() : void
activate L2
alt メトロノームが止まっている
  L2 -> L3 : 曲の再生を止める() : void
  activate L3
  deactivate L3
  L2 -> L4 : メトロノームの音を鳴らす() : void
  activate L4
  loop 止めるまで、拍ごと
    L4 -> L5 : BPMを取得する() : void
    activate L5
    deactivate L5
    L4 -> L4 : 次の拍の音を予約する() : void
    activate L4
    deactivate L4
  end
  deactivate L4
else メトロノームが鳴っている
  L2 -> L4 : メトロノームの音を止める() : void
  activate L4
  deactivate L4
end
deactivate L2

@enduml
