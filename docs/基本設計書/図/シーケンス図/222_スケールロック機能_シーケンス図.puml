@startuml
!include ../astah-sequence-style.puml
mainframe sd 222_スケールロック機能_シーケンス図

actor ":利用者" as L1
boundary ":PianoRollTab" as L2
boundary ":CustomScreen" as L3
entity ":AppState" as L4
control ":degree_resolver" as L5
entity ":chord_progressions.json" as L6

L1 -> L2 : スケールロックボタンを押下する()
activate L2
L2 -> L4 : setState(pianoRollScaleLock)
activate L4
deactivate L4
L2 -> L2 : render()
activate L2
deactivate L2
deactivate L2

L1 -> L2 : グリッドの空いている所を押下する()
activate L2
L2 -> L2 : allowed(midi, scalePitchClasses())
activate L2
L2 -> L4 : getState()
activate L4
deactivate L4
L2 -> L5 : SCALE_TONES を参照する(scale)
activate L5
deactivate L5
deactivate L2
alt スケールの音（またはロックが無効）
  L2 -> L2 : 音を置く()
  activate L2
  deactivate L2
else スケール外の音
  L2 -> L2 : 置かずに終わる()
  activate L2
  deactivate L2
end
deactivate L2

L1 -> L3 : スケールロックのスイッチを押下する()
activate L3
L3 -> L4 : setState(scaleLock)
activate L4
deactivate L4
L3 -> L3 : render()
activate L3
L3 -> L3 : chordCandidates()
activate L3
L3 -> L6 : 雰囲気・スケールが合う進行を取得する()
activate L6
deactivate L6
deactivate L3
deactivate L3
deactivate L3

@enduml
