@startuml
!include ../astah-sequence-style.puml
mainframe sd M01-10_作業ファイルを開く機能_シーケンス図

actor ":利用者" as L1
boundary ":メニュー画面" as L2
control ":作業ファイルを開く" as L3
entity ":アプリの状態" as L4
control ":出力ファイル保存" as L5
entity ":作業ファイル" as L6
control ":再生" as L7
control ":曲の管理" as L8
control ":履歴管理" as L9
control ":画面切り替え" as L10
boundary ":カスタムモード画面" as L11

note over L2 : ミュージックリスト画面の「作業ファイルを開く」ボタンも同じ流れ。\nブラウザで開いたときはファイルの選択で開く
note over L11 : シンプルモードで保存した作業ファイルは\nシンプルモード画面（生成後）を開く

L1 -> L2 : 作業ファイルを開くカードを押下する() : void
activate L2
L2 -> L3 : 作業ファイルを開く() : void
activate L3
L3 -> L4 : 今の曲が保存済みかを取得する() : void
activate L4
deactivate L4
opt リストの曲・開いた作業ファイルの曲・シンプルモードの生成前のどれでもない
  L3 -> L1 : 失われてよいか確認する() : void
  activate L1
  deactivate L1
end
L3 -> L5 : ファイルを選ばせて読み込む() : void
activate L5
L5 -> L1 : ファイルを選ばせる（output/projects）() : void
activate L1
deactivate L1
L5 -> L6 : 読み込む() : void
activate L6
deactivate L6
deactivate L5
alt 開ける作業ファイル
  L3 -> L7 : 再生を止める() : void
  activate L7
  deactivate L7
  L3 -> L8 : 作業ファイルの曲を今の曲として読み込む() : void
  activate L8
  L8 -> L4 : 曲の内容と開いた場所を反映する() : void
  activate L4
  deactivate L4
  L8 -> L9 : 履歴を捨てる() : void
  activate L9
  deactivate L9
  deactivate L8
  L3 -> L10 : 保存したモードの画面にする() : void
  activate L10
  L10 -> L11 : 設定タブを表示する() : void
  activate L11
  deactivate L11
  deactivate L10
else 開けない（JSON として読めない・Toniq の作業ファイルではない）
  L3 -> L2 : 開けなかった理由を知らせる() : void
  activate L2
  deactivate L2
end
deactivate L3
deactivate L2

@enduml
