@startuml
!include ../astah-sequence-style.puml
mainframe sd K01-1_キー音選択機能_シーケンス図

actor ":利用者" as L1
boundary ":カスタムモード画面" as L2
control ":キー設定" as L3
entity ":アプリの状態" as L4
control ":メロディ生成" as L5
entity ":メロディ設定マスタ" as L6
control ":コード変換" as L7
entity ":スケールマスタ" as L8
control ":再生" as L9

L1 -> L2 : ルート音を選ぶ() : void
activate L2
L2 -> L3 : キーを設定する() : void
activate L3
L3 -> L4 : キーを更新する() : void
activate L4
deactivate L4
opt 自動生成のメロディがある
  L3 -> L5 : メロディを生成する() : void
  activate L5
  L5 -> L6 : 生成パラメータを取得する() : void
  activate L6
  deactivate L6
  deactivate L5
  L3 -> L4 : メロディを更新する() : void
  activate L4
  deactivate L4
end
L3 -> L7 : コード名を求める() : void
activate L7
L7 -> L8 : スケールの音程を取得する() : void
activate L8
deactivate L8
L7 -> L2 : コード名を表示する() : void
activate L2
deactivate L2
deactivate L7
opt 再生中
  L3 -> L9 : 再生し直す() : void
  activate L9
  deactivate L9
end
deactivate L3
deactivate L2

@enduml
