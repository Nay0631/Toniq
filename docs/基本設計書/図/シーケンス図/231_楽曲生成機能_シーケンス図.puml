@startuml
!include ../astah-sequence-style.puml
mainframe sd 231_楽曲生成機能_シーケンス図

actor ":利用者" as L1
boundary ":SimpleScreen" as L2
boundary ":CustomScreen" as L3
control ":Playback" as L4
control ":SimpleModeResolver" as L5
entity ":easy_mode_table.json" as L6
entity ":AppState" as L7
control ":LoopArranger" as L8
control ":MelodyGenerator" as L9
entity ":melody_params.json" as L10

alt シンプルモード画面（生成する）
  L1 -> L2 : 生成するボタンを押下する()
  activate L2
  L2 -> L2 : generate()
  activate L2
  L2 -> L4 : stop()
  activate L4
  deactivate L4
  L2 -> L5 : resolveSimpleMode(genre, mood)
  activate L5
  L5 -> L6 : ジャンル×雰囲気の候補を取得する()
  activate L6
  deactivate L6
  L5 -> L5 : コード進行・ドラムをランダムに1つずつ選ぶ()
  activate L5
  deactivate L5
  deactivate L5
  L2 -> L7 : setState(chordPattern, drumPattern, generated, songId, arrangement)
  activate L7
  deactivate L7
  L2 -> L8 : getFullArrangementLoops(genre)
  activate L8
  deactivate L8
  L2 -> L7 : setState(bars)
  activate L7
  deactivate L7
  L2 -> L2 : makeMelody()
  activate L2
  opt メロディが自動生成
    L2 -> L9 : generateMelody(chordPattern, key, genre)
    activate L9
    L9 -> L10 : ジャンルのメロディ生成パラメータを取得する()
    activate L10
    deactivate L10
    deactivate L9
  end
  L2 -> L7 : setState(melodyNotes)
  activate L7
  deactivate L7
  deactivate L2
  deactivate L2
  L2 -> L2 : render()
  activate L2
  deactivate L2
  deactivate L2
else カスタムモード画面（メロディの差し替え ↻）
  L1 -> L3 : メロディの差し替えボタンを押下する()
  activate L3
  L3 -> L7 : setState(melodyVersion)
  activate L7
  deactivate L7
  L3 -> L9 : generateMelody(chordPattern, key, genre)
  activate L9
  L9 -> L10 : ジャンルのメロディ生成パラメータを取得する()
  activate L10
  deactivate L10
  deactivate L9
  L3 -> L7 : setState(melodyNotes)
  activate L7
  deactivate L7
  L3 -> L3 : render()
  activate L3
  deactivate L3
  L3 -> L3 : restartIfPlaying()
  activate L3
  opt 再生中
    L3 -> L4 : play(fromBar, onLoopChange, onEnded)
    activate L4
    deactivate L4
  end
  deactivate L3
  deactivate L3
end

@enduml
