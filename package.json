{
  "name": "toniq",
  "version": "1.0.0",
  "description": "ルールベース自動作曲アプリ",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node tools/test.mjs",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "grow:wasm": "node grow/wasm/build.mjs",
    "grow:render": "node grow/tools/render.mjs",
    "quality": "node tools/quality-report.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tonejs/midi": "^2.0.28",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.5.0",
    "cross-env": "^7.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.toniq.app",
    "productName": "Toniq",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
